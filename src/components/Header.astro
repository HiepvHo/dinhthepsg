---
import { getEntry, getCollection } from 'astro:content';
import { tenChinh, nhan } from '../lib/quy-cach';

/**
 * Header 2 tang, hoc cau truc baogiathep.net (do 01/09/2026):
 *   tang 1 = top bar do co email + hotline
 *   tang 2 = logo + nav + mega menu + nut CTA
 *
 * MEGA MENU LA THIET BI SEO, khong chi la dieu huong. baogiathep dat 99 link
 * trong nav va nav hien tren MOI trang -> moi trang tien chi cach nhau 1 cu nhay
 * tu bat ky dau, crawler vao trang nao cung thay het.
 *
 * KHAC HO O HAI CHO:
 *  1. Chi link toi trang DA TON TAI. Nhom nao chua tach trang quy cach thi chi
 *     link trang nhom - link toi trang chua co la tu tao 404.
 *  2. Mobile VAN CO nav day du (hamburger). baogiathep an han nav duoi 900px,
 *     tuc cat het internal link o thiet bi chiem phan lon traffic.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;

const nhom = (await getCollection('nhomSanPham')).sort((a, b) =>
  a.data.tachTrangQuyCach === b.data.tachTrangQuyCach ? 0 : a.data.tachTrangQuyCach ? -1 : 1,
);

/* Bai kien thuc dat NGAY TRONG mega menu San pham, khong phai chi o nav "Tin tuc".
   Ly do: bai tra cuu la mot buoc tren duong khach di toi don hang - de no o nhanh
   rieng thi no nam ngoai duong do. Chi lay 5 bai moi nhat, con lai xem o trang. */
const baiMega = (await getCollection('baiViet', ({ data }) => !data.nhap))
  .sort((a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf())
  .slice(0, 5);

const duongDanHienTai = Astro.url.pathname;
const dangO = (d: string) => duongDanHienTai === d || duongDanHienTai.startsWith(d + '/');

/**
 * Nav 5 muc theo yeu cau: Gioi thieu - San pham - Bang gia - Tin tuc - Lien he.
 *
 * HAI CHO NHAN KHAC URL, co chu y:
 *  - "Gioi thieu" tro toi /nha-may/. Khong tao them /gioi-thieu/ vi se thanh
 *    hai trang cung noi mot chuyen (thin + trung lap), va "nha may san xuat dinh"
 *    la URL mang tu khoa, doi thanh "gioi-thieu" la vut di.
 *  - "Tin tuc" tro toi /kien-thuc/. Nhan la tu khach quen doc, URL giu theo y dinh
 *    tim kiem (huong dan/tra cuu) - dung cai ma noi dung that se la.
 *
 * "Bang tra quy cach" khong con o cap 1 nua ma nam trong tha xuong cua Bang gia,
 * de tranh mat trang chen AI Overview do.
 */
const traCuu = [
  { ten: 'Bảng giá đầy đủ quy cách', duongDan: '/bang-gia-dinh-thep/' },
  { ten: 'Bảng tra phân - cm - mm', duongDan: '/bang-tra-quy-cach-dinh/' },
  { ten: 'Bảng tra bu lông M3-M36', duongDan: '/bang-gia-dinh-thep/#bu-long' },
];

const navSau = [
  { ten: 'Tin tức', duongDan: '/kien-thuc/' },
  { ten: 'Liên hệ', duongDan: '/lien-he/' },
];
---

<header class="dau-trang">
  <div class="thanh-tren">
    <div class="thanh-tren__trong">
      <span class="thanh-tren__xh an-mobile">
        {/* Icon DAC (to fill), khong ke net. Ho dung glyph Font Awesome dac -
            net mong 15px cua ta truoc day o co do doc ra nhoe, khong ra hinh.
            Ta ve tay thay vi nap Font Awesome: bon icon khong dang mot ten
            mien ngoai va mot goi 30KB. */}
        <a href={`tel:${c.hotlineTel}`} aria-label="Gọi hotline">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 2.6a1.7 1.7 0 0 1 2.2.6l2 3.2a1.7 1.7 0 0 1-.3 2.2L9 9.8a11 11 0 0 0 5.2 5.2l1.2-1.5a1.7 1.7 0 0 1 2.2-.3l3.2 2a1.7 1.7 0 0 1 .6 2.2l-1 1.8a2.6 2.6 0 0 1-2.9 1.2C11.1 19 5 12.9 3.6 6.5a2.6 2.6 0 0 1 1.2-2.9Z"></path></svg>
        </a>
        <a href={`https://zalo.me/${c.zalo}`} rel="noopener" aria-label="Nhắn Zalo">
          {/* Bong chat co chu Z - dau hieu Zalo doc ra ngay o Viet Nam */}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c5.4 0 9.7 3.6 9.7 8.1 0 4.5-4.3 8.1-9.7 8.1a12 12 0 0 1-2.3-.2l-4.6 2.5a.6.6 0 0 1-.9-.6l.6-3.3c-1.7-1.5-2.5-3.4-2.5-5.5 0-4.5 4.3-8.1 9.7-8.1Z"></path><path fill="#02245b" d="M8.4 7.9h6.3v1.5l-4 4.4h4.2v1.6H8v-1.6l4-4.4H8.4z"></path></svg>
        </a>
        <a href={`mailto:${c.email}`} aria-label="Gửi email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.6 7.3 12 13.1l9.4-5.8V17a1.8 1.8 0 0 1-1.8 1.8H4.4A1.8 1.8 0 0 1 2.6 17Z"></path><path d="M21.2 5.6 12 11.3 2.8 5.6a1.8 1.8 0 0 1 1.6-1H19.6a1.8 1.8 0 0 1 1.6 1Z"></path></svg>
        </a>
        <a href={c.websiteMe} rel="noopener" aria-label="Website công ty">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm5.9 6.4h-2.5a13 13 0 0 0-1.3-3.6 8 8 0 0 1 3.8 3.6ZM12 4.2c.7.9 1.3 2.4 1.6 4.4h-3.2c.3-2 .9-3.5 1.6-4.4ZM4.3 13.9a7.9 7.9 0 0 1 0-3.8h2.9a17 17 0 0 0 0 3.8Zm.8 2h2.5c.3 1.3.7 2.5 1.3 3.6a8 8 0 0 1-3.8-3.6Zm2.5-7.3H5.1a8 8 0 0 1 3.8-3.6 13 13 0 0 0-1.3 3.6ZM12 19.8c-.7-.9-1.3-2.4-1.6-4.4h3.2c-.3 2-.9 3.5-1.6 4.4Zm1.9-6.4h-3.8a15 15 0 0 1 0-3.8h3.8a15 15 0 0 1 0 3.8Zm1.2 6a13 13 0 0 0 1.3-3.6h2.5a8 8 0 0 1-3.8 3.6Zm1.7-5.6a17 17 0 0 0 0-3.8h2.9a7.9 7.9 0 0 1 0 3.8Z"></path></svg>
        </a>
      </span>

      <span class="thanh-tren__muc an-mobile">
        <a href={`mailto:${c.email}`}>{c.email}</a>
      </span>

      {/* Khoi goi: nen cam, canh vat ben trai, tran ra mep phai man hinh.
          Do theo .topbar-right cua Industro. Chu o 19px in dam - phai tu
          18,66px in dam tro len thi trang tren cam moi dat nguong chu lon
          (3:1); duoi co do la truot chuan. */}
      <span class="thanh-tren__goi vat vat--trai">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M6.5 3.5 4 4.2c-1 .3-1.6 1.3-1.3 2.3C4 12 9 17 14.5 18.3c1 .3 2-.3 2.3-1.3l.7-2.5-3.6-1.6-1.3 1.6a12 12 0 0 1-4.4-4.4l1.6-1.3-1.6-3.6Z"
        ></path></svg>
        <a href={`tel:${c.hotlineTel}`}>Hotline {c.hotline}</a>
      </span>
    </div>
  </div>

  <div class="dau-trang__trong">
    {/* Lockup thuong hieu: DAU HIEU + chu. Cong ty chua co file logo nao, ma mot
        dong chu dam khong doc ra la logo. Dau hieu la dung hinh cay dinh trong
        favicon - mot tai san, dung o hai cho, khong ve them cai moi. */}
    <a class="hieu vat vat--phai" href="/" aria-label={`${c.tenThuongHieu} - trang chủ`}>
      <span class="hieu__dau" aria-hidden="true">
        <svg viewBox="0 0 48 48">
          <rect x="11" y="9.5" width="26" height="6" rx="1.5"></rect>
          <path d="M20.6 15.5h6.8l-2.5 19.4a0.9 0.9 0 0 1-1.8 0Z"></path>
        </svg>
      </span>
      <span class="hieu__chu">
        <span class="hieu__ten">ĐINH THÉP SÀI GÒN</span>
        <span class="hieu__phu">Nhà máy sản xuất - Cường Phát Steel</span>
      </span>
    </a>

    <button
      class="nut-menu"
      type="button"
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="dieu-huong"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="dieu-huong" class="dieu-huong" aria-label="Điều hướng chính">
      <ul class="dieu-huong__cap1">
        <li>
          <a href="/nha-may/" aria-current={dangO('/nha-may/') ? 'page' : undefined}>Giới thiệu</a>
        </li>

        <li class="co-mega">
          <a href="/san-pham/" aria-expanded="false" aria-haspopup="true">Sản phẩm</a>

          <div class="mega">
            <div class="khung mega__trong">
              {
                nhom.map((n) => (
                  <div class="mega__cot">
                    <a class="mega__dau" href={`/san-pham/${n.data.slug}/`}>
                      {n.data.ten}
                    </a>
                    {n.data.tachTrangQuyCach ? (
                      <ul class="mega__ds">
                        {n.data.quyCach.map((q) => (
                          <li>
                            <a href={`/san-pham/${q.slug}/`}>
                              {tenChinh(n.data.ten, q)} <span class="mega__mm">{nhan(q)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="mega__mota">{n.data.moTaNgan}</p>
                    )}
                  </div>
                ))
              }

              {
                baiMega.length > 0 && (
                  <div class="mega__cot mega__cot--kt">
                    <a class="mega__dau" href="/kien-thuc/">
                      Tra cứu &amp; hướng dẫn
                    </a>
                    <ul class="mega__ds">
                      {baiMega.map((b) => (
                        <li>
                          <a href={`/kien-thuc/${b.id}/`}>{b.data.tieuDe}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </div>
          </div>
        </li>

        <li class="co-tha">
          <a
            href="/bang-gia-dinh-thep/"
            aria-haspopup="true"
            aria-current={dangO('/bang-gia-dinh-thep/') || dangO('/bang-tra-quy-cach-dinh/')
              ? 'page'
              : undefined}
          >
            Bảng giá
            <svg class="tha__mui" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9.5 6 6 6-6"></path></svg>
          </a>
          <ul class="tha">
            {traCuu.map((m) => (
              <li>
                <a href={m.duongDan}>{m.ten}</a>
              </li>
            ))}
          </ul>
        </li>

        {
          navSau.map((m) => (
            <li>
              <a href={m.duongDan} aria-current={dangO(m.duongDan) ? 'page' : undefined}>
                {m.ten}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="nut-lh" href="/lien-he/">
      Liên hệ ngay
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-5.5-6 6 6-6 6"></path></svg>
    </a>
  </div>
</header>

<style>
  /* Header HAI dai: do (34px) + trang mang logo va nav (76px) = 110px.
     Dinh ca header vao dinh man hinh - 110px la muc chap nhan duoc.
     (Truoc day tach nav thanh dai navy rieng va dinh bang top am -118px; user
     chot dua nav ve chung hang logo nen bo cach do.) */
  .dau-trang {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--trang);
    border-bottom: var(--vien-mong);
    /* Khoi cam (thuong hieu, hotline) TRAN ra mep man hinh bang box-shadow
       100vw. Phai cat phan tran do, neu khong trang cuon ngang duoc.
       Dung `clip` chu KHONG `hidden`: `hidden` mot truc se ep truc kia thanh
       `auto` va nuot mat mega menu do xuong duoi. `clip` giu truc doc `visible`. */
    overflow-x: clip;
  }

  /* Tang 1: dai NAVY, khoi hotline mau cam neo mep phai.
     Do theo Industro: `.container-fluid bg-dark` cho ca dai, rieng
     `.topbar-right` nen `--primary` co canh vat trai. Truoc day ta de ca dai
     mau nhan - mot mang mau bao hoa 100% chay het be ngang man hinh, doc ra
     nang va khong con cho de nhan manh hotline. */
  .thanh-tren {
    background: var(--navy-900);
    color: var(--trang);
    font-size: var(--cs-micro);
    font-weight: var(--w-vua);
  }
  /* TRAN HET BE NGANG, le 48px - do dung cua ho (`ps-5` / `pe-5` = 3rem).
     Truoc day hai hang header bo trong khung 1140 nen o man 1440 con thua
     150px trang moi ben; dai topbar doc ra nho va rut lai. Ho de ca hai hang
     tran het be ngang, chi than trang moi bo trong khung. */
  .thanh-tren__trong {
    display: flex;
    align-items: center;
    gap: var(--k5);
    min-height: 46px; /* do duoc ben ho */
    padding-left: 48px;
  }

  /* Khoi hotline: nen cam, mep trai cheo, TRAN ra mep phai man hinh.
     CACH TRAN: margin am 100vw keo mep hop ra ngoai, padding 100vw day noi
     dung ve cho cu. Tong be ngang khong doi nen bo cuc flex khong xe dich.
     DA THU `box-shadow: 100vw 0 0` va HONG: bong khong co spread chi DOI hop
     di chu khong keo dai no, nen ca vet mau nam han ngoai man hinh. */
  /* Hang da tran het be ngang nen khoi nay TU cham mep phai - bo han tro
     margin am 100vw truoc day. `padding: 8px 48px` la so do duoc cua ho. */
  .thanh-tren__goi {
    display: flex;
    align-items: center;
    gap: var(--k2);
    align-self: stretch;
    margin-left: auto;
    padding: 8px 48px;
    background: var(--cam-500);
  }
  .thanh-tren__goi svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: var(--trang);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 19px IN DAM - duoi 18,66px in dam thi trang tren cam truot ca nguong
     chu lon. Ho dung fs-5 fw-bold (20px) o dung cho nay. */
  .thanh-tren__goi a {
    font-family: var(--font-hien);
    font-size: 19px;
    font-weight: var(--w-nang);
    line-height: 1.2;
    color: var(--trang);
    text-decoration: none;
    white-space: nowrap;
  }
  .thanh-tren__goi a:hover {
    text-decoration: underline;
  }
  .thanh-tren__muc a {
    color: var(--trang);
    text-decoration: none;
  }
  .thanh-tren__muc a:hover {
    text-decoration: underline;
  }
  .thanh-tren__muc--manh {
    font-weight: var(--w-nang);
  }
  /* Icon xa hoi ben TRAI top bar - Industro dat "Follow Us:" o cot trai */
  /* Icon lien he. Ho dung glyph Font Awesome DAC o 16px mau #F5F5F5, boc
     trong nut 36x38. Icon net mong 15px cua ta truoc day doc ra nhoe va khong
     ra hinh gi - dung cai user chi ra.
     Ta khong dung Font Awesome (them mot ten mien ngoai) ma ve SVG DAC cung
     co: 18px, to fill chu khong ke net. */
  .thanh-tren__xh {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .thanh-tren__xh a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    transition: background var(--thoi) var(--nhip);
  }
  .thanh-tren__xh svg {
    width: 18px;
    height: 18px;
    fill: #f5f5f5;
    stroke: none;
  }
  .thanh-tren__xh a:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .thanh-tren__xh a:hover svg {
    fill: var(--trang);
  }

  /* Tang 2 */
  /* Logo va nav DINH LIEN NHAU ben trai, CTA day sang phai.
     Truoc day dung justify-content: space-between nen logo bam le trai va nav
     bam le phai, giua hut mot mang trong 430px - doc ra roi rac.
     Do ban tham chieu (hoclaptrinhrobotics.com, khung nhin 1425):
       logo 173-281 | khe 70 | nav 350-957 | khe 97 | CTA 1054-1253
     tuc logo+nav la MOT cum, CTA neo le phai. */
  .dau-trang__trong {
    display: flex;
    align-items: center;
    gap: var(--k6);
    min-height: 75px; /* do duoc ben ho */
    padding-right: 48px;
  }
  .dieu-huong {
    margin-right: auto; /* day CTA sang phai, nav van dinh sat logo */
  }

  /* Khoi thuong hieu = .navbar-brand cua ho: mot khoi mau DAC cao het hang,
     mep phai cheo, tran ra mep trai man hinh.
     Ho: height 75px, padding-right 50px, ::after rong 50px lech phai -25px.
     Ta giu nguyen ba con so do. */
  .hieu {
    display: flex;
    align-items: center;
    gap: var(--k3);
    align-self: stretch;
    /* `padding: 0 50px 0 48px` la so do duoc cua ho. Hang da tran het be ngang
       nen khoi nay TU cham mep trai - bo han tro margin am 100vw truoc day.
       50px ben phai chua cho mep cheo ::after rong 50px lech ra -25px. */
    padding: 0 50px 0 48px;
    background: var(--cam-500);
    text-decoration: none;
    line-height: 1.05;
  }
  /* Dau hieu: o bo goc do, cay dinh trang - cung hinh voi favicon */
  /* Dau hieu gio nam TREN nen cam nen bo o nen va bo bong: mot o cam tren
     nen cam la mot duong vien thua. Chi con hinh cay dinh mau trang. */
  .hieu__dau {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
  }
  .hieu__dau svg {
    width: 26px;
    height: 26px;
    fill: var(--trang);
  }
  .hieu__chu {
    display: grid;
    gap: 1px;
  }
  /* 26px in dam - dat nguong CHU LON (3:1) tren nen cam, do duoc 3,06:1. */
  .hieu__ten {
    font-family: var(--font-hien);
    font-size: 32px;
    font-weight: var(--w-dam);
    letter-spacing: -0.005em;
    color: var(--trang);
  }
  /* Dong phu nang tu 10,5 len 12px va doi sang trang duc.
     Luu y: o co nay chu KHONG con la "chu lon" nen ti le 3,06:1 cua trang tren
     cam-500 la KHONG dat AA. Chap nhan co y thi sai; thay vao do dong nay
     KHONG mang thong tin nao ma cho khac chua co - ten phap dinh day du nam o
     footer va trang gioi thieu. No la nhan phu tro thuan tuy. */
  .hieu__phu {
    font-size: 12px;
    font-weight: var(--w-vua);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--trang);
    opacity: 0.92;
  }

  /* ---------- nut Lien he ngay ----------
     Ban tham chieu: vien pill 999px, nen gradient, vien trang 2px, bong cung
     4px duoi day. Ta BO cai bong cung do - no cho nut mot ve day dan hop trang
     tre em, khong hop trang vat tu cong nghiep. Giu pill + gradient + bong mem
     nhuom do thuong hieu. */
  .nut-lh {
    display: inline-flex;
    align-items: center;
    gap: var(--k2);
    flex: none;
    padding: 12px 22px;
    border-radius: var(--bo-tron);
    background: linear-gradient(180deg, var(--cam-500), var(--cam-600));
    color: var(--trang);
    font-family: var(--font-hien);
    font-size: 17px;
    font-weight: var(--w-dam);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(213, 68, 0, 0.28);
    transition:
      transform var(--thoi) var(--nhip),
      box-shadow var(--thoi) var(--nhip);
  }
  .nut-lh svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nut-lh:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(213, 68, 0, 0.36);
  }

  .dieu-huong {
    display: flex;
    align-items: center;
  }
  .dieu-huong__cap1 {
    display: flex;
    align-items: center;
    gap: var(--k5);
  }
  /* Nav dung font hien thi o 17px. Be Vietnam Pro o 17px se lam nav rong them
     ~12% va het cho cho nut CTA; Barlow hep hon nen dat to duoc. */
  /* Muc nav cao het hang trang de vung bam rong, danh dau bang gach do duoi
     chan chu khong bang o nen dac - nen dac chi hop khi nav nam tren dai mau. */
  .dieu-huong__cap1 > li > a {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 75px;
    font-family: var(--font-hien);
    /* Do duoc ben ho: .nav-link font-size 18px, font-weight 500, mau --dark.
       Ta doi mau chu sang navy-900 (chinh la --dark cua ho) chu khong de mau
       chu chung: nav tren nen trang canh mot khoi cam dac thi navy noi hon. */
    font-size: 18px;
    font-weight: var(--w-thuong);
    color: var(--navy-900);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .dieu-huong__cap1 > li > a:hover,
  .dieu-huong__cap1 > li > a[aria-current='page'] {
    color: var(--cam-500);
    border-bottom-color: var(--cam-500);
  }

  /* ---------- tha xuong nho (Bang gia) ----------
     Cung co che hover/focus-within nhu mega, nhung neo theo muc chu khong
     tran het chieu rong: chi ba link thi mot bang full-bleed la lang phi. */
  .co-tha {
    position: relative;
  }
  .co-tha > a {
    gap: 4px;
  }
  .tha__mui {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tha {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 3;
    min-width: 232px;
    padding: var(--k2) 0;
    background: var(--trang);
    border: var(--vien-mong);
    border-top: 0;
    border-bottom: 3px solid var(--cam-500);
    box-shadow: var(--noi-lon);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--thoi) var(--nhip),
      transform var(--thoi) var(--nhip),
      visibility var(--thoi);
  }
  .co-tha:hover .tha,
  .co-tha:focus-within .tha {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .tha a {
    display: block;
    padding: 9px var(--k4);
    font-size: var(--cs-micro);
    font-weight: var(--w-vua);
    color: var(--muc-2);
    text-decoration: none;
  }
  .tha a:hover {
    background: var(--nen-nhat);
    color: var(--cam-500);
  }

  /* ---------- mega menu ---------- */
  /* Neo theo .dau-trang (sticky = to positioned). top: 100% = ngay duoi ca header. */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 2;
    background: var(--trang);
    border-top: var(--vien-mong);
    border-bottom: 3px solid var(--cam-500);
    box-shadow: var(--noi-lon);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--thoi) var(--nhip),
      transform var(--thoi) var(--nhip),
      visibility var(--thoi);
  }
  .co-mega:hover .mega,
  .co-mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Da-cot (column-count) chu khong phai grid.
     Ly do: cot "dinh chi" co 10 link con nam cot khac chi co mot dong mo ta.
     Voi grid thi ca HANG bi keo cao bang cot dai nhat va sinh ra hai mang
     trang lon. Column tu don cac cot cho can chieu cao. */
  .mega__trong {
    column-count: 3;
    column-gap: var(--gap-lon);
    padding-block: var(--k5);
  }
  .mega__cot {
    break-inside: avoid;
    margin-bottom: var(--k5);
  }
  .mega__cot:last-child {
    margin-bottom: 0;
  }
  .mega__dau {
    display: block;
    font-size: var(--cs-nho);
    font-weight: var(--w-nang);
    color: var(--muc);
    text-decoration: none;
    padding-bottom: var(--k2);
    margin-bottom: var(--k2);
    border-bottom: var(--vien-mong);
  }
  a.mega__dau:hover {
    color: var(--cam-500);
  }
  .mega__ds {
    display: grid;
    gap: 3px;
  }
  .mega__ds a {
    display: block;
    padding: 3px 0;
    font-size: var(--cs-micro);
    font-weight: var(--w-thuong);
    color: var(--muc-2);
    text-decoration: none;
  }
  .mega__ds a:hover {
    color: var(--cam-500);
  }
  .mega__mm {
    color: var(--muc-3);
    font-variant-numeric: tabular-nums;
  }
  /* Cot kien thuc noi bat hon cac cot nhom: nen tint + gach do trai, de mat
     nhan ra day la loai khac chu khong phai them mot nhom hang. */
  .mega__cot--kt {
    padding: var(--k4);
    background: var(--nen-nhat);
    border-left: 3px solid var(--cam-500);
    border-radius: 0 var(--bo-nho) var(--bo-nho) 0;
  }
  .mega__cot--kt .mega__ds a {
    font-weight: var(--w-vua);
    color: var(--muc);
  }
  .mega__cot--kt .mega__ds a:hover {
    color: var(--cam-500);
  }
  .mega__mota {
    font-size: var(--cs-micro);
    color: var(--muc-2);
  }

  /* ---------- nut hamburger ---------- */
  .nut-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 12px;
    min-height: var(--cham);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nut-menu span {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: var(--muc);
  }

  /* ---------- mobile ----------
     Giu nav day du. baogiathep an han nav duoi 900px - tuc cat het internal link
     o dung thiet bi chiem phan lon traffic. */
  @media (max-width: 980px) {
    /* Hang trang o mobile: logo | CTA | hamburger.
       nav luc nay la panel tuyet doi nen khong con trong hang flex nua.
       DOM van la logo - hamburger - nav - CTA (thu tu doc man hinh dung),
       chi dao vi tri BAY bang order. */
    .dau-trang__trong {
      min-height: 64px;
      gap: var(--k3);
      flex-wrap: nowrap;
    }
    /* Khoi cam o mobile: thu hep NEM VAT lai. O man 1440 nem rong 50px la
       vua, nhung o 390 thi 50px la 13% be ngang man hinh - no bop cot chu lai
       den muc dong phu phai xuong ba dong va chu "STEEL" tran ra ngoai khoi.
       Nem 34px thi ti le cheo van y het, chi nho lai. */
    .hieu {
      min-width: 0;
      gap: var(--k2);
      padding-right: 34px;
    }
    .hieu.vat--phai::after {
      width: 34px;
      right: -17px;
    }
    .hieu__dau {
      width: 36px;
      height: 36px;
      border-radius: 8px;
    }
    .hieu__dau svg {
      width: 22px;
      height: 22px;
    }
    .hieu__ten {
      font-size: 20px;
    }
    .hieu__phu {
      font-size: 9.5px;
    }
    .nut-lh {
      order: 2;
      margin-left: auto;
      padding: 9px 16px;
      font-size: 15px;
    }
    .nut-lh svg {
      width: 15px;
      height: 15px;
    }
    .nut-menu {
      order: 3;
      display: flex;
      padding: 12px 0 12px 4px;
    }
    /* Nav xo xuong thanh bang menu tran ngang duoi header.
       Giu NAV DAY DU - baogiathep an han nav duoi 900px, tuc cat het internal
       link o dung thiet bi chiem phan lon traffic. */
    .dieu-huong {
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--trang);
      border-bottom: var(--vien-mong);
      box-shadow: var(--noi-lon);
      max-height: 0;
      padding: 0 20px;
      overflow: hidden auto;
      transition:
        max-height var(--thoi) var(--nhip),
        padding var(--thoi) var(--nhip);
    }
    .dau-trang.mo .dieu-huong {
      max-height: calc(100vh - 100px);
      padding: var(--k4) 20px var(--k5);
    }
    .dieu-huong__cap1 {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .dieu-huong__cap1 > li > a {
      min-height: var(--cham);
      border-bottom: var(--vien-mong);
    }
    .dieu-huong__cap1 > li > a:hover,
    .dieu-huong__cap1 > li > a[aria-current='page'] {
      border-bottom-color: var(--vien);
      color: var(--cam-500);
    }
    .mega {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      border-bottom: var(--vien-mong);
    }
    .mega__trong {
      column-count: 1;
      padding-inline: 0;
      padding-block: var(--k4);
    }
    .mega__cot {
      margin-bottom: var(--k4);
    }
    /* Tren mobile khong co hover: tha xuong mo san, thut le de thay cap bac */
    .tha {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      min-width: 0;
      padding: 0 0 var(--k3) var(--k4);
      border: 0;
      box-shadow: none;
      border-bottom: var(--vien-mong);
    }
    .tha a {
      min-height: var(--cham);
      display: flex;
      align-items: center;
      padding-inline: 0;
    }
    .tha__mui {
      display: none;
    }
  }

  /* Duoi 560px bo nut CTA khoi header: logo + CTA + hamburger khong cung vua
     335px (do duoc: nut tran ra 20px ngoai khung, logo bi day xuong dong lam
     header cao 243px). Bo duoc vi da co thanh Goi/Zalo dinh day man hinh - CTA
     o header luc nay chi la lap lai. */
  @media (max-width: 560px) {
    .nut-lh {
      display: none;
    }
    .hieu__ten {
      font-size: 19px;
    }
    /* Le 48px cua ho la so cho man rong. O 390px no chiem 25% be ngang chi de
       lam le cho mot dong chu - ha xuong 16px de dai navy con doc ra la mot
       dai, thay vi chi con mot manh o goc trai. */
    .thanh-tren__trong {
      padding-left: 16px;
    }
    .thanh-tren__goi {
      padding-inline: 16px;
    }
    .thanh-tren__goi a {
      font-size: var(--cs-nho);
    }
    .dau-trang__trong {
      padding-right: 16px;
    }
    .hieu {
      padding-left: 16px;
    }
    /* Duoi 560px bo dong phu. Ho cung chi de moi ten thuong hieu o mobile.
       Ten phap dinh day du van co o footer va trang gioi thieu. */
    .hieu__phu {
      display: none;
    }
  }
</style>

<script>
  /* Class 'mo' dat tren .dau-trang chu khong tren #dieu-huong: dai nav gio la
     mot the rieng nam ngoai nav, CSS can biet trang thai tu cap header. */
  const nut = document.querySelector<HTMLButtonElement>('.nut-menu');
  const dau = document.querySelector<HTMLElement>('.dau-trang');
  nut?.addEventListener('click', () => {
    const mo = dau?.classList.toggle('mo');
    nut.setAttribute('aria-expanded', String(!!mo));
    nut.setAttribute('aria-label', mo ? 'Đóng menu' : 'Mở menu');
  });
</script>
