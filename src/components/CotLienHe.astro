---
import { getEntry } from 'astro:content';

/**
 * COT LIEN HE CO DINH ben phai man hinh.
 *
 * Truoc day chi co 2 nut icon tron (mot goi, mot Zalo). User yeu cau doi thanh
 * 4 so dien thoai va 2 Zalo, de TO RO va co hieu ung lac - theo mau cac trang
 * vat tu Viet Nam (baogiathep.net, thepmanhtienphat).
 *
 * BON SO DEU LA SO THAT trong cong-ty.yaml:
 *   1. hotline nha may dinh  - dat DAU TIEN vi day la trang ban dinh
 *   2-4. hotline ba chi nhanh
 * Moi nut deu ghi ro NOI nhan may, khong de bon so tran khong nhan: khach nhin
 * bon so giong het nhau se khong biet bam so nao, va do la ly do ho khong bam
 * so nao ca.
 *
 * ZALO: du lieu chi co MOT so Zalo da xac minh (`zalo` trong cong-ty.yaml).
 * KHONG tu suy them so thu hai tu cac so dien thoai khac: `zalo.me/<so>` cua
 * mot so chua dang ky Zalo se ra trang "khong tim thay nguoi dung" - hong ngay
 * tren kenh ban hang. Them so thu hai chi can them mot dong vao `zaloPhu`
 * trong cong-ty.yaml, phan render ben duoi da chay san theo mang.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;

/** Bo dau cach va dau cham de dung cho href tel: */
const soGoi = (s: string) => '+84' + s.replace(/[^0-9]/g, '').replace(/^0/, '');

/* Nha may truoc, roi ba chi nhanh. Lay tu du lieu chu khong go cung, nen sua
   cong-ty.yaml la cot nay doi theo.

   XEP THEO MUC LIEN QUAN TOI DINH, khong theo thu tu trong file: day la trang
   BAN DINH, ma trong sau dia diem thi bon cai la xuong can tole - goi vao do
   hoi mua dinh la goi sai cho. Kho vat tu kim khi gan viec hon nen len truoc.

   [CAN USER XAC NHAN] Day la suy luan tu truong `vaiTro`, khong phai tu ai
   thuc su nhan don dinh. Neu cong ty muon bon so khac thi doi thu tu o day. */
const uuTien = (vaiTro: string) => {
  const v = vaiTro.toLowerCase();
  if (v.includes('vật tư') || v.includes('kim khí')) return 0;
  if (v.includes('trụ sở')) return 1;
  return 2;
};

const chiNhanh = c.diaDiem
  .filter((d) => d.hotline && d.hotline !== c.hotline)
  .map((d) => ({ so: d.hotline as string, nhan: d.vaiTro, uu: uuTien(d.vaiTro) }))
  .sort((a, b) => a.uu - b.uu)
  .slice(0, 3)
  .map(({ so, nhan }) => ({ so, nhan }));

const dsGoi = [{ so: c.hotline, nhan: 'Nhà máy đinh' }, ...chiNhanh];

/* Chi liet ke Zalo DA XAC MINH. Xem ghi chu o dau file. */
const dsZalo = [{ so: c.zalo, nhan: 'Zalo nhà máy' }];
---

<div class="cot-lh an-mobile" aria-label="Liên hệ nhanh">
  {
    dsGoi.map((g, i) => (
      <a
        class="cot-lh__nut"
        data-kieu={i % 2 === 0 ? 'cam' : 'navy'}
        href={`tel:${soGoi(g.so)}`}
        aria-label={`Gọi ${g.nhan} ${g.so}`}
        title={g.nhan}
        style={`--tre: ${i * 0.35}s`}
      >
        <span class="cot-lh__o" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M6.6 2.6a1.7 1.7 0 0 1 2.2.6l2 3.2a1.7 1.7 0 0 1-.3 2.2L9 9.8a11 11 0 0 0 5.2 5.2l1.2-1.5a1.7 1.7 0 0 1 2.2-.3l3.2 2a1.7 1.7 0 0 1 .6 2.2l-1 1.8a2.6 2.6 0 0 1-2.9 1.2C11.1 19 5 12.9 3.6 6.5a2.6 2.6 0 0 1 1.2-2.9Z" />
          </svg>
        </span>
        <span class="cot-lh__chu">
          <b>{g.so}</b>
          <em>{g.nhan}</em>
        </span>
      </a>
    ))
  }

  {
    dsZalo.map((z, i) => (
      <a
        class="cot-lh__nut"
        data-kieu="zalo"
        href={`https://zalo.me/${z.so}`}
        rel="noopener"
        aria-label={`Nhắn ${z.nhan}`}
        title={z.nhan}
        style={`--tre: ${(dsGoi.length + i) * 0.35}s`}
      >
        <span class="cot-lh__o" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 2.6c5.4 0 9.7 3.6 9.7 8.1 0 4.5-4.3 8.1-9.7 8.1a12 12 0 0 1-2.3-.2l-4.6 2.5a.6.6 0 0 1-.9-.6l.6-3.3c-1.7-1.5-2.5-3.4-2.5-5.5 0-4.5 4.3-8.1 9.7-8.1Z" />
            <path class="cot-lh__z" d="M8.4 7.9h6.3v1.5l-4 4.4h4.2v1.6H8v-1.6l4-4.4H8.4z" />
          </svg>
        </span>
        <span class="cot-lh__chu">
          <b>Nhắn Zalo</b>
          <em>{z.nhan}</em>
        </span>
      </a>
    ))
  }
</div>

<style>
  /* Neo o NUA DUOI chu khong can giua man hinh.
     Can giua thi cot nay de dung len mui ten phai cua banner (vung bam mui ten
     rong 15% tinh tu mep phai, vong tron nam giua vung do o dung tam chieu
     cao) - do duoc mui ten bi che hoan toan, khong bam duoc.
     Sat mep duoi (30px) chu khong 108px: o 108px cot cao 290px thi dinh cot
     len tan y=502, con vong mui ten phai o y=476..524 - do duoc con chong
     nhau 22px. O 30px thi dinh cot o y=580, cach mui ten 56px.
     Duoc cho do la nut len dau trang phai doi sang mep TRAI - xem industro.css. */
  .cot-lh {
    position: fixed;
    right: 14px;
    bottom: 30px;
    z-index: 45;
    display: grid;
    gap: 10px;
  }

  /* Nut dang vien thuoc: o icon tron + so. So HIEN SAN chu khong doi re chuot
     moi hien - user yeu cau "to ro, noi bat". */
  .cot-lh__nut {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 16px 5px 5px;
    border-radius: var(--bo-tron);
    text-decoration: none;
    color: var(--trang);
    box-shadow: 0 3px 12px rgba(2, 36, 91, 0.28);
    transition:
      transform var(--thoi) var(--nhip),
      box-shadow var(--thoi) var(--nhip);
  }
  .cot-lh__nut[data-kieu='cam'] {
    background: var(--cam-500);
  }
  .cot-lh__nut[data-kieu='navy'] {
    background: var(--navy-900);
  }
  /* Xanh thuong hieu Zalo - khong thay bang mau cua ta: nguoi Viet nhan ra
     mau nay ngay, doi mau la mat cai loi the do. */
  .cot-lh__nut[data-kieu='zalo'] {
    background: #0068ff;
  }
  .cot-lh__nut:hover {
    color: var(--trang);
    transform: translateY(1px);
    box-shadow: 0 2px 6px rgba(2, 36, 91, 0.34);
  }

  /* O icon tron, mang ca vong song va cu lac */
  .cot-lh__o {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }
  .cot-lh__o svg {
    width: 21px;
    height: 21px;
    fill: var(--trang);
    /* Lac 12 do roi tat dan, moi 3 giay mot lan. Lac lien tuc thi mat met va
       doc ra nhu quang cao rac; lac ngan roi nghi moi keo duoc chu y. */
    animation: lac 3s ease-in-out infinite;
    animation-delay: var(--tre, 0s);
  }
  .cot-lh__z {
    fill: #0068ff;
  }

  /* Vong song toa ra - do theo mau user gui */
  .cot-lh__o::before {
    position: absolute;
    content: '';
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: song 2.4s ease-out infinite;
    animation-delay: var(--tre, 0s);
  }

  .cot-lh__chu {
    display: grid;
    gap: 0;
    line-height: 1.2;
  }
  .cot-lh__chu b {
    font-family: var(--font-hien);
    font-size: 17px;
    font-weight: var(--w-nang);
    letter-spacing: 0.01em;
  }
  .cot-lh__chu em {
    font-style: normal;
    font-size: 11.5px;
    font-weight: var(--w-thuong);
    opacity: 0.86;
  }

  @keyframes lac {
    0%,
    72%,
    100% {
      transform: rotate(0);
    }
    76% {
      transform: rotate(-12deg);
    }
    80% {
      transform: rotate(12deg);
    }
    84% {
      transform: rotate(-9deg);
    }
    88% {
      transform: rotate(7deg);
    }
    92% {
      transform: rotate(-4deg);
    }
  }
  @keyframes song {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* Man hep khong hien cot nay: da co thanh CTA dinh day man hinh, va sau
     vien thuoc se che mat noi dung. */
  @media (max-width: 1180px) {
    .cot-lh__chu {
      display: none;
    }
    .cot-lh__nut {
      padding: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cot-lh__o svg,
    .cot-lh__o::before {
      animation: none;
    }
    .cot-lh__o::before {
      display: none;
    }
  }
</style>
