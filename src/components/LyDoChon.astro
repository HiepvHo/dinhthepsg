---
/**
 * Dai "Ly do chon chung toi" - thay cho 4 chip mau dac cu.
 *
 * VI SAO BO 4 CHIP: bon khoi mau bao hoa (do/navy/xanh la) nam sat nhau ngay
 * duoi banner keo het su chu y ra khoi anh nha may, va ba mau tin hieu trong
 * mot hang lam trang doc ra nhu bang dieu khien chu khong phai trang ban hang.
 *
 * Hoc tu mamaflow.vn (do 01/09/2026): icon tron + tieu de + phu, can giua,
 * KHONG co khoi mau - mau chi nam trong vong tron icon. Nhip cua ho la
 * trang + MOT mau bao hoa + tint rat nhat cua chinh mau do.
 *
 * NOI DUNG PHAI CU THE. "Chat luong - Uy tin - Tan tam" la loai chu khong ai
 * doc; con so va dia danh thi doc duoc va cung la tu khoa.
 */
interface Props {
  soQuyCach: number;
}
const { soQuyCach } = Astro.props;

const muc = [
  {
    ten: 'Tự sản xuất tại nhà máy',
    phu: `${soQuyCach} quy cách, bán trực tiếp không qua trung gian`,
    icon: 'nha-may',
  },
  {
    ten: 'Thông số công bố đủ',
    phu: 'Chiều dài và đường kính theo phân, cm và mm',
    icon: 'thuoc',
  },
  {
    ten: 'Giao tận công trình',
    phu: 'TP.HCM, Long An và các tỉnh lân cận',
    icon: 'xe',
  },
  {
    ten: 'Nhận đơn quy cách riêng',
    phu: 'Nhà máy chạy theo đơn, đặt được số lượng lớn',
    icon: 'thung',
  },
];
---

<section class="ly-do" aria-labelledby="ly-do-dau">
  <div class="khung">
    <h2 class="ly-do__dau" id="ly-do-dau">Lý do chọn chúng tôi</h2>
    <ul class="ly-do__hang">
      {
        muc.map((m) => (
          <li class="ly-do__muc">
            <span class="ly-do__vong" aria-hidden="true">
              {m.icon === 'nha-may' && (
                <svg viewBox="0 0 24 24">
                  <path d="M3 20h18" />
                  <path d="M4 20v-9l4.5 2.7V11L13 13.7V11l4.5 2.7V20" />
                  <path d="M17.6 11 18.1 4h2.3l.5 7" />
                </svg>
              )}
              {m.icon === 'thuoc' && (
                <svg viewBox="0 0 24 24">
                  <rect x="2.5" y="8" width="19" height="8" rx="1" />
                  <path d="M7 8v3.4M11 8v4.4M15 8v3.4M19 8v4.4" />
                </svg>
              )}
              {m.icon === 'xe' && (
                <svg viewBox="0 0 24 24">
                  <path d="M2 5.5h11.5v11H2z" />
                  <path d="M13.5 9h3.9L22 12.6v3.9h-8.5" />
                  <circle cx="7" cy="18.5" r="2" />
                  <circle cx="17.5" cy="18.5" r="2" />
                </svg>
              )}
              {m.icon === 'thung' && (
                <svg viewBox="0 0 24 24">
                  <path d="M12 2.8 20.6 7v10L12 21.2 3.4 17V7L12 2.8Z" />
                  <path d="M3.4 7 12 11.4 20.6 7M12 11.4v9.8" />
                </svg>
              )}
            </span>
            <strong>{m.ten}</strong>
            <span class="ly-do__phu">{m.phu}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ly-do {
    padding-block: var(--k7);
    border-bottom: var(--vien-mong);
  }
  /* Tieu de nho, chu hoa gian - o day no la nhan cua dai chu khong phai
     tieu de canh tranh voi H1 ngay ben duoi. */
  .ly-do__dau {
    text-align: center;
    font-size: var(--cs-micro);
    font-weight: var(--w-nang);
    letter-spacing: var(--gc-micro);
    text-transform: uppercase;
    color: var(--do-500);
    margin-bottom: var(--k6);
  }
  .ly-do__hang {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-lon);
  }
  .ly-do__muc {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    padding-inline: var(--k3);
  }
  /* Duong ke doc mong giua cac cot - thay cho vien the.
     Mat do cao hon the ma khong them mot khung nao len trang. */
  .ly-do__muc + .ly-do__muc {
    border-left: var(--vien-mong);
  }
  .ly-do__vong {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: var(--do-050);
    transition: background var(--thoi) var(--nhip);
  }
  .ly-do__vong svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--do-500);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ly-do__muc strong {
    font-size: var(--cs-than);
    font-weight: var(--w-dam);
    line-height: var(--dc-vua);
  }
  .ly-do__phu {
    font-size: var(--cs-nho);
    color: var(--muc-2);
    max-width: 26ch;
  }

  @media (max-width: 980px) {
    .ly-do__hang {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--k6) var(--gap);
    }
    /* Ke doc chi con giua hai cot, khong ke o dau moi hang */
    .ly-do__muc + .ly-do__muc {
      border-left: 0;
    }
    .ly-do__muc:nth-child(even) {
      border-left: var(--vien-mong);
    }
  }
  /* Duoi 560px doi sang bo cuc NGANG: icon trai, chu phai, canh trai.
     Xep doc can-giua o day ton 846px chieu cao - tuc H1 va doan gioi thieu
     bi day xuong qua man hinh thu hai truoc khi nguoi doc thay chu nao. */
  @media (max-width: 560px) {
    .ly-do {
      padding-block: var(--k6);
    }
    .ly-do__dau {
      margin-bottom: var(--k5);
    }
    .ly-do__hang {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ly-do__muc {
      grid-template-columns: 48px 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: 2px var(--k4);
      padding: var(--k4) 0;
    }
    .ly-do__muc:nth-child(even),
    .ly-do__muc + .ly-do__muc {
      border-left: 0;
      border-top: var(--vien-mong);
    }
    .ly-do__vong {
      grid-row: 1 / 3;
      width: 48px;
      height: 48px;
      margin-bottom: 0;
    }
    .ly-do__vong svg {
      width: 23px;
      height: 23px;
    }
    .ly-do__phu {
      max-width: none;
    }
  }
</style>
