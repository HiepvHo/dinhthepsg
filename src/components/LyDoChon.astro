---
/**
 * Dai "Ly do chon chung toi" - thay cho 4 chip mau dac cu.
 *
 * VI SAO BO 4 CHIP: bon khoi mau bao hoa (do/navy/xanh la) nam sat nhau ngay
 * duoi banner keo het su chu y ra khoi anh nha may, va ba mau tin hieu trong
 * mot hang lam trang doc ra nhu bang dieu khien chu khong phai trang ban hang.
 *
 * HOC TU mamaflow.vn (do 01/09/2026), dai `.service-highlights` cua ho:
 *   cao 107px, dem 20px, nam o y=642 tuc DUNG DAY BANNER - khong mot khe ho nao.
 *   Moi muc 232px: icon trai, hai dong chu phai.
 *   Ho boc trong owl-carousel VI 6 muc x 242px = 1452px > 1425px khung nhin,
 *   tuc slider la CACH CHUA TRAN chu khong phai y do tham my.
 *
 * TA CO 4 MUC, vua thoai mai trong 1140px -> KHONG boc slider. Slider 4 muc thi
 * hoac khong bao gio chay (JS thua), hoac tu troi va day chu nguoi ta dang doc.
 * Thay vao do dung grid-auto-columns: minmax(240px, 1fr) + overflow-x:
 *   4 muc  -> moi cot 285px, khong tran, dung yen
 *   6 muc  -> 1fr chi con 190px < 240px nen cot bi ep ve 240px, tong 1440 > 1140,
 *             tran -> tu cuon duoc
 * Them muc thu 5 la no thanh slider, khong phai sua dong CSS nao.
 *
 * KHONG CO TIEU DE NHIN THAY. Dai nay la vach tin cay noi lien banner, khong
 * phai mot section rieng; them mot dong "LY DO CHON CHUNG TOI" o giua la dung
 * mot cai chan ngang giua banner va noi dung. Ho cung khong co tieu de.
 *
 * NOI DUNG PHAI CU THE. "Chat luong - Uy tin - Tan tam" la loai chu khong ai
 * doc; con so va dia danh thi doc duoc va cung la tu khoa.
 */
interface Props {
  soQuyCach: number;
}
const { soQuyCach } = Astro.props;

const muc = [
  {
    ten: 'Tự sản xuất tại nhà máy',
    phu: `${soQuyCach} quy cách, không qua trung gian`,
    icon: 'nha-may',
  },
  { ten: 'Thông số công bố đủ', phu: 'Theo phân, cm và mm', icon: 'thuoc' },
  { ten: 'Giao tận công trình', phu: 'TP.HCM, Long An và lân cận', icon: 'xe' },
  { ten: 'Nhận đơn quy cách riêng', phu: 'Nhà máy chạy theo đơn', icon: 'thung' },
];
---

<section class="ly-do" aria-label="Lý do chọn Đinh Thép Sài Gòn">
  <div class="khung">
    <ul class="ly-do__hang">
      {
        muc.map((m) => (
          <li class="ly-do__muc">
            <span class="ly-do__vong" aria-hidden="true">
              {m.icon === 'nha-may' && (
                <svg viewBox="0 0 24 24">
                  <path d="M3 20h18" />
                  <path d="M4 20v-9l4.5 2.7V11L13 13.7V11l4.5 2.7V20" />
                  <path d="M17.6 11 18.1 4h2.3l.5 7" />
                </svg>
              )}
              {m.icon === 'thuoc' && (
                <svg viewBox="0 0 24 24">
                  <rect x="2.5" y="8" width="19" height="8" rx="1" />
                  <path d="M7 8v3.4M11 8v4.4M15 8v3.4M19 8v4.4" />
                </svg>
              )}
              {m.icon === 'xe' && (
                <svg viewBox="0 0 24 24">
                  <path d="M2 5.5h11.5v11H2z" />
                  <path d="M13.5 9h3.9L22 12.6v3.9h-8.5" />
                  <circle cx="7" cy="18.5" r="2" />
                  <circle cx="17.5" cy="18.5" r="2" />
                </svg>
              )}
              {m.icon === 'thung' && (
                <svg viewBox="0 0 24 24">
                  <path d="M12 2.8 20.6 7v10L12 21.2 3.4 17V7L12 2.8Z" />
                  <path d="M3.4 7 12 11.4 20.6 7M12 11.4v9.8" />
                </svg>
              )}
            </span>
            <strong>{m.ten}</strong>
            <span class="ly-do__phu">{m.phu}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Dinh sat day banner - day la thu tao cam giac "noi lien" ma mamaflow co.
     Dem 18px moi ben, khong padding-block lon nhu mot section thuong. */
  .ly-do {
    padding-block: 18px;
    border-bottom: var(--vien-mong);
  }

  /* 4 muc -> moi cot 1fr (285px), khong tran, dung yen.
     Them muc thu 5-6 -> 1fr tut duoi 240px nen cot bi ep ve 240px va tran ->
     tu cuon duoc bang ngon tay. Khong can mot dong JS nao. */
  .ly-do__hang {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .ly-do__hang::-webkit-scrollbar {
    display: none;
  }

  /* Icon trai, hai dong chu phai - dung bo cuc cua ho. Xep doc can giua doc
     ra nhu mot section san pham, khong ra vach tin cay. */
  .ly-do__muc {
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: center;
    gap: 1px var(--k3);
    /* Dem 16px chu khong 24px: cot rong 285px, tru icon 44 + khe 12 + dem thi
       chu chi con ~181px va "Nhan don quy cach rieng" xuong dong, lam bon muc
       lech duong chan nhau. 16px du cho tieu de nam gon mot dong. */
    padding: 6px var(--k4);
  }
  .ly-do__muc + .ly-do__muc {
    border-left: var(--vien-mong);
  }
  .ly-do__muc:first-child {
    padding-left: 0;
  }
  .ly-do__vong {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--do-050);
  }
  .ly-do__vong svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--do-500);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ly-do__muc strong {
    align-self: end;
    font-size: var(--cs-nho);
    font-weight: var(--w-dam);
    line-height: 1.3;
  }
  .ly-do__phu {
    align-self: start;
    font-size: var(--cs-micro);
    color: var(--muc-2);
    line-height: 1.35;
  }

  @media (max-width: 980px) {
    .ly-do__hang {
      grid-auto-columns: minmax(232px, 1fr);
    }
    .ly-do__muc {
      padding-inline: var(--k3);
    }
  }
  /* Duoi 560px xep doc lai: cuon ngang mot dai chu o man hep de bo sot muc,
     ma bon muc nay deu la ly do mua hang nen phai thay het. */
  @media (max-width: 560px) {
    .ly-do {
      padding-block: var(--k3) var(--k4);
    }
    .ly-do__hang {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      overflow-x: visible;
    }
    .ly-do__muc {
      padding: var(--k3) 0;
    }
    .ly-do__muc + .ly-do__muc {
      border-left: 0;
      border-top: var(--vien-mong);
    }
  }
</style>
