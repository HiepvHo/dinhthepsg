---
/**
 * MUC LUC BAI VIET - hop "Noi Dung Chinh".
 *
 * Do dayluoithep.com/luoi-thep-han/ ngay 02/09/2026:
 *   hop rong 543px trong cot noi dung 773px (70%), nen #F9F9F9,
 *   vien 1px #AAAAAA, bo goc 4px, dem 10px 20px 10px 10px,
 *   tieu de "Noi Dung Chinh", danh sach danh so, cap 2 thut vao,
 *   co nut thu gon. Bai cua ho 5.427 tu, 1 H1 / 6 H2 / 5 H3.
 *
 * TA KHAC HO HAI CHO:
 *
 * 1. DUNG <details> CHU KHONG PHAI JS. Ho dung plugin ez-toc voi mot nut
 *    JavaScript. <details>/<summary> cho dung hanh vi do san: thu gon duoc, di
 *    duoc bang ban phim, va van mo duoc khi JS chua tai. Bot mot phu thuoc.
 *
 * 2. MO SAN (thuoc tinh open). Muc luc thu gon san thi phan lon nguoi doc khong
 *    bao gio bam mo, va cac link ben trong mat gia tri dieu huong.
 *
 * DANH SACH LONG THAT, khong phai danh sach phang co class.
 * Da thu cach phang + hai bo dem CSS va do duoc no HONG: muc con ra
 * "2.1, 2.2, 3.3, 3.4" thay vi "2.1, 2.2, 3.1, 3.2" - `counter-reset` dat tren
 * mot the anh em khong tao duoc pham vi dem moi cho cac the anh em phia sau.
 * Long ol trong ol thi moi ol con la mot pham vi rieng, dem lai tu dau.
 *
 * Muc luc chi hien khi co tu 3 muc tro len - hai muc thi no chi la mot cai hop
 * chiem cho.
 */
export interface MucLucMuc {
  /** Muc do the: 2 = H2, 3 = H3 */
  capDo: number;
  /** id cua the tieu de, de neo toi */
  neo: string;
  chu: string;
}
interface Props {
  muc: MucLucMuc[];
  dau?: string;
}
const { muc, dau = 'Nội dung chính' } = Astro.props;

/* Chi lay H2 va H3. H4 tro xuong dua vao lam muc luc dai hon phan noi dung. */
const loc = muc.filter((m) => m.capDo === 2 || m.capDo === 3);

/* Dung cay: moi H2 la mot muc, cac H3 dung sau no thanh con cua no.
   H3 nam truoc H2 dau tien thi bo - no khong co cha de neo vao. */
type Nut = MucLucMuc & { con: MucLucMuc[] };
const cay: Nut[] = [];
for (const m of loc) {
  if (m.capDo === 2) cay.push({ ...m, con: [] });
  else if (cay.length > 0) cay[cay.length - 1].con.push(m);
}
---

{
  loc.length >= 3 && (
    <details class="ml" open>
      <summary class="ml__dau">{dau}</summary>
      <ol class="ml__ds">
        {cay.map((m) => (
          <li class="ml__muc">
            <a href={`#${m.neo}`}>{m.chu}</a>
            {m.con.length > 0 && (
              <ol class="ml__con">
                {m.con.map((k) => (
                  <li>
                    <a href={`#${k.neo}`}>{k.chu}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .ml {
    max-width: 560px;
    margin-block: var(--k6);
    padding: var(--k3) var(--k4) var(--k4);
    background: var(--nen-nhat);
    border: var(--vien-dam-1);
    border-radius: var(--bo-nho);
    font-size: var(--cs-nho);
  }
  .ml__dau {
    display: flex;
    align-items: center;
    gap: var(--k2);
    font-family: var(--font-hien);
    font-size: var(--cs-h3);
    font-weight: var(--w-nang);
    letter-spacing: var(--gc-dau);
    cursor: pointer;
    list-style: none;
  }
  /* Bo mui ten mac dinh cua trinh duyet roi tu ve, de xoay duoc theo trang thai */
  .ml__dau::-webkit-details-marker {
    display: none;
  }
  .ml__dau::before {
    content: '';
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--do-500);
    border-bottom: 2px solid var(--do-500);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--thoi) var(--nhip);
  }
  .ml:not([open]) .ml__dau::before {
    transform: rotate(-45deg) translate(-2px, 2px);
  }

  .ml__ds {
    counter-reset: ml;
    margin-top: var(--k3);
    padding-top: var(--k3);
    border-top: var(--vien-mong);
  }
  .ml__muc {
    counter-increment: ml;
  }
  /* Moi ol con la mot pham vi dem rieng nen tu dem lai tu 1 */
  .ml__con {
    counter-reset: mlc;
  }
  .ml__con li {
    counter-increment: mlc;
  }

  .ml a {
    display: flex;
    gap: var(--k2);
    padding: 5px 0;
    line-height: var(--dc-vua);
    color: var(--lien-ket);
    text-decoration: none;
  }
  .ml a:hover {
    text-decoration: underline;
  }
  .ml__muc > a::before {
    content: counter(ml) '.';
    flex: none;
    min-width: 18px;
    color: var(--muc-3);
    font-variant-numeric: tabular-nums;
  }
  .ml__con {
    padding-left: var(--k5);
  }
  .ml__con a {
    font-size: var(--cs-micro);
  }
  .ml__con a::before {
    content: counter(ml) '.' counter(mlc);
    flex: none;
    min-width: 26px;
    color: var(--muc-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    .ml {
      max-width: none;
    }
  }
</style>
