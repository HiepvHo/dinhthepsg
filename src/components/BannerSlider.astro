---
import { Image } from 'astro:assets';

/**
 * BANNER - do theo #header-carousel cua template Industro ngay 03/09/2026.
 *
 * SO DO HO (khung nhin 1440, do bang trinh duyet that):
 *   carousel cao 802px, MOT anh tran het be ngang (khong he lo hai ben)
 *   lop phu: linear-gradient(to right, rgb(2,36,91) 0%, rgba(2,36,91,0) 100%)
 *   nhan tren  20px weight 600 mau cam
 *   tieu de    80px weight 700 trang
 *   nut        padding 16px 48px nen cam
 *   vung bam mui ten: rong 15% (214px), CAO HET banner, opacity .5
 *   mui ten   : vong 56px (KHONG phai 86px - xem ghi chu o phan CSS),
 *               opacity .5 -> .9 khi re, chuyen trong 0.15s
 *   nhan tren : 20px/600, letter-spacing NORMAL, margin-bottom 16px
 *   tieu de   : 80px/700, line-height 96px (=1.2), margin-bottom 48px
 *   nut       : 16px/500, padding 16px 48px
 *   cot chu   : x=163 rong 1100 - KHONG lui vao, va van khong dam vao mui ten
 *               vi vong mui ten chi 56px (ket thuc o x=135)
 *   ty le tieu de / nhan = 4,00 lan
 *
 * TRUOC DAY ta lam theo mamaflow.vn: he lo 70% co hai anh khuyet hai ben,
 * khong co chu. User doi sang kieu Industro ngay 03/09.
 *
 * TA KHAC HO BA CHO, deu co ly do:
 *
 * 1. CHIEU CAO theo man hinh chu khong go cung 802px. Ho 802 cong header 121 =
 *    923px, tuc dai ly do ngay duoi bi day khoi man hinh dau. User da chot dai
 *    ly do phai nam gon trong man hinh dau nen giu cong thuc `100vh - 225px`.
 *
 * 2. MOT KHOI CHU CO DINH, khong doi theo tung anh. Ho de moi slide mot caption
 *    rieng, moi caption mot the <h1> - tuc trang co HAI H1, day la loi SEO cua
 *    chinh template. Ta de mot khoi chu duy nhat mang H1, anh chay phia sau.
 *    Duoc them: chu khong nhay moi lan doi anh.
 *
 * 3. TIEU DE dung clamp() chu khong go 80px. Cau tieng Viet cua ta dai hon
 *    "Industrial Solution Providing Company" nen 80px se thanh bon dong.
 *
 * LAP VONG: nhan ban slide cuoi dat len dau va slide dau dat xuong cuoi, chay
 * toi ban sao roi NHAY khong hieu ung ve ban that. Ban sao khong ton byte:
 * Astro sinh cung URL anh nen trinh duyet dung lai cache.
 *
 * Chieu cao co dinh de khong gay CLS.
 */
interface Anh {
  src: ImageMetadata;
  alt: string;
}
interface Nut {
  chu: string;
  duongDan: string;
  chinh?: boolean;
}
interface Props {
  anh: Anh[];
  giay?: number;
  nhan?: string;
  tieuDe?: string;
  phu?: string;
  nut?: Nut[];
}
const { anh, giay = 5.5, nhan, tieuDe, phu, nut = [] } = Astro.props;

/* [ban sao cuoi, ...that, ban sao dau] - chi khi co tu 2 anh tro len */
const lap = anh.length > 1;
const day = lap ? [anh[anh.length - 1], ...anh, anh[0]] : anh;
const dauThat = lap ? 1 : 0;
---

<div
  class="bn"
  data-giay={giay}
  data-that={anh.length}
  data-lap={lap ? '1' : '0'}
  style={`--i: ${dauThat}`}
  role="region"
  aria-roledescription="Băng ảnh"
  aria-label="Hình ảnh nhà máy Đinh Thép Sài Gòn"
>
  <div class="bn__ray">
    {
      day.map((a, i) => {
        const banSao = lap && (i === 0 || i === day.length - 1);
        return (
          <div
            class="bn__anh"
            data-giua={i === dauThat ? '' : undefined}
            aria-hidden={banSao ? 'true' : undefined}
            role={banSao ? undefined : 'group'}
            aria-roledescription={banSao ? undefined : 'Ảnh'}
            aria-label={banSao ? undefined : `${i - dauThat + 1} trên ${anh.length}`}
          >
            {/* Ban sao VAN GIU alt that. Truyen chuoi rong thi Astro bo han
                thuoc tinh alt ra khoi the img (da do duoc), va trinh doc man
                hinh se doc ten file thay cho mo ta. Trung lap khong thanh van
                de vi the bao ngoai da aria-hidden. */}
            <Image
              src={a.src}
              alt={a.alt}
              widths={[900, 1400, 1920]}
              sizes="100vw"
              loading={i <= dauThat + 1 ? 'eager' : 'lazy'}
              fetchpriority={i === dauThat ? 'high' : 'auto'}
            />
          </div>
        );
      })
    }
  </div>

  {
    tieuDe && (
      <div class="bn__chu">
        <div class="khung">
          {nhan && <p class="bn__nhan">{nhan}</p>}
          <h1 class="bn__dau">{tieuDe}</h1>
          {phu && <p class="bn__phu">{phu}</p>}
          {nut.length > 0 && (
            <div class="bn__nut">
              {nut.map((n) => (
                <a class={n.chinh ? 'bn__n bn__n--chinh' : 'bn__n'} href={n.duongDan}>
                  {n.chu}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    anh.length > 1 && (
      <Fragment>
        <button type="button" class="bn__lai bn__lai--truoc" data-huong="-1" aria-label="Ảnh trước">
          <span class="bn__vong" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m14.5 5-7 7 7 7" /></svg>
          </span>
        </button>
        <button type="button" class="bn__lai bn__lai--sau" data-huong="1" aria-label="Ảnh tiếp theo">
          <span class="bn__vong" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7" /></svg>
          </span>
        </button>
      </Fragment>
    )
  }
</div>

<style>
  .bn {
    /* MOT anh tran het be ngang - giong ho. Truoc day de 70% de he lo hai ben
       theo kieu mamaflow; kieu do khong con cho nao dat khoi chu. */
    --i: 0;
    position: relative;
    width: 100%;
    /* Cao theo MAN HINH, va CHUA CHO cho dai ly do ngay duoi.
       Tru 225px = header 121 + dai ly do 104. */
    height: clamp(400px, calc(100vh - 225px), 760px);
    overflow: hidden;
    background: var(--navy-900);
  }

  .bn__ray {
    display: flex;
    height: 100%;
    transform: translateX(calc(-100% * var(--i)));
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }
  .bn__ray--nhay {
    transition: none;
  }

  .bn__anh {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }
  .bn__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- khoi chu ----------
     Lop phu CHINH LA nen cua khoi chu: gradient navy dac ben trai nhat dan
     sang phai - do nguyen van cua ho.
     Ta keo diem tat ve 85% chu khong 100%, va giu mot lop mo o giua: anh cua
     ta la anh CHUP nha may day chi tiet khap khung, con anh cua ho la anh dan
     dung co san mot mang toi ben trai. */
  .bn__chu {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    background: linear-gradient(
      to right,
      rgba(2, 36, 91, 0.94) 0%,
      rgba(2, 36, 91, 0.72) 42%,
      rgba(2, 36, 91, 0) 85%
    );
    /* De lot chuot xuong duoi cho bam duoc mui ten; rieng nut thi nhan lai */
    pointer-events: none;
  }
  .bn__chu :global(a) {
    pointer-events: auto;
  }
  /* KHONG lui chu vao. Do duoc cot chu cua ho bat dau o x=163 - dung bang
     mep khung cua ta. Truoc day ta phai lui 8,333% vi vong mui ten cua ta to
     86px nen dam vao chu; nhung 86px la SO SAI (xem ghi chu o phan mui ten).
     Vong dung 56px thi ket thuc o x=135, cach chu 28px - khong can lui gi. */

  /* Ho: 20px/600, mau cam, margin-bottom 16px, letter-spacing NORMAL.
     Ta tung dat gian chu 0,06em - no lam dong nhan loang ra va mat do net
     chac. Ho de normal. Tren nen navy cam-500 duoc 4,88:1 - dat AA. */
  .bn__nhan {
    /* 8px chu khong 16px cua ho: nhan va tieu de la MOT cum y nghia, de sat
       nhau thi doc ra la mot khoi chu khong phai hai dong roi. */
    margin-bottom: var(--k2);
    font-family: var(--font-hien);
    font-size: 20px;
    font-weight: var(--w-vua);
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--cam-500);
  }
  /* Ho: 80px/700, line-height 96px = 1.2, margin-bottom 48px.
     TY LE la thu quyet dinh cam giac: 80/20 = DUNG 4 lan. Ta tung de 69px
     (3,45 lan) nen buoc nhay giua nhan va tieu de khong du dut khoat - dung
     cai user chi ra khi noi "cho can nho, can to".
     Line-height 1.06 truoc day qua chat cho tieng Viet: dau thanh o dong tren
     gan cham chan chu dong duoi. 1.2 la so cua ho va vua du cho dau.
     KHONG dat max-width: cot chu cua ho rong 1100 va cau tu xuong dong khi
     het cho - cau cua ta dai hon nen cung xuong hai dong nhu vay. */
  .bn__dau {
    max-width: 20ch;
    /* 72px chu khong 80px cua ho. Chu tieng Viet co dau thanh chong nen o cung
       mot px no chiem cao hon chu Latin; 80px doc ra nang hon ben ho. */
    font-size: clamp(32px, 5vw, 72px);
    line-height: 1.18;
    letter-spacing: var(--gc-display);
    color: var(--trang);
  }
  /* Ho KHONG co dong nay - caption cua ho chi co nhan, tieu de, nut.
     Ta giu vi no mang thong tin that (sau loai san pham, ban truc tiep) va
     do la thu khach B2B can. Nhung ha xuong 16,5px chu khong 19px: o 19px no
     ngang co voi nut va lam phan cap bet lai thanh bon bac deu nhau. */
  .bn__phu {
    max-width: 50ch;
    margin-top: var(--k4);
    font-size: var(--cs-than);
    line-height: 1.6;
    color: #c9d6ea; /* trang nga tren navy - 9,4:1 */
  }

  /* 48px = margin-bottom cua the h1 ben ho. Khe rong nay la mot phan lam
     caption cua ho doc ra thoang: tieu de rat lon roi mot khoang trong han
     truoc mot cai nut rat nho. */
  .bn__nut {
    display: flex;
    flex-wrap: wrap;
    gap: var(--k3);
    margin-top: var(--k7);
  }
  /* Ho: padding 16px 48px, 16px/500, VUONG GOC.
     Ta de 19px IN DAM chu khong 16px/500 cua ho, va day la mot rang buoc ky
     thuat chu khong phai so thich: nut chinh phai mang mau cam-500 song (user
     yeu cau "de mau nhu mau"), ma chu trang tren cam-500 chi duoc 3,06:1.
     WCAG tinh chu tu 18,66px IN DAM tro len la chu LON, nguong ha con 3:1 -
     luc do 3,06:1 moi dat. Duoi co do thi phai dung cam-600 xin hon. */
  .bn__n {
    display: inline-flex;
    align-items: center;
    padding: 15px 34px;
    font-family: var(--font-hien);
    font-size: 19px;
    font-weight: var(--w-dam);
    text-decoration: none;
    border: 2px solid var(--trang);
    color: var(--trang);
    transition:
      background var(--thoi) var(--nhip),
      border-color var(--thoi) var(--nhip),
      transform var(--thoi) var(--nhip),
      box-shadow var(--thoi) var(--nhip);
  }
  .bn__n:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--trang);
  }
  /* cam-500 song - dung mau cua ho. Dat duoc nho chu 19px in dam o tren. */
  .bn__n--chinh {
    background: var(--cam-500);
    border-color: var(--cam-500);
  }
  /* An xuong khi re, giong nut o header - khong nhich len */
  .bn__n--chinh:hover {
    background: var(--cam-600);
    border-color: var(--cam-600);
    transform: translateY(1px);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.22);
  }
  .bn__n:hover {
    transform: translateY(1px);
  }
  .bn__n:active,
  .bn__n--chinh:active {
    transform: translateY(2px);
  }

  /* ---------- chu truot vao moi lan doi anh ----------
     Ho dat `class="animated slideInRight"` cho ca ba the trong caption: do
     duoc animation-name slideInRight, duration 1s, fill both, timing ease,
     delay 0s cho CA BA (ba dong vao cung luc).

     TA DUNG Web Animations API trong JS, KHONG dung @keyframes cong lop CSS.

     Da thu cach CSS truoc va HONG: bo lop roi doc offsetWidth roi gan lai lop
     de bat lai animation. Do duoc bang animationstart/animationend rang
     animation bat dau va ket thuc trong CUNG MOT mili giay, va the h1 bi ket
     o opacity 0 suot 2,25 giay moi vong - lau gap 2,8 lan thoi luong 0,8s da
     khai bao.

     WAAPI hon o ba diem, va do la ly do doi han sang no:
       1. `cancel()` xoa sach animation cu truoc khi chay cai moi - khong con
          canh hai animation chong nhau
       2. `fill: 'backwards'` chi giu trang thai DAU trong luc cho delay; chay
          xong la the tra ve style tu nhien cua no. Khong the nao ket o
          opacity 0 nhu `fill: both` cua CSS
       3. KHONG co luat CSS nao an chu di, nen JS hong thi chu VAN HIEN. Cach
          CSS thi `from { opacity: 0 }` cong `fill: both` co the de chu an
          vinh vien

     TA KHAC HO HAI CHO:
     1. LECH NHIP 70ms giua cac dong thay vi vao cung luc. Ba dong vao cung
        luc doc ra nhu mot khoi anh truot; lech nhip thi mat doc duoc thu tu
        nhan -> tieu de -> dong phu -> nut, dung thu tu can doc.
     2. DI 56px chu khong translateX(100%). 100% la 100% BE NGANG CUA CHINH
        THE: the h1 rong 900px thi no bay 900px vao, di qua ca man hinh. */

  /* ---------- mui ten: do nguyen van cua ho ----------
     VUNG BAM rong 15% va CAO HET banner chu khong phai chi vong tron 86px.
     Vung rong nhu vay thi khong phai nham, va no de trong o GIUA cho anh tho.
     `opacity: .5` moi la chi tiet lam no tinh te: mui ten lui ve sau, ro han
     len khi re. Truoc day ta de vong cam DAC 100% - no doc ra nang va tranh
     mat voi chinh anh. Day la dung cai user chi ra. */
  .bn__lai {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 15%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }
  .bn__lai:hover,
  .bn__lai:focus-visible {
    opacity: 0.9;
  }
  /* 56px - KHONG phai 86px.
     Ho khai bao `width: 3.5rem; border: 15px solid`. Truoc day ta cong
     56 + 15*2 = 86, nhung Bootstrap dat `box-sizing: border-box` toan cuc nen
     56px DA GOM CA VIEN: vong that la 56px, o noi dung ben trong con 26px va
     do la cho mui ten nam. Do lai bang getBoundingClientRect: 56 x 56.
     Day la cai user chi ra hai lan khi noi mui ten van con to. */
  .bn__vong {
    display: grid;
    place-items: center;
    /* 48px, nho hon 56px cua ho mot bac theo yeu cau. Anh cua ta la anh chup
       nha may day chi tiet nen mot vong cam 56px tranh mat voi chinh anh; anh
       cua ho la anh dan dung co mang trong. */
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cam-500);
  }
  .bn__lai svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--trang);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bn__lai--truoc {
    left: 0;
  }
  .bn__lai--sau {
    right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bn__ray {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    .bn {
      height: 460px;
    }
    /* Man hep thi 15% chi con ~60px, hep hon ca vong tron. Cho vung bam bang
       dung vong tron cong mot chut le. */
    .bn__lai {
      width: 76px;
    }
    .bn__vong {
      width: 44px;
      height: 44px;
    }
    .bn__lai svg {
      width: 20px;
      height: 20px;
    }
    /* Gradient doi tu NGANG sang DOC: o man hep, gradient ngang lam chu de len
       dung giua anh va khong con mang nhat nao de doc. */
    .bn__chu {
      align-items: flex-end;
      padding-bottom: var(--k6);
      background: linear-gradient(
        to bottom,
        rgba(2, 36, 91, 0.55) 0%,
        rgba(2, 36, 91, 0.88) 58%,
        rgba(2, 36, 91, 0.96) 100%
      );
    }
    .bn__dau {
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .bn {
      /* Co dinh, KHONG dung 100vh tren dien thoai: thanh dia chi an/hien lam
         100vh doi lien tuc va banner nhay giat khi cuon. */
      height: 430px;
    }
    .bn__nhan {
      font-size: var(--cs-nho);
      margin-bottom: var(--k2);
    }
    .bn__phu {
      display: none; /* het cho o 430px - giu tieu de va nut */
    }
    .bn__nut {
      margin-top: var(--k4);
    }
    .bn__n {
      padding: 12px 22px;
      font-size: var(--cs-nho);
    }
    .bn__lai {
      display: none; /* mui ten che mat anh tren man hep - de tu chay */
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.bn').forEach((bn) => {
    const ray = bn.querySelector<HTMLElement>('.bn__ray');
    if (!ray) return;
    const o = Array.from(ray.children) as HTMLElement[];
    const soThat = Number(bn.dataset.that) || o.length;
    const lap = bn.dataset.lap === '1';
    if (soThat < 2) return;

    const chuKy = (Number(bn.dataset.giay) || 5.5) * 1000;
    const itChuyenDong = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // i chay tren DOM (co ban sao)
    const dau = lap ? 1 : 0;
    let i = dau;
    let hen: number | undefined;

    const dongChu = bn.querySelectorAll<HTMLElement>(
      '.bn__nhan, .bn__dau, .bn__phu, .bn__nut',
    );
    const coWaapi = typeof Element.prototype.animate === 'function';

    /* Truot tung dong chu vao, lech nhip 70ms. Goi lai duoc bao nhieu lan
       cung duoc: cancel() don sach animation cu truoc khi chay cai moi. */
    const truotChu = () => {
      if (!coWaapi || itChuyenDong) return;
      dongChu.forEach((e, k) => {
        e.getAnimations?.().forEach((a) => a.cancel());
        e.animate(
          [
            { opacity: 0, transform: 'translateX(56px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 800, delay: k * 70, easing: 'ease', fill: 'backwards' },
        );
      });
    };

    const ve = () => {
      bn.style.setProperty('--i', String(i));
      o.forEach((e, k) => e.toggleAttribute('data-giua', k === i));
    };

    const den = (k: number) => {
      i = k;
      ve();
    };

    /* Chay toi ban sao thi doi hieu ung xong roi nhay khong hieu ung ve ban
       that. Doi bang transitionend chu khong bang setTimeout de khong lech
       nhip khi may cham hoac khi tab vua duoc mo lai. */
    if (lap) {
      ray.addEventListener('transitionend', (e) => {
        if (e.propertyName !== 'transform') return;
        let moi = i;
        if (i === o.length - 1) moi = dau;
        else if (i === 0) moi = o.length - 2;
        if (moi === i) return;
        ray.classList.add('bn__ray--nhay');
        den(moi);
        void ray.offsetWidth; // buoc trinh duyet ve lai truoc khi bat lai hieu ung
        ray.classList.remove('bn__ray--nhay');
      });
    }

    const tien = (h: number) => {
      const k = i + h;
      den(lap ? k : (k + soThat) % soThat);
      truotChu();
    };

    const dung = () => {
      if (hen) window.clearInterval(hen);
      hen = undefined;
    };
    const chay = () => {
      if (itChuyenDong) return;
      dung();
      hen = window.setInterval(() => tien(1), chuKy);
    };

    bn.querySelectorAll<HTMLButtonElement>('.bn__lai').forEach((n) =>
      n.addEventListener('click', () => {
        tien(Number(n.dataset.huong));
        chay();
      }),
    );

    bn.addEventListener('mouseenter', dung);
    bn.addEventListener('mouseleave', chay);
    bn.addEventListener('focusin', dung);
    bn.addEventListener('focusout', chay);
    document.addEventListener('visibilitychange', () => (document.hidden ? dung() : chay()));

    ve();
    /* KHONG goi truotChu() o day - chi chay khi DOI ANH.
       Neu chay ca luc tai trang thi the H1 bi an 870ms dau tien: xau cho LCP
       (H1 la mot trong nhung thu Google do thoi diem hien) va nguoi dung phai
       cho moi doc duoc dong quan trong nhat trang.
       Ho chay ca luc tai vi caption cua ho mang lop `animated slideInRight`
       tinh trong HTML - do la mot danh doi ho khong can nhac. */
    chay();
  });
</script>
