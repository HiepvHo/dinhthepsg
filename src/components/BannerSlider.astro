---
import { Image } from 'astro:assets';

/**
 * BANNER - do theo #header-carousel cua template Industro ngay 03/09/2026.
 *
 * SO DO HO (khung nhin 1440, do bang trinh duyet that):
 *   carousel cao 802px, MOT anh tran het be ngang (khong he lo hai ben)
 *   lop phu: linear-gradient(to right, rgb(2,36,91) 0%, rgba(2,36,91,0) 100%)
 *   nhan tren : 20px/600, letter-spacing normal, margin-bottom 16px
 *   tieu de   : 80px/700, line-height 96px (=1.2), margin-bottom 48px
 *   nut       : 16px/500, padding 16px 48px
 *   vung bam mui ten: rong 15% (214px), CAO HET banner, opacity .5 -> .9
 *   mui ten   : vong 56px (khong phai 86px - `box-sizing: border-box` nen
 *               `width: 3.5rem` DA GOM vien 15px)
 *   chu caption mang lop `animated slideInRight` - 1s, ease, ba dong cung luc
 *
 * MOI ANH MOT KHOI CHU RIENG, giong ho: caption nam TRONG tung slide nen no
 * truot cung anh. Nam khoi chu la nam goc noi dung khac nhau, moi khoi nham
 * mot y dinh tim kiem khac - do la be rong chu de cho Google chu khong phai
 * de trang trí.
 *
 * TA KHAC HO BA CHO, deu co ly do:
 *
 * 1. CHI MOT THE <h1> tren ca trang. Slide dau dung <h1>, cac slide sau va TAT
 *    CA ban sao dung <p class="bn__dau"> nhin y het. Ho de <h1> o CA HAI slide
 *    nen trang chu cua ho co hai H1 - loi SEO cua chinh template.
 *
 * 2. CHIEU CAO theo man hinh chu khong go cung 802px.
 *
 * 3. TIEU DE dung clamp() chu khong go 80px: chu tieng Viet co dau thanh chong
 *    nen cung mot px chiem cao hon chu Latin.
 *
 * LAP VONG: nhan ban slide cuoi dat len dau va slide dau dat xuong cuoi, chay
 * toi ban sao roi NHAY khong hieu ung ve ban that. Ban sao khong ton byte:
 * Astro sinh cung URL anh nen trinh duyet dung lai cache.
 *
 * Chieu cao co dinh de khong gay CLS.
 */
interface Nut {
  chu: string;
  duongDan: string;
  chinh?: boolean;
}
interface Anh {
  src: ImageMetadata;
  alt: string;
  nhan?: string;
  tieuDe?: string;
  phu?: string;
  nut?: Nut[];
}
interface Props {
  anh: Anh[];
  giay?: number;
}
const { anh, giay = 6 } = Astro.props;

/* [ban sao cuoi, ...that, ban sao dau] - chi khi co tu 2 anh tro len */
const lap = anh.length > 1;
const day = lap ? [anh[anh.length - 1], ...anh, anh[0]] : anh;
const dauThat = lap ? 1 : 0;
---

<div
  class="bn"
  data-giay={giay}
  data-that={anh.length}
  data-lap={lap ? '1' : '0'}
  style={`--i: ${dauThat}`}
  role="region"
  aria-roledescription="Băng ảnh"
  aria-label="Hình ảnh nhà máy Đinh Thép Sài Gòn"
>
  <div class="bn__ray">
    {
      day.map((a, i) => {
        const banSao = lap && (i === 0 || i === day.length - 1);
        /* Chi slide THAT dau tien moi mang H1. Cac slide sau va moi ban sao
           dung <p> nhin y het - mot trang chi duoc mot H1. */
        const laH1 = i === dauThat;
        return (
          <div
            class="bn__anh"
            data-giua={i === dauThat ? '' : undefined}
            aria-hidden={banSao ? 'true' : undefined}
            role={banSao ? undefined : 'group'}
            aria-roledescription={banSao ? undefined : 'Ảnh'}
            aria-label={banSao ? undefined : `${i - dauThat + 1} trên ${anh.length}`}
          >
            {/* Ban sao VAN GIU alt that. Truyen chuoi rong thi Astro bo han
                thuoc tinh alt ra khoi the img (da do duoc), va trinh doc man
                hinh se doc ten file thay cho mo ta. Trung lap khong thanh van
                de vi the bao ngoai da aria-hidden. */}
            <Image
              src={a.src}
              alt={a.alt}
              widths={[900, 1400, 1920]}
              sizes="100vw"
              loading={i <= dauThat + 1 ? 'eager' : 'lazy'}
              fetchpriority={i === dauThat ? 'high' : 'auto'}
            />

            {a.tieuDe && (
              <div class="bn__chu">
                <div class="khung">
                  {a.nhan && <p class="bn__nhan">{a.nhan}</p>}
                  {laH1 ? (
                    <h1 class="bn__dau">{a.tieuDe}</h1>
                  ) : (
                    <p class="bn__dau">{a.tieuDe}</p>
                  )}
                  {a.phu && <p class="bn__phu">{a.phu}</p>}
                  {a.nut && a.nut.length > 0 && (
                    <div class="bn__nut">
                      {a.nut.map((n) => (
                        <a
                          class={n.chinh ? 'bn__n bn__n--chinh' : 'bn__n'}
                          href={n.duongDan}
                          tabindex={banSao ? -1 : undefined}
                        >
                          {n.chu}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        );
      })
    }
  </div>

  {
    anh.length > 1 && (
      <Fragment>
        <button type="button" class="bn__lai bn__lai--truoc" data-huong="-1" aria-label="Ảnh trước">
          <span class="bn__vong" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m14.5 5-7 7 7 7" /></svg>
          </span>
        </button>
        <button type="button" class="bn__lai bn__lai--sau" data-huong="1" aria-label="Ảnh tiếp theo">
          <span class="bn__vong" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7" /></svg>
          </span>
        </button>
      </Fragment>
    )
  }
</div>

<style>
  .bn {
    --i: 0;
    position: relative;
    width: 100%;
    /* CAO HON ban truoc (760 -> 820 tran, va tru 180 thay vi 225).
       Ly do: khoi chu cua ta cao hon cua ho - ho chi co nhan, tieu de, nut;
       ta co them mot dong phu. Cung mot chieu cao banner thi phan anh con
       thay duoc it hon han, doc ra nhu anh bi bop.
       DANH DOI: o man 900px, dai ly do ngay duoi khong con nam gon trong man
       hinh dau nua, chi lo ra mot vach ~24px.
       Tru 145px chu khong 180px: o 180px thi dai ly do lo 60px, va 60px la
       cat DUNG GIUA dong chu thu hai - doc ra nhu trang bi loi. 24px thi chi
       lo mep tren cua dai, ro rang la tin hieu "con noi dung ben duoi". */
    height: clamp(460px, calc(100vh - 145px), 820px);
    overflow: hidden;
    background: var(--navy-900);
  }

  .bn__ray {
    display: flex;
    height: 100%;
    transform: translateX(calc(-100% * var(--i)));
    transition: transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }
  .bn__ray--nhay {
    transition: none;
  }

  .bn__anh {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }
  .bn__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- khoi chu ----------
     Lop phu CHINH LA nen cua khoi chu: gradient navy dac ben trai nhat dan
     sang phai - do nguyen van cua ho.
     Ta keo diem tat ve 85% chu khong 100%, va giu mot lop mo o giua: anh cua
     ta la anh CHUP nha may day chi tiet khap khung, con anh cua ho la anh dan
     dung co san mot mang toi ben trai. */
  .bn__chu {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    background: linear-gradient(
      to right,
      rgba(2, 36, 91, 0.94) 0%,
      rgba(2, 36, 91, 0.72) 42%,
      rgba(2, 36, 91, 0) 85%
    );
    /* De lot chuot xuong duoi cho bam duoc mui ten; rieng nut thi nhan lai */
    pointer-events: none;
  }
  .bn__chu :global(a) {
    pointer-events: auto;
  }

  /* Ho: 20px/600, mau cam, margin-bottom 16px, letter-spacing NORMAL.
     Tren nen navy cam-500 duoc 4,88:1 - dat AA. */
  .bn__nhan {
    /* 8px chu khong 16px cua ho: nhan va tieu de la MOT cum y nghia, de sat
       nhau thi doc ra la mot khoi chu khong phai hai dong roi. */
    margin-bottom: var(--k2);
    font-family: var(--font-hien);
    font-size: 20px;
    font-weight: var(--w-vua);
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--cam-500);
  }
  /* Ho: 80px/700, line-height 1.2. Ta 72px vi chu tieng Viet co dau thanh
     chong nen o cung mot px no chiem cao hon chu Latin.
     TY LE tieu de / nhan = 3,6 lan (ho 4,00) - van du dut khoat. */
  .bn__dau {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-hien);
    font-size: clamp(32px, 5vw, 72px);
    font-weight: var(--w-dam);
    line-height: 1.18;
    letter-spacing: var(--gc-display);
    text-wrap: balance;
    color: var(--trang);
  }
  .bn__phu {
    max-width: 50ch;
    margin-top: var(--k4);
    font-size: var(--cs-than);
    line-height: 1.6;
    color: #c9d6ea; /* trang nga tren navy - 9,4:1 */
  }

  /* 48px = margin-bottom cua the h1 ben ho. Khe rong nay la mot phan lam
     caption cua ho doc ra thoang: tieu de rat lon roi mot khoang trong han
     truoc mot cai nut. */
  .bn__nut {
    display: flex;
    flex-wrap: wrap;
    gap: var(--k3);
    margin-top: var(--k7);
  }
  /* Ho: padding 16px 48px, 16px/500, VUONG GOC.
     Ta de 19px IN DAM chu khong 16px/500 cua ho, va day la mot rang buoc ky
     thuat chu khong phai so thich: nut chinh phai mang mau cam-500 song, ma
     chu trang tren cam-500 chi duoc 3,06:1. WCAG tinh chu tu 18,66px IN DAM
     tro len la chu LON, nguong ha con 3:1 - luc do 3,06:1 moi dat. */
  .bn__n {
    display: inline-flex;
    align-items: center;
    padding: 15px 34px;
    font-family: var(--font-hien);
    font-size: 19px;
    font-weight: var(--w-dam);
    text-decoration: none;
    border: 2px solid var(--trang);
    color: var(--trang);
    transition:
      background var(--thoi) var(--nhip),
      border-color var(--thoi) var(--nhip),
      transform var(--thoi) var(--nhip),
      box-shadow var(--thoi) var(--nhip);
  }
  .bn__n:hover {
    background: rgba(255, 255, 255, 0.16);
    color: var(--trang);
    transform: translateY(1px);
  }
  /* cam-500 song - dung mau cua ho. Dat duoc nho chu 19px in dam o tren. */
  .bn__n--chinh {
    background: var(--cam-500);
    border-color: var(--cam-500);
  }
  /* An xuong khi re, giong nut o header - khong nhich len */
  .bn__n--chinh:hover {
    background: var(--cam-600);
    border-color: var(--cam-600);
    transform: translateY(1px);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.22);
  }
  .bn__n:active,
  .bn__n--chinh:active {
    transform: translateY(2px);
  }

  /* ---------- chu truot vao moi lan doi anh ----------
     Ho dat `class="animated slideInRight"` cho ca ba the trong caption: do
     duoc animation-name slideInRight, duration 1s, fill both, timing ease,
     delay 0s cho CA BA (ba dong vao cung luc).

     TA DUNG Web Animations API trong JS, KHONG dung @keyframes cong lop CSS.
     Da thu cach CSS truoc va hong: do duoc animation bat dau va ket thuc
     trong CUNG MOT mili giay, va the h1 bi ket o opacity 0 suot 2,25 giay.
     WAAPI hon o ba diem:
       1. `cancel()` xoa sach animation cu truoc khi chay cai moi
       2. `fill: 'backwards'` chi giu trang thai DAU trong luc cho delay; chay
          xong la the tra ve style tu nhien. Khong the ket o opacity 0 nhu
          `fill: both` cua CSS
       3. KHONG co luat CSS nao an chu di, nen JS hong thi chu VAN HIEN

     TA KHAC HO HAI CHO:
     1. LECH NHIP 70ms giua cac dong thay vi vao cung luc - mat doc duoc thu
        tu nhan -> tieu de -> dong phu -> nut, dung thu tu can doc.
     2. DI 56px chu khong translateX(100%). 100% la 100% BE NGANG CUA CHINH
        THE: the h1 rong 900px thi no bay 900px vao, di qua ca man hinh. */

  /* ---------- mui ten: do nguyen van cua ho ----------
     VUNG BAM rong 15% va CAO HET banner chu khong phai chi vong tron.
     Vung rong nhu vay thi khong phai nham, va no de trong o GIUA cho anh tho.
     `opacity: .5` moi la chi tiet lam no tinh te: mui ten lui ve sau, ro han
     len khi re. */
  .bn__lai {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 15%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }
  .bn__lai:hover,
  .bn__lai:focus-visible {
    opacity: 0.9;
  }
  .bn__vong {
    display: grid;
    place-items: center;
    /* 48px, nho hon 56px cua ho mot bac. Anh cua ta la anh chup nha may day
       chi tiet nen mot vong cam to tranh mat voi chinh anh. */
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cam-500);
  }
  .bn__lai svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--trang);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bn__lai--truoc {
    left: 0;
  }
  .bn__lai--sau {
    right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bn__ray {
      transition: none;
    }
  }

  @media (max-width: 980px) {
    .bn {
      height: 500px;
    }
    /* Man hep thi 15% chi con ~60px, hep hon ca vong tron. */
    .bn__lai {
      width: 76px;
    }
    .bn__vong {
      width: 44px;
      height: 44px;
    }
    .bn__lai svg {
      width: 20px;
      height: 20px;
    }
    /* Gradient doi tu NGANG sang DOC: o man hep, gradient ngang lam chu de len
       dung giua anh va khong con mang nhat nao de doc. */
    .bn__chu {
      align-items: flex-end;
      padding-bottom: var(--k6);
      background: linear-gradient(
        to bottom,
        rgba(2, 36, 91, 0.55) 0%,
        rgba(2, 36, 91, 0.88) 58%,
        rgba(2, 36, 91, 0.96) 100%
      );
    }
    .bn__dau {
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .bn {
      /* Co dinh, KHONG dung 100vh tren dien thoai: thanh dia chi an/hien lam
         100vh doi lien tuc va banner nhay giat khi cuon. */
      height: 450px;
    }
    .bn__nhan {
      font-size: var(--cs-nho);
      margin-bottom: var(--k1);
    }
    .bn__phu {
      display: none; /* het cho o 450px - giu tieu de va nut */
    }
    .bn__nut {
      margin-top: var(--k4);
    }
    .bn__n {
      padding: 12px 22px;
      font-size: var(--cs-nho);
    }
    .bn__lai {
      display: none; /* mui ten che mat anh tren man hep - de tu chay */
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.bn').forEach((bn) => {
    const ray = bn.querySelector<HTMLElement>('.bn__ray');
    if (!ray) return;
    const o = Array.from(ray.children) as HTMLElement[];
    const soThat = Number(bn.dataset.that) || o.length;
    const lap = bn.dataset.lap === '1';
    if (soThat < 2) return;

    const chuKy = (Number(bn.dataset.giay) || 6) * 1000;
    const itChuyenDong = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coWaapi = typeof Element.prototype.animate === 'function';

    // i chay tren DOM (co ban sao)
    const dau = lap ? 1 : 0;
    let i = dau;
    let hen: number | undefined;

    /* Truot tung dong chu CUA SLIDE DANG HIEN vao, lech nhip 70ms.
       Goi lai duoc bao nhieu lan cung duoc: cancel() don sach animation cu. */
    const truotChu = (k: number) => {
      if (!coWaapi || itChuyenDong) return;
      const slide = o[k];
      if (!slide) return;
      slide
        .querySelectorAll<HTMLElement>('.bn__nhan, .bn__dau, .bn__phu, .bn__nut')
        .forEach((e, vt) => {
          e.getAnimations?.().forEach((a) => a.cancel());
          e.animate(
            [
              { opacity: 0, transform: 'translateX(56px)' },
              { opacity: 1, transform: 'none' },
            ],
            { duration: 800, delay: vt * 70, easing: 'ease', fill: 'backwards' },
          );
        });
    };

    const ve = () => {
      bn.style.setProperty('--i', String(i));
      o.forEach((e, k) => e.toggleAttribute('data-giua', k === i));
    };

    const den = (k: number) => {
      i = k;
      ve();
    };

    /* Chay toi ban sao thi doi hieu ung xong roi nhay khong hieu ung ve ban
       that. Doi bang transitionend chu khong bang setTimeout de khong lech
       nhip khi may cham hoac khi tab vua duoc mo lai. */
    if (lap) {
      ray.addEventListener('transitionend', (e) => {
        if (e.propertyName !== 'transform') return;
        let moi = i;
        if (i === o.length - 1) moi = dau;
        else if (i === 0) moi = o.length - 2;
        if (moi === i) return;
        ray.classList.add('bn__ray--nhay');
        den(moi);
        void ray.offsetWidth; // buoc trinh duyet ve lai truoc khi bat lai hieu ung
        ray.classList.remove('bn__ray--nhay');
      });
    }

    const tien = (h: number) => {
      const k = i + h;
      den(lap ? k : (k + soThat) % soThat);
      truotChu(i);
    };

    const dung = () => {
      if (hen) window.clearInterval(hen);
      hen = undefined;
    };
    const chay = () => {
      if (itChuyenDong) return;
      dung();
      hen = window.setInterval(() => tien(1), chuKy);
    };

    bn.querySelectorAll<HTMLButtonElement>('.bn__lai').forEach((n) =>
      n.addEventListener('click', () => {
        tien(Number(n.dataset.huong));
        chay();
      }),
    );

    /* ---- QUET NGANG tren dien thoai ----
       Duoi 560px mui ten bi an (no che mat anh o man hep), nen truoc day
       nguoi dung mobile KHONG CO cach nao chuyen anh - phai cho 6 giay mot
       tam, nam tam la 30 giay moi xem het.

       KHONG goi preventDefault va dat `passive: true`: chan su kien cham se
       chan luon cuon doc: nguoi dung keo len xuong trong vung banner se thay
       trang dung im.
       Chi tinh la quet khi di ngang HON 40px VA di ngang nhieu hon di doc -
       khong co dieu kien thu hai thi moi lan cuon doc qua banner deu bi hieu
       nham thanh quet. */
    let chamX = 0;
    let chamY = 0;
    bn.addEventListener(
      'touchstart',
      (e) => {
        chamX = e.changedTouches[0].clientX;
        chamY = e.changedTouches[0].clientY;
        dung();
      },
      { passive: true },
    );
    bn.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - chamX;
        const dy = e.changedTouches[0].clientY - chamY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) tien(dx < 0 ? 1 : -1);
        chay();
      },
      { passive: true },
    );

    bn.addEventListener('mouseenter', dung);
    bn.addEventListener('mouseleave', chay);
    bn.addEventListener('focusin', dung);
    bn.addEventListener('focusout', chay);
    document.addEventListener('visibilitychange', () => (document.hidden ? dung() : chay()));

    ve();
    /* KHONG goi truotChu() o day - chi chay khi DOI ANH.
       Neu chay ca luc tai trang thi the H1 bi an 870ms dau tien: xau cho LCP
       (H1 la mot trong nhung thu Google do thoi diem hien) va nguoi dung phai
       cho moi doc duoc dong quan trong nhat trang. */
    chay();
  });
</script>
