---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import anhDauMuc from '../../assets/anh/dinh-tren-nen-trang-01.jpg';
import DauMuc from '../../components/DauMuc.astro';
import CotDanhMuc from '../../components/CotDanhMuc.astro';
import { tuyetDoi } from '../../lib/schema';
import { anhCuaNhom } from '../../lib/anh-nhom';
import { catTieuDe, catMoTa } from '../../lib/seo-text';

/**
 * TRANG DANH MUC SAN PHAM.
 *
 * Do thegioithepvn.com/thep-xay-dung/ ngay 02/09/2026 (khung nhin 1425):
 *   cot ben  x=158 rong 255   |  luoi san pham x=433 rong 844
 *   the 211x343, ANH VUONG 192x192, thu tu: anh - ten - sao - khoang gia
 *   phia tren luoi: 4 doan gioi thieu, dong "Showing all 10 results" + o sap xep
 *
 * TA KHAC HO BON CHO:
 *
 * 1. LUOI 3 COT chu khong 4. Ho co 10 san pham chi mang ten thuong hieu
 *    ("Thep thanh van Pomina"); the cua ta con mang mo ta va ten goi khac nen
 *    can be ngang. 6 nhom chia 3 cot ra dung hai hang.
 *
 * 2. KHONG CO SAO DANH GIA. Chua co danh gia that nao - bia sao la vi pham
 *    chinh sach fake review.
 *
 * 3. KHONG CO O SAP XEP. Sap xep 6 muc la mot dieu khien khong giai quyet van de
 *    gi; no chi co ich khi danh sach dai qua mot man hinh.
 *
 * 4. GIU DOAN GIOI THIEU O TREN LUOI. Day la cho ho lam DUNG ma nhieu trang
 *    danh muc bo qua: bon doan van truoc luoi la thu duy nhat lam trang nay khac
 *    mot trang ket qua loc, va la thu Google doc duoc.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;
const nhom = await getCollection('nhomSanPham');
const tong = nhom.reduce((t, n) => t + n.data.quyCach.length, 0);
const soNam = new Date().getFullYear() - c.namThanhLap;

const tieuDe = catTieuDe('Sản phẩm đinh và vật tư liên kết - Đinh Thép SG');
const moTa = catMoTa(
  `${nhom.length} nhóm, ${tong} quy cách: đinh chì, đinh thép trắng, đinh thép vàng, đinh dù, đinh vít, dây kẽm hấp. Nhà máy sản xuất trực tiếp, gọi ${c.hotline}.`,
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sản phẩm đinh và vật tư liên kết',
  numberOfItems: nhom.length,
  itemListElement: nhom.map((n, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: n.data.ten,
    url: tuyetDoi(`/san-pham/${n.data.slug}/`),
  })),
};
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/san-pham/" schema={schema}>
  <DauMuc
    nhan="Sản phẩm"
    tieuDe="Đinh và vật tư liên kết do nhà máy sản xuất"
    muc={[{ ten: 'Sản phẩm', duongDan: '/san-pham/' }]}
    anh={{ src: anhDauMuc, alt: 'Đinh thép do nhà máy Đinh Thép Sài Gòn sản xuất' }}
  />

  <div class="section nang-chu">
    <div class="khung dm">
      <CotDanhMuc />

      <div class="dm__chinh">

        <div class="dm__mo">
          <p>
            <strong>{c.tenPhapDinhHoa}</strong> sản xuất trực tiếp {tong} quy cách đinh và vật
            tư liên kết tại nhà máy {c.diaDiem[0].quanHuyen}, {c.diaDiem[0].tinhThanh}. Hàng
            bán ra là hàng chúng tôi làm ra, không nhập lại của đơn vị khác.
          </p>
          <p>
            {nhom.length} nhóm gồm: đinh chì thân trơn dùng đóng cốp pha và đóng gỗ, đinh thép
            trắng và đinh thép vàng khác nhau ở xử lý bề mặt, đinh dù mũ rộng dùng lợp tôn,
            đinh vít bắt bằng máy, và dây kẽm hấp dùng buộc thép.
          </p>
          <p>
            Mã quy cách trên bao bì ghi theo <strong>phân</strong>. Trong ngành,
            1 phân = 1cm = 10mm, nên mỗi trang sản phẩm đều quy đổi sẵn cả bốn cách gọi -
            khách hỏi "đinh 5p", "đinh 5 phân", "đinh 5cm" hay "đinh 50mm" đều ra cùng một mã.
          </p>
          <p>
            Đặt hàng gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>. Nhận đơn số lượng lớn
            và quy cách riêng, nhà máy chạy theo đơn. Giao tận công trình khu vực TP.HCM,
            Long An và các tỉnh lân cận. Pháp nhân rõ ràng, MST {c.maSoThue}, thành lập
            {' '}{c.namThanhLap} - {soNam} năm trong ngành vật tư kim khí.
          </p>
        </div>

        <p class="dm__dem">
          {nhom.length} nhóm sản phẩm, tổng {tong} quy cách
        </p>

        {/* Dung DUNG the lat cua trang chu chu khong mot kieu the rieng.
            Truoc day trang nay co `.the-sp2` - the vien phang - trong khi
            trang chu co the lat. Hai kieu the cho cung mot san pham la hai
            ngon ngu, va nguoi dung di tu trang chu sang day thay san pham
            "khac di". Luat cua the lat nam trong industro.css nen dung lai
            khong ton them dong CSS nao. */}
        <div class="dm__luoi">
          {
            nhom.map((n) => {
              const a = anhCuaNhom(n.id);
              return (
                <a class="the-lat" href={`/san-pham/${n.data.slug}/`}>
                  <span class="the-lat__nen" aria-hidden="true">
                    <Image
                      src={a.src}
                      alt={a.alt}
                      widths={[420, 840]}
                      sizes="(max-width: 900px) 46vw, 400px"
                      loading="lazy"
                    />
                  </span>
                  <span class="the-lat__huy" aria-hidden="true">
                    <Image src={a.src} alt={a.alt} widths={[130, 260]} sizes="106px" loading="lazy" />
                  </span>
                  <span class="the-lat__khung">
                    <span class="the-lat__dau">
                      <span class="the-lat__ke" aria-hidden="true"></span>
                      <span class="the-lat__ten">{n.data.ten}</span>
                      <span class="the-lat__so">{n.data.quyCach.length} quy cách</span>
                    </span>
                    <span class="the-lat__mo">{n.data.moTaNgan}</span>
                  </span>
                  <span class="the-lat__nut">Xem quy cách</span>
                </a>
              );
            })
          }
        </div>

        <p class="dm__them">
          Xem toàn bộ thông số trong một bảng duy nhất:
          {' '}<a href="/bang-gia-dinh-thep/">bảng quy cách đầy đủ</a>. Cần tra quy đổi phân
          sang cm và mm: <a href="/bang-tra-quy-cach-dinh/">bảng tra quy cách</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Ho: 255 cot ben + 844 noi dung. Khung ta 1140 -> 255 + 32 + 853. */
  .dm {
    display: grid;
    grid-template-columns: 255px 1fr;
    gap: var(--k6);
    align-items: start;
  }
  .dm > * {
    min-width: 0;
  }

  .dm__mo {
    display: grid;
    gap: var(--k3);
    max-width: var(--do-doc);
    margin-top: var(--k4);
    color: var(--muc-2);
  }
  .dm__mo strong {
    color: var(--muc);
  }

  /* Dong dem - vi tri cua "Showing all 10 results" ben ho */
  .dm__dem {
    margin-top: var(--k6);
    padding-bottom: var(--k3);
    border-bottom: 2px solid var(--cam-500);
    font-size: var(--cs-nho);
    font-weight: var(--w-dam);
    text-transform: uppercase;
    letter-spacing: var(--gc-micro);
  }

  /* HAI cot chu khong ba. Cot noi dung o day chi 853px (con lai la cot
     danh muc ben trai), chia ba ra 264px moi the - ma o vuong nho len cua the
     lat rong 130px, tuc chiem nua be ngang the va cum lai. Chia hai duoc
     410px, gan bang 347px cua trang chu.
     Khe hang rong hon khe cot: 65px anh nho len an vao hang tren. */
  .dm__luoi {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: var(--k5);
  }
  .the-lat__ke {
    display: block;
    width: 25%;
    height: 1px;
    background: var(--vien-dam);
  }
  .the-lat__ten {
    font-family: var(--font-hien);
    font-size: var(--cs-h3);
    font-weight: var(--w-dam);
    line-height: var(--dc-vua);
    color: var(--muc);
  }
  .the-lat__so {
    font-size: var(--cs-micro);
    font-weight: var(--w-vua);
    color: var(--muc-2);
  }

  .dm__them {
    margin-top: var(--k7);
    padding-top: var(--k5);
    border-top: var(--vien-mong);
    font-size: var(--cs-nho);
    color: var(--muc-2);
  }

  @media (max-width: 900px) {
    .dm {
      grid-template-columns: 1fr;
      gap: var(--k6);
    }
    /* Cot ben xuong DUOI luoi tren mobile: no la phu tro, khong dang chiem
       man hinh dau tien. */
    .dm > :global(.cot-dm) {
      order: 2;
    }
    .dm__luoi {
      grid-template-columns: 1fr;
    }
  }
</style>
