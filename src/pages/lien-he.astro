---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import anhDauMuc from '../assets/anh/cong-nhan-thep-cuong-phat.jpg';
import DauMuc from '../components/DauMuc.astro';
import JsonLd from '../components/JsonLd.astro';
import { schemaDiaDiem } from '../lib/schema';
import { catTieuDe, catMoTa } from '../lib/seo-text';

/**
 * Trang lien he.
 *
 * LocalBusiness schema CHI cho 2 dia diem lien quan den dinh (nha may Long An
 * va van phong chinh Quan 5). Bon xuong can tole van liet ke de the hien quy mo
 * nhung KHONG dua vao schema - chung khong ban dinh, dua vao chi lam nhieu
 * tin hieu dia phuong.
 *
 * NAP o day phai giong HET footer va Google Business Profile.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;
const dinh = c.diaDiem.filter((d) => d.lienQuanDenDinh);
const khac = c.diaDiem.filter((d) => !d.lienQuanDenDinh);

function diaChiDayDu(d: (typeof c.diaDiem)[number]) {
  return [d.diaChi, d.phuong, d.quanHuyen, d.tinhThanh].filter(Boolean).join(', ');
}
function telHref(s: string) {
  return 'tel:' + s.replace(/[^0-9+]/g, '');
}

const tieuDe = catTieuDe('Liên hệ mua đinh thép - Đinh Thép Sài Gòn');
const moTa = catMoTa(`Mua đinh thép trực tiếp từ nhà máy: hotline ${c.hotline}, Zalo, hoặc đến nhà máy ${dinh[0].quanHuyen}, ${dinh[0].tinhThanh}. MST ${c.maSoThue}.`);

/**
 * DIA CHI cho bang do - lay TRU SO (toa nha Thong Tan Xa, Quan 5) chu khong
 * lay nha may.
 *
 * VI SAO: da thu dia chi nha may "Lo so 2, CCN Lien Minh, Binh Tien 2, Duc
 * Hoa, Long An" va Google GIAI MA SAI - no cam ghim o An Suong / Quan 12,
 * cach that hon 30km. Mot ban do chi sai cho con te hon khong co ban do.
 * Google khong co du lieu so lo trong cum cong nghiep; toa nha Thong Tan Xa
 * la dia chi MOC nen giai ma dung.
 *
 * Tim theo `vaiTro` chu khong theo chi so trong mang: doi thu tu trong
 * cong-ty.yaml thi ban do van tro dung cho.
 *
 * Dung `maps.google.com/maps?q=...&output=embed`: cach nay KHONG can API key.
 * Cach kia (Maps Embed API) can key, ma key nhung tren HTML tinh thi ai cung
 * doc duoc va dung het quota cua minh.
 */
const truSo = c.diaDiem.find((d) => d.vaiTro.includes('Trụ sở')) ?? dinh[0];
const diaChiMap = diaChiDayDu(truSo);

/**
 * UU TIEN `banDoNhung` trong cong-ty.yaml - URL lay tu Maps (Chia se -> Nhung
 * ban do). Chi URL do moi ve ra GHIM DO va O DIA CHI o goc, vi no chua place
 * ID va toa do Maps da giai san.
 * Chua co thi quay ve dang `?q=<dia chi>`: hien dung khu vuc Quan 5 nhung
 * khong co ghim - da do bon dang truy van va khong dang nao ra ghim.
 */
const nhungMapUrl =
  c.banDoNhung ?? `https://maps.google.com/maps?q=${encodeURIComponent(diaChiMap)}&z=15&output=embed`;
const nhungMap = `https://maps.google.com/maps?q=${encodeURIComponent(diaChiMap)}&z=15&output=embed`;

---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/lien-he/">
  {dinh.map((d) => <JsonLd schema={schemaDiaDiem(c, d)} />)}

  <DauMuc
    nhan="Liên hệ"
    tieuDe="Liên hệ mua đinh thép"
    mo="Cách nhanh nhất là gọi hotline nhà máy hoặc nhắn Zalo. Cho biết loại đinh, quy cách theo phân hoặc mm, và số lượng theo kg hoặc bao - đội ngũ báo giá trong ngày."
    muc={[{ ten: 'Liên hệ', duongDan: '/lien-he/' }]}
    anh={{ src: anhDauMuc, alt: 'Công nhân mặc đồng phục Thép Cường Phát tại xưởng đinh' }}
  />

  <article class="section nang-chu lh">
    <div class="khung">

      <div class="lh__nhanh">
        <a class="nut nut--chinh nut--lon" href={`tel:${c.hotlineTel}`}>
          Gọi {c.hotline}
        </a>
        <a class="nut nut--vien nut--lon" href={`https://zalo.me/${c.zalo}`} rel="noopener">
          Nhắn Zalo {c.hotline}
        </a>
        <a class="nut nut--vien nut--lon" href={`mailto:${c.email}`}>
          Gửi email
        </a>
      </div>

      <h2 id="mua-dinh">Nơi liên hệ mua đinh</h2>
      <div class="luoi luoi--2 lh__luoi">
        {
          dinh.map((d) => (
            <div class="the the--noi lh__the">
              <span class="huy-hieu">{d.vaiTro}</span>
              <h3>{d.ten}</h3>
              <dl class="dac-ta">
                <div class="dac-ta__hang">
                  <dt>Địa chỉ</dt>
                  <dd>{diaChiDayDu(d)}</dd>
                </div>
                {d.hotline && (
                  <div class="dac-ta__hang">
                    <dt>Hotline</dt>
                    <dd><a href={telHref(d.hotline)}>{d.hotline}</a></dd>
                  </div>
                )}
                {d.dienThoai && (
                  <div class="dac-ta__hang">
                    <dt>Điện thoại</dt>
                    <dd>{d.dienThoai}</dd>
                  </div>
                )}
                {d.fax && (
                  <div class="dac-ta__hang">
                    <dt>Fax</dt>
                    <dd>{d.fax}</dd>
                  </div>
                )}
              </dl>
            </div>
          ))
        }
      </div>

      <h2 id="phap-nhan">Thông tin pháp nhân</h2>
      <dl class="dac-ta lh__phap-nhan">
        <div class="dac-ta__hang">
          <dt>Tên công ty</dt>
          <dd>{c.tenPhapDinhHoa}</dd>
        </div>
        <div class="dac-ta__hang">
          <dt>Mã số thuế</dt>
          <dd class="so">{c.maSoThue}</dd>
        </div>
        <div class="dac-ta__hang">
          <dt>Năm thành lập</dt>
          <dd class="so">{c.namThanhLap}</dd>
        </div>
        <div class="dac-ta__hang">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${c.email}`}>{c.email}</a>
            {' | '}
            <a href={`mailto:${c.emailPhu}`}>{c.emailPhu}</a>
          </dd>
        </div>
        <div class="dac-ta__hang">
          <dt>Website công ty</dt>
          <dd><a href={c.websiteMe} rel="noopener">cuongphatsteel.com.vn</a></dd>
        </div>
      </dl>

      <h2 id="he-thong">Hệ thống {c.diaDiem.length} địa điểm</h2>
      <p class="lh__dan">
        Ngoài nhà máy đinh, công ty còn có các xưởng cán tole và kho vật tư kim khí.
        Các địa điểm này không bán đinh, liệt kê ở đây để bạn biết quy mô hệ thống.
      </p>
      <div class="bang-cuon">
        {/* `bang--xep`: duoi 620px bang nay XEP THANH THE thay vi cuon ngang.
            Ly do do duoc: cot "Dia chi" la van dai nen o `min-width: max-content`
            bang phinh len 1554px = 4 lan khung nhin 390px, con o be ngang co
            dinh thi cot dia chi bi bop va HANG CAO 285px voi phan lon la
            khoang trong. `data-nhan` cap nhan cot cho tung o khi da xep. */}
        <table class="bang bang--xep">
          <caption>Hệ thống địa điểm {c.tenPhapDinh}</caption>
          <thead>
            <tr>
              <th scope="col">Địa điểm</th>
              <th scope="col">Chức năng</th>
              <th scope="col">Địa chỉ</th>
              <th scope="col">Điện thoại</th>
            </tr>
          </thead>
          <tbody>
            {
              [...dinh, ...khac].map((d) => (
                <tr>
                  <td data-nhan="Địa điểm">{d.ten}</td>
                  <td data-nhan="Chức năng">{d.vaiTro}</td>
                  <td data-nhan="Địa chỉ">{diaChiDayDu(d)}</td>
                  <td data-nhan="Điện thoại">
                    {d.hotline ? (
                      <a href={telHref(d.hotline)}>{d.hotline}</a>
                    ) : (
                      d.dienThoai ?? '-'
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    <h2 id="ban-do">Đường tới trụ sở</h2>
      <p class="lh__dan">{diaChiMap}</p>
      {/* IFRAME NGOAI DUY NHAT tren ca site, va no nam o CUOI trang.
          Vi tri cuoi trang khong phai tinh co: `loading="lazy"` chi hoan duoc
          khi the o XA khung nhin. Da do o vi tri giua trang (y=1303) va lazy
          KHONG hoan duoc - Chrome nap truoc moi thu trong khoang ~1250px, ket
          qua 43 request toi 5 ten mien Google cho moi nguoi mo trang. Dat o
          cuoi thi khoang cach du xa de lazy thuc su co tac dung. */}
      <div class="lh__map">
        <iframe
          src={nhungMapUrl}
          title={`Bản đồ tới ${truSo.ten}, ${diaChiMap}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <p class="lh__map-link">
        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(diaChiMap)}`}
          rel="noopener"
        >
          Mở chỉ đường trong Google Maps
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .lh h1 {
    font-size: var(--cs-h1);
  }
  .lh__mo {
    margin-top: var(--k4);
  }
  .lh__nhanh {
    display: flex;
    gap: var(--k3);
    flex-wrap: wrap;
    margin-top: var(--k6);
  }
  .lh h2 {
    margin-top: var(--k8);
    margin-bottom: var(--k4);
    scroll-margin-top: var(--neo-le);
  }
  .lh__the {
    display: grid;
    gap: var(--k3);
    align-content: start;
  }
  .lh__phap-nhan {
    max-width: 640px;
  }
  .lh__dan {
    margin-bottom: var(--k4);
    font-size: var(--cs-nho);
    color: var(--muc-2);
    max-width: var(--do-doc);
  }

  /* Khung ban do. Ti le 16/9 dat san de trang khong nhay khi iframe tai xong -
     iframe khong co kich thuoc noi tai nen thieu ti le la CLS. */
  .lh__map {
    position: relative;
    margin-top: var(--k5);
    aspect-ratio: 16 / 9;
    max-width: 900px;
    overflow: hidden;
    background: var(--nen-nhat);
    border: var(--vien-mong);
  }
  .lh__map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .lh__map-link {
    margin-top: var(--k3);
    font-size: var(--cs-nho);
  }

  @media (max-width: 560px) {
    /* 16/9 o 350px chi con cao 197px - qua thap de doc duong. Doi sang 4/3. */
    .lh__map {
      aspect-ratio: 4 / 3;
    }
  }
</style>

