---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VunBanh from '../../components/VunBanh.astro';
import { catTieuDe, catMoTa } from '../../lib/seo-text';

/**
 * Index bai viet - Outer Section trong topical map.
 *
 * Hien tai chua co bai nao. Trang van ton tai va van huu ich vi no dan sang
 * cac trang tra cuu da co. KHONG de trang rong khong noi dung - trang rong
 * bi Google coi la thin content.
 *
 * Cac cum thuoc tinh lay tu TOPICAL-MAP.md. Khi co bai, bai tu xep vao cum
 * theo truong `cum` trong frontmatter.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;

const bai = (await getCollection('baiViet', ({ data }) => !data.nhap)).sort(
  (a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf(),
);

const cumTen: Record<string, string> = {
  'A-dinh-danh': 'Định danh và phân loại',
  'B-quy-cach': 'Quy cách và quy đổi',
  'C-khoi-luong': 'Khối lượng và số lượng',
  'D-vat-lieu': 'Vật liệu và xử lý bề mặt',
  'E-ung-dung': 'Ứng dụng theo công việc',
  'F-chon-dung': 'Chọn đúng và lỗi thường gặp',
  'G-san-xuat': 'Sản xuất',
  'H-so-sanh': 'So sánh',
};

const theoNhom = Object.keys(cumTen).map((k) => ({
  key: k,
  ten: cumTen[k],
  bai: bai.filter((b) => b.data.cum === k),
}));

const tieuDe = catTieuDe('Kiến thức về đinh thép xây dựng - Đinh Thép SG');
const moTa = catMoTa('Hướng dẫn chọn và dùng đinh thép xây dựng: quy cách, quy đổi phân sang mm, khối lượng, vật liệu và ứng dụng. Viết bởi nhà máy sản xuất.');
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/kien-thuc/">
  <VunBanh muc={[{ ten: 'Kiến thức', duongDan: '/kien-thuc/' }]} />

  <article class="section kt">
    <div class="khung kt__trong">
      <h1>Kiến thức về đinh thép</h1>
      <p class="dan-nhap kt__mo">
        Nội dung do nhà máy sản xuất viết, dựa trên thông số của chính hàng chúng tôi
        làm ra chứ không chép lại từ nơi khác.
      </p>

      {
        bai.length === 0 ? (
          <div class="kt__chua-co">
            <h2>Đang biên soạn</h2>
            <p>
              Các bài viết đang được biên soạn và đối chiếu số liệu với nhà máy trước khi
              đăng. Trong lúc chờ, hai trang tra cứu dưới đây đã có đầy đủ thông số:
            </p>
            <ul class="kt__ds-tam">
              <li>
                <a href="/bang-tra-quy-cach-dinh/">Bảng tra quy cách đinh: phân, cm và mm</a>
                <span>Quy đổi đầy đủ từ 1 đến 15 phân, kèm đường kính thân theo thông số nhà máy.</span>
              </li>
              <li>
                <a href="/bang-gia-dinh-thep/">Bảng giá và quy cách đinh thép</a>
                <span>Toàn bộ quy cách của 6 nhóm sản phẩm trong một bảng, cộng bảng tra bu lông M3-M36.</span>
              </li>
              <li>
                <a href="/nha-may/">Nhà máy sản xuất</a>
                <span>Quy trình sản xuất và hình ảnh thực tế tại xưởng.</span>
              </li>
            </ul>
            <p class="kt__goi">
              Cần tư vấn ngay, gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>.
            </p>
          </div>
        ) : (
          theoNhom
            .filter((n) => n.bai.length > 0)
            .map((n) => (
              <section class="kt__cum">
                <h2 id={n.key}>{n.ten}</h2>
                <ul class="kt__ds">
                  {n.bai.map((b) => (
                    <li>
                      <a href={`/kien-thuc/${b.id}/`}>{b.data.tieuDe}</a>
                      <span>{b.data.moTa}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .kt__trong {
    max-width: 820px;
  }
  .kt h1 {
    font-size: var(--cs-h1);
  }
  .kt__mo {
    margin-top: var(--k4);
  }
  .kt__chua-co {
    margin-top: var(--k7);
    padding: var(--k6);
    background: var(--nen-anh);
    border-radius: var(--bo);
  }
  .kt__chua-co h2 {
    margin-bottom: var(--k3);
  }
  .kt__chua-co p {
    max-width: var(--do-doc);
  }
  .kt__ds-tam,
  .kt__ds {
    display: grid;
    gap: var(--k4);
    margin-top: var(--k5);
  }
  .kt__ds-tam li,
  .kt__ds li {
    display: grid;
    gap: 3px;
  }
  .kt__ds-tam a,
  .kt__ds a {
    font-weight: var(--w-dam);
    font-size: var(--cs-lead);
  }
  .kt__ds-tam span,
  .kt__ds span {
    font-size: var(--cs-nho);
    color: var(--muc-2);
  }
  .kt__goi {
    margin-top: var(--k5);
    font-size: var(--cs-nho);
  }
  .kt__cum {
    margin-top: var(--k7);
  }
</style>
