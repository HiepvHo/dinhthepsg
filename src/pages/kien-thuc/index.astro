---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VunBanh from '../../components/VunBanh.astro';
import { catTieuDe, catMoTa } from '../../lib/seo-text';
import { anhCuaBai, nhanCum, ngayVn } from '../../lib/anh-bai';

/**
 * TRANG TIN TUC - danh sach bai viet + cot ben.
 *
 * SO DO industrie.rstheme.com/html/blog.html (do ngay 04/09/2026, khung 1440):
 *   bo cuc  danh sach 850px (col-8) + cot ben 440px (col-4)
 *   the bai `article.rs-postbox-item`, padding duoi 50px, cach nhau 50px
 *   anh     850x446 = ty le 1.905, bo goc 4px
 *   nhan    absolute top 20px left 20px, nen cam, chu trang 16px,
 *           padding 5px 20px, bo goc 4px
 *   khoi chu padding-top 30px
 *   meta    16px mau #616161
 *   tieu de 30px/700, line-height 1.25, mau #1f1f1f, margin-bottom 15px
 *   doan    17px, line-height 1.76, mau #616161
 *
 * TA KHAC HO BON CHO, deu co ly do:
 *
 * 1. KHONG CO O TIM KIEM trong cot ben. Ho co. Site cua ta la site TINH, khong
 *    co backend tim kiem; mot o search bam khong ra gi con te hon khong co.
 *    Thay bang chuyen muc va bai moi nhat - ca hai deu la link noi bo that,
 *    co gia tri cho ca nguoi doc lan Google.
 *
 * 2. BYLINE ghi TEN CONG TY chu khong ten nguoi. Ho de "By Industrie" - mot
 *    ten nguoi. Ta khong co du lieu tac gia, va bia ra mot cai ten la bia
 *    thong tin tac gia.
 *
 * 3. CHUYEN MUC lay tu truong `cum` trong topical map, khong go tay. Them bai
 *    moi voi `cum` da co la chuyen muc tu dem lai.
 *
 * 4. GIU trang thai RONG. Neu mot ngay moi bai deu chuyen sang `nhap: true`
 *    thi trang van dan sang cac trang tra cuu chu khong tro thanh trang rong -
 *    trang rong bi Google coi la thin content.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;

const bai = (await getCollection('baiViet', ({ data }) => !data.nhap)).sort(
  (a, b) => b.data.ngayDang.valueOf() - a.data.ngayDang.valueOf(),
);

/* Thu tu cum lay tu TOPICAL-MAP.md, khong sap theo bang chu cai */
const THU_TU_CUM = [
  'A-dinh-danh',
  'B-quy-cach',
  'C-khoi-luong',
  'D-vat-lieu',
  'E-ung-dung',
  'F-chon-dung',
  'G-san-xuat',
  'H-so-sanh',
];

const chuyenMuc = THU_TU_CUM.map((k) => ({
  ma: k,
  ten: nhanCum(k),
  so: bai.filter((b) => b.data.cum === k).length,
})).filter((n) => n.so > 0);

const moiNhat = bai.slice(0, 5);

const tieuDe = catTieuDe('Tin tức đinh thép xây dựng - Đinh Thép Sài Gòn');
const moTa = catMoTa(
  'Hướng dẫn chọn và dùng đinh thép xây dựng: quy cách, quy đổi phân sang mm, khối lượng, vật liệu và ứng dụng. Viết bởi nhà máy sản xuất.',
);
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/kien-thuc/">
  <VunBanh muc={[{ ten: 'Tin tức', duongDan: '/kien-thuc/' }]} />

  <div class="section nang-chu">
    <div class="khung">
      <div class="tt-dau">
        <p class="nhan-muc">Cập nhật</p>
        {/* H1 giu tu khoa "dinh thep xay dung" chu khong de tran "Tin tuc":
            mot H1 hai chu khong mang tu khoa nao la bo mot vi tri xep hang. */}
        <h1>Tin tức đinh thép xây dựng</h1>
        <p class="tt-dau__mo">
          Nội dung do nhà máy sản xuất viết, dựa trên thông số của chính hàng chúng tôi
          làm ra chứ không chép lại từ nơi khác.
        </p>
      </div>

      {
        bai.length === 0 ? (
          <div class="tt-rong">
            <h2>Đang biên soạn</h2>
            <p>
              Các bài viết đang được biên soạn và đối chiếu số liệu với nhà máy trước khi
              đăng. Trong lúc chờ, hai trang tra cứu dưới đây đã có đầy đủ thông số:
            </p>
            <ul class="tt-rong__ds">
              <li>
                <a href="/bang-tra-quy-cach-dinh/">Bảng tra quy cách đinh: phân, cm và mm</a>
                <span>Quy đổi đầy đủ từ 1 đến 15 phân, kèm đường kính thân theo thông số nhà máy.</span>
              </li>
              <li>
                <a href="/bang-gia-dinh-thep/">Bảng giá và quy cách đinh thép</a>
                <span>Toàn bộ quy cách của 6 nhóm sản phẩm trong một bảng, cộng bảng tra bu lông M3-M36.</span>
              </li>
              <li>
                <a href="/nha-may/">Nhà máy sản xuất</a>
                <span>Quy trình sản xuất và hình ảnh thực tế tại xưởng.</span>
              </li>
            </ul>
            <p class="tt-rong__goi">
              Cần tư vấn ngay, gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>.
            </p>
          </div>
        ) : (
          <div class="tt-bo">
            {/* ---------- danh sach bai ---------- */}
            <div class="tt-ds">
              {bai.map((b) => {
                const a = anhCuaBai(b.id);
                return (
                  <article class="the-bai">
                    <a class="the-bai__anh" href={`/kien-thuc/${b.id}/`} tabindex="-1" aria-hidden="true">
                      <Image
                        src={a.src}
                        alt={a.alt}
                        widths={[760, 1200]}
                        sizes="(max-width: 900px) 92vw, 760px"
                        loading="lazy"
                      />
                      <span class="the-bai__nhan">{nhanCum(b.data.cum)}</span>
                    </a>
                    <div class="the-bai__chu">
                      <p class="the-bai__meta">
                        <span>{c.tenThuongHieu}</span>
                        <time datetime={b.data.ngayDang.toISOString().slice(0, 10)}>
                          {ngayVn(b.data.ngayDang)}
                        </time>
                      </p>
                      <h2 class="the-bai__ten">
                        <a href={`/kien-thuc/${b.id}/`}>{b.data.tieuDe}</a>
                      </h2>
                      <p class="the-bai__mo">{b.data.moTa}</p>
                      <a class="the-bai__doc" href={`/kien-thuc/${b.id}/`}>
                        Đọc tiếp
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-5.5-6 6 6-6 6" /></svg>
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>

            {/* ---------- cot ben ---------- */}
            <aside class="tt-ben" aria-label="Chuyên mục và bài mới">
              <section class="o-ben">
                <h2 class="o-ben__dau">Chuyên mục</h2>
                <ul class="o-ben__cm">
                  {chuyenMuc.map((n) => (
                    <li>
                      <span>{n.ten}</span>
                      <b>{n.so}</b>
                    </li>
                  ))}
                </ul>
              </section>

              <section class="o-ben">
                <h2 class="o-ben__dau">Bài mới nhất</h2>
                <ul class="o-ben__moi">
                  {moiNhat.map((b) => {
                    const a = anhCuaBai(b.id);
                    return (
                      <li>
                        <a href={`/kien-thuc/${b.id}/`}>
                          <span class="o-ben__anh" aria-hidden="true">
                            <Image src={a.src} alt={a.alt} widths={[100, 200]} sizes="74px" loading="lazy" />
                          </span>
                          <span class="o-ben__chu">
                            <time datetime={b.data.ngayDang.toISOString().slice(0, 10)}>
                              {ngayVn(b.data.ngayDang)}
                            </time>
                            <strong>{b.data.tieuDe}</strong>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>

              <section class="o-ben o-ben--goi">
                <h2 class="o-ben__dau">Cần tư vấn quy cách</h2>
                <p>
                  Nói rõ công việc đang làm, chúng tôi chọn giúp loại đinh và chiều dài
                  phù hợp.
                </p>
                <a class="nut nut--chinh" href={`tel:${c.hotlineTel}`}>Gọi {c.hotline}</a>
                <a class="o-ben__phu" href="/bang-gia-dinh-thep/">Xem bảng quy cách đầy đủ</a>
              </section>
            </aside>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .tt-dau {
    max-width: var(--do-doc);
    margin-bottom: var(--k7);
  }
  .tt-dau h1 {
    font-size: var(--cs-h1);
  }
  .tt-dau__mo {
    margin-top: var(--k4);
    font-size: var(--cs-lead);
    color: var(--muc-2);
  }

  /* Ho: 850 + 440 (ty le 66/34). Khung ta 1100 kha dung -> 1fr + 340px. */
  .tt-bo {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--gap-lon);
    align-items: start;
  }
  .tt-bo > * {
    min-width: 0;
  }

  /* ---------------------------------------------------- the bai ---- */
  .tt-ds {
    display: grid;
    gap: var(--k8);
  }
  .the-bai {
    display: grid;
    gap: 0;
  }
  .the-bai + .the-bai {
    padding-top: var(--k8);
    border-top: var(--vien-mong);
  }

  /* Anh ty le 1.9:1 - do cua ho (850x446). Nhan chuyen muc de len goc tren
     trai, cach mep 20px, dung so cua ho. */
  .the-bai__anh {
    position: relative;
    display: block;
    aspect-ratio: 1.9 / 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--nen-anh);
  }
  .the-bai__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 520ms var(--nhip);
  }
  .the-bai:hover .the-bai__anh :global(img) {
    transform: scale(1.04);
  }
  .the-bai__nhan {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 6px 16px;
    background: var(--cam-600);
    border-radius: 4px;
    color: var(--trang);
    font-family: var(--font-hien);
    font-size: var(--cs-micro);
    font-weight: var(--w-dam);
    letter-spacing: var(--gc-micro);
    text-transform: uppercase;
  }

  /* Ho de padding-top 30px giua anh va khoi chu */
  .the-bai__chu {
    padding-top: var(--k5);
  }
  .the-bai__meta {
    display: flex;
    align-items: center;
    gap: var(--k3);
    flex-wrap: wrap;
    margin-bottom: var(--k3);
    font-size: var(--cs-micro);
    color: var(--muc-2);
  }
  .the-bai__meta span {
    font-weight: var(--w-dam);
    color: var(--muc);
  }
  .the-bai__meta time {
    font-variant-numeric: tabular-nums;
  }
  /* Vach ngan giua ten cong ty va ngay - thay dau bullet */
  .the-bai__meta time::before {
    content: '|';
    margin-right: var(--k3);
    color: var(--muc-3);
  }

  /* Ho: 30px/700 line-height 1.25. Ta dung --cs-h2 (33px o muc nang-chu). */
  .the-bai__ten {
    font-size: var(--cs-h2);
    line-height: var(--dc-dau);
    margin-bottom: var(--k3);
  }
  .the-bai__ten a {
    color: inherit;
    text-decoration: none;
  }
  .the-bai__ten a:hover {
    color: var(--cam-700);
  }
  .the-bai__mo {
    max-width: var(--do-doc);
    font-size: var(--cs-than);
    line-height: 1.7;
    color: var(--muc-2);
  }
  .the-bai__doc {
    display: inline-flex;
    align-items: center;
    gap: var(--k2);
    margin-top: var(--k4);
    font-family: var(--font-hien);
    font-size: var(--cs-than);
    font-weight: var(--w-dam);
    color: var(--cam-700);
    text-decoration: none;
  }
  .the-bai__doc svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--thoi) var(--nhip);
  }
  .the-bai__doc:hover {
    color: var(--cam-700);
  }
  .the-bai__doc:hover svg {
    transform: translateX(4px);
  }

  /* ---------------------------------------------------- cot ben ---- */
  .tt-ben {
    display: grid;
    gap: var(--k5);
    position: sticky;
    top: var(--neo-le);
  }
  .o-ben {
    padding: var(--k5);
    background: var(--nen-nhat);
  }
  /* Vach cam ngan ben tren dau muc - do theo cot ben cua ho */
  .o-ben__dau {
    position: relative;
    padding-top: var(--k3);
    margin-bottom: var(--k4);
    font-size: var(--cs-h3);
  }
  .o-ben__dau::before {
    position: absolute;
    content: '';
    top: 0;
    left: 0;
    width: 4px;
    height: 12px;
    background: var(--cam-500);
  }

  .o-ben__cm {
    display: grid;
  }
  .o-ben__cm li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--k3);
    padding: 9px 0;
    font-size: var(--cs-nho);
  }
  .o-ben__cm li + li {
    border-top: var(--vien-mong);
  }
  .o-ben__cm b {
    font-family: var(--font-hien);
    font-size: var(--cs-micro);
    color: var(--muc-2);
    font-variant-numeric: tabular-nums;
  }

  .o-ben__moi {
    display: grid;
    gap: var(--k4);
  }
  .o-ben__moi a {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: var(--k3);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .o-ben__anh {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--nen-anh);
  }
  .o-ben__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .o-ben__chu {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .o-ben__chu time {
    font-size: var(--cs-micro);
    color: var(--muc-3);
    font-variant-numeric: tabular-nums;
  }
  .o-ben__chu strong {
    font-size: var(--cs-nho);
    font-weight: var(--w-vua);
    line-height: 1.4;
    /* Cat con hai dong: tieu de bai cua ta dai, de het thi o ben cao gap ba */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .o-ben__moi a:hover .o-ben__chu strong {
    color: var(--cam-700);
  }

  .o-ben--goi {
    background: var(--navy-900);
    color: var(--muc-nghich);
  }
  .o-ben--goi .o-ben__dau {
    color: var(--trang);
  }
  .o-ben--goi p {
    margin-bottom: var(--k4);
    font-size: var(--cs-nho);
    color: var(--muc-nghich-2);
  }
  .o-ben--goi .nut {
    width: 100%;
    justify-content: center;
  }
  .o-ben__phu {
    display: block;
    margin-top: var(--k3);
    font-size: var(--cs-micro);
    color: var(--muc-nghich-2);
    text-align: center;
  }
  .o-ben__phu:hover {
    color: var(--trang);
  }

  /* ---------------------------------------------------- trang rong ---- */
  .tt-rong {
    max-width: 820px;
    padding: var(--k6);
    background: var(--nen-nhat);
  }
  .tt-rong h2 {
    margin-bottom: var(--k3);
  }
  .tt-rong p {
    max-width: var(--do-doc);
  }
  .tt-rong__ds {
    display: grid;
    gap: var(--k4);
    margin-top: var(--k5);
  }
  .tt-rong__ds li {
    display: grid;
    gap: 3px;
  }
  .tt-rong__ds a {
    font-weight: var(--w-dam);
    font-size: var(--cs-lead);
  }
  .tt-rong__ds span {
    font-size: var(--cs-nho);
    color: var(--muc-2);
  }
  .tt-rong__goi {
    margin-top: var(--k5);
    font-size: var(--cs-nho);
  }

  @media (max-width: 980px) {
    .tt-bo {
      grid-template-columns: 1fr;
    }
    /* Cot ben xuong DUOI danh sach: no la phu tro, khong dang chiem man hinh
       dau tren dien thoai. Bo dinh (sticky) luon - dinh mot khoi da nam duoi
       cung thi khong con y nghia gi. */
    .tt-ben {
      position: static;
      order: 2;
      grid-template-columns: repeat(2, 1fr);
    }
    .o-ben--goi {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .tt-ben {
      grid-template-columns: 1fr;
    }
    .the-bai + .the-bai {
      padding-top: var(--k7);
    }
    .tt-ds {
      gap: var(--k7);
    }
  }
</style>
