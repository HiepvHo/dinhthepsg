---
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catTieuDe, catMoTa } from '../lib/seo-text';
import BannerSlider from '../components/BannerSlider.astro';
import LyDoChon from '../components/LyDoChon.astro';
import DoiTac from '../components/DoiTac.astro';
import CamNghi from '../components/CamNghi.astro';
import TinTuc from '../components/TinTuc.astro';
import { tenChinh, quyDoi, coGia, dinhDangGia } from '../lib/quy-cach';

import anhHero from '../assets/anh/dong-bao-dinh-sai-gon.jpg';
import anhRaMay from '../assets/anh/dinh-ra-khoi-may.jpg';
import anhDayChuyen from '../assets/anh/day-chuyen-dap-dinh.jpg';
import anhCongNhan from '../assets/anh/cong-nhan-thep-cuong-phat.jpg';
import anhSoiThep from '../assets/anh/cuon-soi-thep-nguyen-lieu.jpg';
import anhKho from '../assets/anh/kho-bao-dinh.jpg';
import anhNenTrang1 from '../assets/anh/dinh-tren-nen-trang-01.jpg';
import anhNenTrang2 from '../assets/anh/dinh-tren-nen-trang-02.jpg';
import anhCan from '../assets/anh/can-dinh-tai-xuong.jpg';

/**
 * TRANG CHU.
 *
 * Khung xuong lay tu thegioithepvn.com (do 01/09/2026): anh full-bleed khong
 * chu de len, H1 nam o section intro ngay duoi hero chu khong nam tren anh.
 *
 * THU TU MUC (user chot 01/09/2026):
 *   banner - ly do - gioi thieu - san pham - bang quy cach - nha may
 *   - hop tac - cam nghi - tin tuc - CTA
 *
 * NEN XEN KE nghiem ngat trang / tint am, bat dau tu trang:
 *   ly do(trang) gioi thieu(trang, dinh lien khoi tren) san pham(nhat)
 *   bang(trang) nha may(nhat) hop tac(trang) cam nghi(nhat) tin tuc(trang) CTA(do)
 * Tint la #FBF4F2 - cung goc mau voi do thuong hieu, bao hoa ~5%. Truoc day
 * dung xam lanh #F4F6F8 nen cac dai doc ra roi rac khong lien quan gi nhau.
 *
 * HAI MUC TU AN KHI CHUA CO DU LIEU: cam nghi (cam-nghi.yaml rong) va tin tuc
 * (chua co bai). Trong con hon bia.
 *
 * ANH HIEN TAI LA TAM. Anh banner can ban chup ngang ti le ~2.4:1, anh hien tai
 * la 4:3 nen bi crop nhieu.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;
const nhom = await getCollection('nhomSanPham');
const dinhChi = nhom.find((n) => n.id === 'dinh-chi')!;

/**
 * Trang chu chi hien NAM quy cach, khong hien ca muoi.
 *
 * Ly do do duoc: bang 10 dong x 6 cot ve 60 o co vien - chiem 60 trong tong so
 * 71 cai vien cua ca trang, va cao 814px tuc 0,75 man hinh. Nguoi ta khong doc
 * trang chu, ho luot; nhoi 10 dong thong so vao giua luong luot la di nguoc.
 * Bang day du 24 quy cach van o /bang-gia-dinh-thep/ va trang tung nhom.
 *
 * Chon 5 ma phu deu dai: ngan - pho thong - dai.
 */
const MA_NOI_BAT = ['3F', '5F', '7F', '10F', '15F'];
const quyCachNoiBat = dinhChi.data.quyCach.filter((q) => MA_NOI_BAT.includes(q.ma));
const nhaMay = c.diaDiem[0];
const soNam = new Date().getFullYear() - c.namThanhLap;
const tongQuyCach = nhom.reduce((t, n) => t + n.data.quyCach.length, 0);

/**
 * Anh cho bang truot dau trang. 5 anh, deu la 1280x960 (4:3 NGANG).
 *
 * KHONG dua `anhDayChuyen` vao day: file do la 960x1280, tuc anh DOC. Khung
 * banner 893x560 (1.59:1) se cat mat 53% chieu cao cua no, chi con mot lat
 * ngang giua tam. Anh do van dung o muc Nha may, noi khung la 4:3.
 */
const anhBanner = [
  { src: anhHero, alt: 'Công nhân đóng bao đinh tại nhà máy Đinh Thép Sài Gòn, Đức Hòa, Long An' },
  { src: anhCongNhan, alt: 'Công nhân mặc đồng phục Thép Cường Phát làm việc tại xưởng đinh' },
  { src: anhRaMay, alt: 'Đinh thép vừa ra khỏi máy dập, rơi xuống máng chứa' },
  { src: anhSoiThep, alt: 'Cuộn sợi thép nguyên liệu dùng để dập đinh, tập kết tại xưởng' },
  { src: anhKho, alt: 'Bao đinh thành phẩm xếp trong kho nhà máy' },
];

const anhNhom: Record<string, { src: ImageMetadata; alt: string }> = {
  'dinh-chi': { src: anhNenTrang1, alt: 'Đinh chì do nhà máy Đinh Thép Sài Gòn sản xuất' },
  'dinh-thep-trang': { src: anhNenTrang2, alt: 'Đinh thép trắng thân trơn bề mặt sáng' },
  'dinh-thep-vang': { src: anhRaMay, alt: 'Đinh thép vừa ra khỏi máy dập tại xưởng' },
  'dinh-du': { src: anhCan, alt: 'Đinh thành phẩm được cân tại xưởng' },
  'dinh-vit': { src: anhKho, alt: 'Bao đinh thành phẩm trong kho nhà máy' },
  'day-kem-hap': { src: anhSoiThep, alt: 'Cuộn sợi thép nguyên liệu tại nhà máy' },
};

const tieuDe = catTieuDe('Đinh Thép Sài Gòn - Nhà máy sản xuất đinh, dây kẽm');
const moTa = catMoTa(
  `Nhà máy sản xuất đinh thép xây dựng: đinh chì 2p đến 15p, đinh thép trắng, đinh vàng, đinh dù, đinh vít, dây kẽm. Bán trực tiếp, gọi ${c.hotline}.`,
);
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/">
  {/* ==== 1. BANG TRUOT ANH full-bleed, KHONG co chu de len ====
      Da thu dat chu len banner (nhan + H1 + doan phu + nut + so lieu) va user
      bo: khong ai yeu cau chu tren banner. Banner la anh, het.
      Chieu cao van tinh theo man hinh de dai ly do ngay duoi lot tron vao man
      hinh dau - xem BannerSlider.astro. */}
  {/* Chu tren banner: NHAN + H1 + dong phu + hai nut, do theo caption cua ho.
      MOI CAU deu dua tren du lieu da xac minh trong cong-ty.yaml va content
      collection - nam thanh lap 2012, so quy cach dem tu du lieu, dia diem nha
      may lay tu diaDiem[0].
      KHONG viet "dan dau nganh" hay "so 1": khong co so lieu nao chung minh
      duoc, va mot cau nhu vay tren trang ban vat tu vua khong thuyet phuc duoc
      khach B2B vua la rui ro E-E-A-T. Cai thuyet phuc duoc dan mua vat tu la
      NHA MAY THAT, SO QUY CACH THAT, BAN THANG KHONG QUA TRUNG GIAN. */}
  <BannerSlider
    anh={anhBanner}
    giay={5.5}
    nhan={`Hơn ${soNam} năm kinh nghiệm`}
    tieuDe="Nhà máy sản xuất đinh thép xây dựng"
    phu={`Đinh chì, đinh thép trắng, đinh thép vàng, đinh dù, đinh vít và dây kẽm hấp. Bán trực tiếp từ xưởng ${nhaMay.quanHuyen}, ${nhaMay.tinhThanh}, không qua trung gian.`}
    nut={[
      { chu: 'Xem sản phẩm', duongDan: '/san-pham/', chinh: true },
      { chu: `Gọi ${c.hotline}`, duongDan: `tel:${c.hotlineTel}` },
    ]}
  />

  {/* ==== 2. Ly do chon chung toi - thay cho 4 chip mau dac cu ==== */}
  <LyDoChon soQuyCach={tongQuyCach} />

  {/* ============ 3. Gioi thieu, mang H1 ============ */}
  <section class="gioi-thieu">
    <div class="khung gt">
      {/* Cot anh: hai tam SO LE - tam trai neo dinh, tam phai neo day.
          Do theo Industro: `col-6 align-self-start` va `col-6 align-self-end`.
          So le la thu lam cum anh nay khong doc ra nhu mot o anh don. */}
      <div class="gt__anh">
        <figure class="gt__anh--tren hien-dan hien-dan--len">
          <Image
            src={anhCongNhan}
            alt="Công nhân mặc đồng phục Thép Cường Phát làm việc tại xưởng đinh"
            widths={[320, 620]}
            sizes="(max-width: 900px) 46vw, 270px"
            loading="lazy"
          />
        </figure>
        <figure class="gt__anh--duoi hien-dan hien-dan--xuong">
          <Image
            src={anhCan}
            alt="Cân đinh thành phẩm tại xưởng trước khi đóng bao"
            widths={[320, 620]}
            sizes="(max-width: 900px) 46vw, 270px"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="gt__chu hien-dan" style="--tre: 0.25s">
        {/* H2 chu khong H1: H1 da chuyen len banner. Mot trang chi duoc mot
            H1 - chinh template Industro mac loi nay, moi slide cua ho mot the
            <h1> nen trang chu cua ho co hai. */}
        <p class="nhan-muc">Về nhà máy</p>
        <h2>Đinh Thép Sài Gòn - nhà máy đinh thép và lưới thép hàn</h2>
        <p>
          {c.tenPhapDinhHoa} là đơn vị <strong>sản xuất trực tiếp</strong> đinh thép xây dựng
          và lưới thép hàn, hoạt động từ năm {c.namThanhLap}, {soNam} năm trong ngành vật tư
          kim khí. Nhà máy đặt tại {nhaMay.diaChi}, {nhaMay.quanHuyen}, {nhaMay.tinhThanh}.
        </p>
        <p>
          Chúng tôi sản xuất <strong>{tongQuyCach} quy cách</strong>: đinh chì từ 2 phân đến
          15 phân, đinh thép trắng, đinh thép vàng, đinh dù, đinh vít và dây kẽm hấp. Toàn bộ
          thông số chiều dài và đường kính thân được công bố đầy đủ theo phân, cm và mm.
        </p>
        <p>
          Ngoài đinh, công ty còn gia công tole và phân phối vật tư kim khí qua hệ thống
          {' '}{c.diaDiem.length} địa điểm tại TP.HCM, Long An và Cần Thơ.
        </p>
        {/* Khoi so nam + danh sach tich. Do theo Industro:
            `flex-shrink-0 bg-primary p-4` chua `display-2` roi cot tich ben canh.
            So nam TINH TU namThanhLap chu khong go cung. */}
        <div class="gt__nam">
          <div class="gt__khoi">
            <span class="gt__so">{soNam}</span>
            <span class="gt__nhan">Năm</span>
            <span class="gt__nhan">kinh nghiệm</span>
          </div>
          <ul class="gt__tich">
            {
              nhom.map((n) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  {n.data.ten}
                </li>
              ))
            }
          </ul>
        </div>

        {/* Hai o lien he - do theo cap `btn-lg-square rounded-circle bg-primary`
            cua ho o cuoi muc About. */}
        <div class="gt__lh">
          <a class="gt__o" href={`tel:${c.hotlineTel}`}>
            <span class="o-icon o-icon--tron o-icon--cam" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6.5 3.5 4 4.2c-1 .3-1.6 1.3-1.3 2.3C4 12 9 17 14.5 18.3c1 .3 2-.3 2.3-1.3l.7-2.5-3.6-1.6-1.3 1.6a12 12 0 0 1-4.4-4.4l1.6-1.3-1.6-3.6Z" /></svg>
            </span>
            <span>
              <em>Gọi nhà máy</em>
              <strong>{c.hotline}</strong>
            </span>
          </a>
          <a class="gt__o" href="/bang-gia-dinh-thep/">
            <span class="o-icon o-icon--tron o-icon--cam" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 3.5h14v17H5zM8.5 8h7M8.5 12h7M8.5 16h4" /></svg>
            </span>
            <span>
              <em>Tra thông số</em>
              <strong>Bảng quy cách đầy đủ</strong>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ==== Dai so lieu - muc MOI, do theo `.facts` cua Industro ====
      Bon con so, KHONG bia so nao: nam kinh nghiem tinh tu namThanhLap, so quy
      cach va so nhom dem tu content collection, so dia diem dem tu cong-ty.yaml.
      Ho co "957 Happy Clients" va "1839 Projects Done" - ta khong co so that
      nao tuong duong nen khong dat o do. */}
  <section class="dai-so" aria-label="Số liệu nhà máy">
    <div class="dai-so__luoi">
      <div class="dai-so__o hien-dan hien-dan--len" style="--tre: 0.1s">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.8 9.6 6.2 2.8h11.6l-2.6 6.8" /><circle cx="12" cy="15" r="6" /><circle cx="12" cy="15" r="2.4" /></svg>
        <span class="dai-so__so">{soNam}</span>
        <span class="dai-so__nhan">Năm trong ngành</span>
      </div>
      <div class="dai-so__o hien-dan hien-dan--len" style="--tre: 0.2s">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1" /><path d="M7 8v3.4M11 8v4.4M15 8v3.4M19 8v4.4" /></svg>
        <span class="dai-so__so">{tongQuyCach}</span>
        <span class="dai-so__nhan">Quy cách sản xuất</span>
      </div>
      <div class="dai-so__o hien-dan hien-dan--len" style="--tre: 0.3s">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 20.6 7v10L12 21.2 3.4 17V7L12 2.8Z" /><path d="M3.4 7 12 11.4 20.6 7M12 11.4v9.8" /></svg>
        <span class="dai-so__so">{nhom.length}</span>
        <span class="dai-so__nhan">Nhóm sản phẩm</span>
      </div>
      <div class="dai-so__o hien-dan hien-dan--len" style="--tre: 0.4s">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" /><circle cx="12" cy="10" r="2.6" /></svg>
        <span class="dai-so__so">{c.diaDiem.length}</span>
        <span class="dai-so__nhan">Địa điểm hoạt động</span>
      </div>
    </div>
  </section>

  {/* ============ 4. Cac hang danh muc san pham ============ */}
  <section class="hang hang--nhat">
    <div class="khung">
      <div class="hang__dau">
        <h2>Sản phẩm nhà máy sản xuất</h2>
        <a href="/san-pham/">Xem tất cả</a>
      </div>
      <p class="hang__dan">
        {c.tenThuongHieu} sản xuất và phân phối trực tiếp {tongQuyCach} quy cách đinh và
        vật tư liên kết, giao tận công trình khu vực TP.HCM, Long An và các tỉnh lân cận.
      </p>
      {/* The LAT KHI RE - do theo `.service-item` cua Industro.
          Ho dung mot <div> boc, ben trong co mot <a class="btn">. Ta lam ca the
          thanh MOT the <a> va nut chi la <span>: link long link la HTML khong
          hop le, va mot vung bam duy nhat bang ca the thi de bam hon nhieu.
          Anh dung HAI lan giong ho: mot lam nen, mot trong o vuong nho len. */}
      <div class="the-hang">
        {
          nhom.map((n, k) => {
            const a = anhNhom[n.id];
            return (
              <a
                class="the-lat hien-dan hien-dan--len"
                style={`--tre: ${(k % 3) * 0.15}s`}
                href={`/san-pham/${n.data.slug}/`}
              >
                {/* CA HAI anh deu la TRANG TRI: ten nhom trong `.the-lat__ten`
                    moi la thu mang nghia, va no la ten cua chinh link nay.
                    De anh mang alt khong an di thi trinh doc man hinh se doc
                    ten nhom BA lan (alt nen + alt o vuong + chu).

                    Nhung KHONG truyen alt="" duoc: Astro bo han thuoc tinh alt
                    ra khoi the img khi chuoi rong - da do duoc 6 the img thieu
                    alt sau lan sua truoc. Nen giu alt THAT roi boc trong mot
                    span aria-hidden: trinh doc bo qua, con Google van doc duoc
                    alt de hieu anh. Cung cach da dung cho ban sao o BannerSlider. */}
                <span class="the-lat__nen" aria-hidden="true">
                  <Image
                    src={a.src}
                    alt={a.alt}
                    widths={[260, 500]}
                    sizes="(max-width: 900px) 46vw, 255px"
                    loading="lazy"
                  />
                </span>
                <span class="the-lat__huy" aria-hidden="true">
                  <Image src={a.src} alt={a.alt} widths={[130, 260]} sizes="106px" loading="lazy" />
                </span>
                <span class="the-lat__khung">
                  <span class="the-lat__dau">
                    <span class="the-lat__ke" aria-hidden="true"></span>
                    <span class="the-lat__ten">{n.data.ten}</span>
                    <span class="the-lat__so">{n.data.quyCach.length} quy cách</span>
                  </span>
                  <span class="the-lat__mo">{n.data.moTaNgan}</span>
                </span>
                <span class="the-lat__nut">Xem quy cách</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ============ 5. Bang quy cach ============ */}
  <section class="hang">
    <div class="khung">
      <div class="hang__dau">
        <h2>Bảng quy cách đinh chì</h2>
        <a href="/bang-gia-dinh-thep/">Bảng đầy đủ 6 nhóm</a>
      </div>
      <p class="hang__dan">
        Mã <strong>F</strong> trên bao đọc là <strong>phân</strong>, 1 phân = 1cm = 10mm.
        Dưới đây là năm quy cách hay đặt nhất.
      </p>
      <div class="bang-cuon">
        <table class="bang">
          <caption>Quy cách đinh chì hay đặt nhất - {c.tenThuongHieu} sản xuất</caption>
          <thead>
            <tr>
              <th scope="col">Quy cách</th>
              <th scope="col">Mã</th>
              <th scope="col" class="so">Chiều dài</th>
              <th scope="col" class="so">Đường kính thân</th>
            </tr>
          </thead>
          <tbody>
            {
              quyCachNoiBat.map((q) => (
                <tr>
                  <td><a href={`/san-pham/${q.slug}/`}>{tenChinh(dinhChi.data.ten, q)}</a></td>
                  <td>{q.ma}</td>
                  <td class="so">{q.daiMm} mm</td>
                  <td class="so">{q.duongKinhMm ? `${q.duongKinhMm} mm` : '-'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {/* Mot dong thay cho mot cot 10 o "gọi để báo giá" giong het nhau.
          Khi nhom-san-pham.yaml co gia thi tra lai cot Gia. */}
      <p class="hang__gia-nhac">
        Giá vật tư thay đổi theo ngày. Gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>
        {' '}để nhận báo giá hôm nay, hoặc xem
        {' '}<a href="/bang-gia-dinh-thep/">đầy đủ {tongQuyCach} quy cách của 6 nhóm</a>.
      </p>
    </div>
  </section>

  {/* ============ 6. Nha may ============ */}
  {/* Do theo muc Project cua Industro: nen navy, tieu de can giua, hang anh
      TRAN SAT MEP khong khe (`row g-0`), moi anh nho len khi re va thanh tieu de
      navy dang len. Hang anh nam NGOAI .khung de tran duoc het be ngang. */}
  <section class="nm-muc">
    <div class="khung nm-muc__dau hien-dan hien-dan--len">
      <p class="nhan-muc nhan-muc--nghich">Nhà máy sản xuất</p>
      <h2>Hàng bán ra là hàng chúng tôi làm ra</h2>
    </div>

    <div class="nm">
      <a class="anh-nho hien-dan hien-dan--len" style="--tre: 0.00s" href="/nha-may/">
        <Image src={anhDayChuyen} alt="Dây chuyền máy dập đinh tại nhà máy" widths={[280, 560]} sizes="(max-width: 900px) 50vw, 25vw" loading="lazy" />
        <span class="anh-nho__dau"><span>Dây chuyền dập đinh</span></span>
      </a>
      <a class="anh-nho hien-dan hien-dan--len" style="--tre: 0.12s" href="/nha-may/">
        <Image src={anhRaMay} alt="Đinh ra khỏi máy dập xuống máng chứa" widths={[280, 560]} sizes="(max-width: 900px) 50vw, 25vw" loading="lazy" />
        <span class="anh-nho__dau"><span>Đinh ra khỏi máy</span></span>
      </a>
      <a class="anh-nho hien-dan hien-dan--len" style="--tre: 0.24s" href="/nha-may/">
        <Image src={anhSoiThep} alt="Cuộn sợi thép nguyên liệu tại xưởng" widths={[280, 560]} sizes="(max-width: 900px) 50vw, 25vw" loading="lazy" />
        <span class="anh-nho__dau"><span>Sợi thép nguyên liệu</span></span>
      </a>
      <a class="anh-nho hien-dan hien-dan--len" style="--tre: 0.36s" href="/nha-may/">
        <Image src={anhKho} alt="Bao đinh thành phẩm xếp trong kho" widths={[280, 560]} sizes="(max-width: 900px) 50vw, 25vw" loading="lazy" />
        <span class="anh-nho__dau"><span>Kho thành phẩm</span></span>
      </a>
    </div>

    <div class="khung">
      <ul class="nm__y">
        <li><strong>Thông số là của chính hàng chúng tôi làm ra</strong>, không phải số chép lại.</li>
        <li><strong>Đặt được số lượng lớn và quy cách riêng</strong>, nhà máy chạy theo đơn.</li>
        <li><strong>Pháp nhân rõ ràng</strong>, MST {c.maSoThue}, thành lập {c.namThanhLap}.</li>
      </ul>
    </div>
  </section>

  {/* ==== 7. Hop tac: doi tac + hang thiet bi (nen trang) ==== */}
  <DoiTac />

  {/* ==== 8. Cam nghi khach hang (nen nhat) - tu an khi chua co du lieu ==== */}
  <CamNghi />

  {/* ==== 9. Tin tuc (nen trang) - tu an khi chua co bai ==== */}
  <TinTuc />

  {/* ============ 10. CTA ============ */}
  <section class="cta">
    <div class="khung cta__trong">
      <div>
        <h2>Gửi quy cách và số lượng, nhận báo giá trong ngày</h2>
