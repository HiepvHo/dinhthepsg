---
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catTieuDe, catMoTa } from '../lib/seo-text';
import BannerSlider from '../components/BannerSlider.astro';
import LyDoChon from '../components/LyDoChon.astro';
import DoiTac from '../components/DoiTac.astro';
import CamNghi from '../components/CamNghi.astro';
import TinTuc from '../components/TinTuc.astro';
import { tenChinh, quyDoi, coGia, dinhDangGia } from '../lib/quy-cach';

import anhHero from '../assets/anh/dong-bao-dinh-sai-gon.jpg';
import anhRaMay from '../assets/anh/dinh-ra-khoi-may.jpg';
import anhDayChuyen from '../assets/anh/day-chuyen-dap-dinh.jpg';
import anhCongNhan from '../assets/anh/cong-nhan-thep-cuong-phat.jpg';
import anhSoiThep from '../assets/anh/cuon-soi-thep-nguyen-lieu.jpg';
import anhKho from '../assets/anh/kho-bao-dinh.jpg';
import anhNenTrang1 from '../assets/anh/dinh-tren-nen-trang-01.jpg';
import anhNenTrang2 from '../assets/anh/dinh-tren-nen-trang-02.jpg';
import anhCan from '../assets/anh/can-dinh-tai-xuong.jpg';

/**
 * TRANG CHU.
 *
 * Khung xuong lay tu thegioithepvn.com (do 01/09/2026): anh full-bleed khong
 * chu de len, H1 nam o section intro ngay duoi hero chu khong nam tren anh.
 *
 * THU TU MUC (user chot 01/09/2026):
 *   banner - ly do - gioi thieu - san pham - bang quy cach - nha may
 *   - hop tac - cam nghi - tin tuc - CTA
 *
 * NEN XEN KE nghiem ngat trang / tint am, bat dau tu trang:
 *   ly do(trang) gioi thieu(trang, dinh lien khoi tren) san pham(nhat)
 *   bang(trang) nha may(nhat) hop tac(trang) cam nghi(nhat) tin tuc(trang) CTA(do)
 * Tint la #FBF4F2 - cung goc mau voi do thuong hieu, bao hoa ~5%. Truoc day
 * dung xam lanh #F4F6F8 nen cac dai doc ra roi rac khong lien quan gi nhau.
 *
 * HAI MUC TU AN KHI CHUA CO DU LIEU: cam nghi (cam-nghi.yaml rong) va tin tuc
 * (chua co bai). Trong con hon bia.
 *
 * ANH HIEN TAI LA TAM. Anh banner can ban chup ngang ti le ~2.4:1, anh hien tai
 * la 4:3 nen bi crop nhieu.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;
const nhom = await getCollection('nhomSanPham');
const dinhChi = nhom.find((n) => n.id === 'dinh-chi')!;

/**
 * Trang chu chi hien NAM quy cach, khong hien ca muoi.
 *
 * Ly do do duoc: bang 10 dong x 6 cot ve 60 o co vien - chiem 60 trong tong so
 * 71 cai vien cua ca trang, va cao 814px tuc 0,75 man hinh. Nguoi ta khong doc
 * trang chu, ho luot; nhoi 10 dong thong so vao giua luong luot la di nguoc.
 * Bang day du 24 quy cach van o /bang-gia-dinh-thep/ va trang tung nhom.
 *
 * Chon 5 ma phu deu dai: ngan - pho thong - dai.
 */
const MA_NOI_BAT = ['3F', '5F', '7F', '10F', '15F'];
const quyCachNoiBat = dinhChi.data.quyCach.filter((q) => MA_NOI_BAT.includes(q.ma));
const nhaMay = c.diaDiem[0];
const soNam = new Date().getFullYear() - c.namThanhLap;
const tongQuyCach = nhom.reduce((t, n) => t + n.data.quyCach.length, 0);

/**
 * Anh cho bang truot dau trang. 5 anh, deu la 1280x960 (4:3 NGANG).
 *
 * KHONG dua `anhDayChuyen` vao day: file do la 960x1280, tuc anh DOC. Khung
 * banner 893x560 (1.59:1) se cat mat 53% chieu cao cua no, chi con mot lat
 * ngang giua tam. Anh do van dung o muc Nha may, noi khung la 4:3.
 */
const anhBanner = [
  { src: anhHero, alt: 'Công nhân đóng bao đinh tại nhà máy Đinh Thép Sài Gòn, Đức Hòa, Long An' },
  { src: anhCongNhan, alt: 'Công nhân mặc đồng phục Thép Cường Phát làm việc tại xưởng đinh' },
  { src: anhRaMay, alt: 'Đinh thép vừa ra khỏi máy dập, rơi xuống máng chứa' },
  { src: anhSoiThep, alt: 'Cuộn sợi thép nguyên liệu dùng để dập đinh, tập kết tại xưởng' },
  { src: anhKho, alt: 'Bao đinh thành phẩm xếp trong kho nhà máy' },
];

const anhNhom: Record<string, { src: ImageMetadata; alt: string }> = {
  'dinh-chi': { src: anhNenTrang1, alt: 'Đinh chì do nhà máy Đinh Thép Sài Gòn sản xuất' },
  'dinh-thep-trang': { src: anhNenTrang2, alt: 'Đinh thép trắng thân trơn bề mặt sáng' },
  'dinh-thep-vang': { src: anhRaMay, alt: 'Đinh thép vừa ra khỏi máy dập tại xưởng' },
  'dinh-du': { src: anhCan, alt: 'Đinh thành phẩm được cân tại xưởng' },
  'dinh-vit': { src: anhKho, alt: 'Bao đinh thành phẩm trong kho nhà máy' },
  'day-kem-hap': { src: anhSoiThep, alt: 'Cuộn sợi thép nguyên liệu tại nhà máy' },
};

const tieuDe = catTieuDe('Đinh Thép Sài Gòn - Nhà máy sản xuất đinh, dây kẽm');
const moTa = catMoTa(
  `Nhà máy sản xuất đinh thép xây dựng: đinh chì 2p đến 15p, đinh thép trắng, đinh vàng, đinh dù, đinh vít, dây kẽm. Bán trực tiếp, gọi ${c.hotline}.`,
);
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/">
  {/* ==== 1. HERO: bang truot anh + THE NOI DUNG dat de len ====
      The dat DE LEN chu khong phu chu thang vao anh: anh nha may la thep xam
      day chi tiet, chu trang de thang len se khong doc duoc du co phu lop toi.
      The dat LECH TRAI chu khong can giua - hero can giua la mot trong nhung
      dau hieu bi neu ten khi noi ve giao dien do AI sinh. */}
  <div class="hero">
    <BannerSlider anh={anhBanner} giay={5.5} />

    <div class="hero__lop">
      <div class="khung">
        <div class="hero__the">
          <span class="hero__nhan">Nhà máy sản xuất</span>
          <h1>Đinh thép xây dựng</h1>
          <p class="hero__phu">
            {tongQuyCach} quy cách từ 20mm đến 150mm. Công bố đủ chiều dài và đường kính
            thân theo phân, cm và mm.
          </p>
          <div class="hero__nut">
            <a class="nut nut--chinh nut--lon" href={`tel:${c.hotlineTel}`}>
              Gọi báo giá {c.hotline}
            </a>
            <a class="nut nut--vien nut--lon" href="/bang-gia-dinh-thep/">Xem bảng giá</a>
          </div>
          <ul class="hero__tin">
            <li><strong>{soNam}</strong> năm</li>
            <li><strong>{c.diaDiem.length}</strong> địa điểm</li>
            <li>MST <strong>{c.maSoThue}</strong></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {/* ==== 2. Ly do chon chung toi - thay cho 4 chip mau dac cu ==== */}
  <LyDoChon soQuyCach={tongQuyCach} />

  {/* ============ 3. Gioi thieu, mang H1 ============ */}
  <section class="gioi-thieu">
    <div class="khung gioi-thieu__trong">
      <div>
        <h2>Đinh Thép Sài Gòn - Nhà máy sản xuất đinh thép xây dựng</h2>
        <p>
          {c.tenPhapDinhHoa} là đơn vị <strong>sản xuất trực tiếp</strong> đinh thép xây dựng
          và lưới thép hàn, hoạt động từ năm {c.namThanhLap}, {soNam} năm trong ngành vật tư
          kim khí. Nhà máy đặt tại {nhaMay.diaChi}, {nhaMay.quanHuyen}, {nhaMay.tinhThanh}.
        </p>
        <p>
          Chúng tôi sản xuất <strong>{tongQuyCach} quy cách</strong>: đinh chì từ 2 phân đến
          15 phân, đinh thép trắng, đinh thép vàng, đinh dù, đinh vít và dây kẽm hấp. Toàn bộ
          thông số chiều dài và đường kính thân được công bố đầy đủ theo phân, cm và mm.
        </p>
        <p>
          Ngoài đinh, công ty còn gia công tole và phân phối vật tư kim khí qua hệ thống
          {' '}{c.diaDiem.length} địa điểm tại TP.HCM, Long An và Cần Thơ.
        </p>
        <p class="gioi-thieu__goi">
          Liên hệ nhận <a href="/bang-gia-dinh-thep/">bảng giá đinh thép hôm nay</a>
        </p>
      </div>
      <figure class="gioi-thieu__anh">
        <Image
          src={anhCongNhan}
          alt="Công nhân mặc đồng phục Thép Cường Phát làm việc tại xưởng đinh"
          widths={[420, 760]}
          sizes="(max-width: 900px) 92vw, 460px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {/* ============ 4. Cac hang danh muc san pham ============ */}
  <section class="hang hang--nhat">
    <div class="khung">
      <div class="hang__dau">
        <h2>Sản phẩm nhà máy sản xuất</h2>
        <a href="/san-pham/">Xem tất cả</a>
      </div>
      <p class="hang__dan">
        {c.tenThuongHieu} sản xuất và phân phối trực tiếp {tongQuyCach} quy cách đinh và
        vật tư liên kết, giao tận công trình khu vực TP.HCM, Long An và các tỉnh lân cận.
      </p>
      <div class="the-hang">
        {
          nhom.map((n) => {
            const a = anhNhom[n.id];
            return (
              <a class="the-sp" href={`/san-pham/${n.data.slug}/`}>
                <div class="the-sp__anh">
                  <Image src={a.src} alt={a.alt} widths={[260, 500]} sizes="(max-width: 900px) 46vw, 255px" loading="lazy" />
                </div>
                <h3>{n.data.ten}</h3>
                <span class="the-sp__so">{n.data.quyCach.length} quy cách</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ============ 5. Bang quy cach ============ */}
  <section class="hang">
    <div class="khung">
      <div class="hang__dau">
        <h2>Bảng quy cách đinh chì</h2>
        <a href="/bang-gia-dinh-thep/">Bảng đầy đủ 6 nhóm</a>
      </div>
      <p class="hang__dan">
        Mã <strong>F</strong> trên bao đọc là <strong>phân</strong>, 1 phân = 1cm = 10mm.
        Dưới đây là năm quy cách hay đặt nhất.
      </p>
      <div class="bang-cuon">
        <table class="bang">
          <caption>Quy cách đinh chì hay đặt nhất - {c.tenThuongHieu} sản xuất</caption>
          <thead>
            <tr>
              <th scope="col">Quy cách</th>
              <th scope="col">Mã</th>
              <th scope="col" class="so">Chiều dài</th>
              <th scope="col" class="so">Đường kính thân</th>
            </tr>
          </thead>
          <tbody>
            {
              quyCachNoiBat.map((q) => (
                <tr>
                  <td><a href={`/san-pham/${q.slug}/`}>{tenChinh(dinhChi.data.ten, q)}</a></td>
                  <td>{q.ma}</td>
                  <td class="so">{q.daiMm} mm</td>
                  <td class="so">{q.duongKinhMm ? `${q.duongKinhMm} mm` : '-'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {/* Mot dong thay cho mot cot 10 o "gọi để báo giá" giong het nhau.
          Khi nhom-san-pham.yaml co gia thi tra lai cot Gia. */}
      <p class="hang__gia-nhac">
        Giá vật tư thay đổi theo ngày. Gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>
        {' '}để nhận báo giá hôm nay, hoặc xem
        {' '}<a href="/bang-gia-dinh-thep/">đầy đủ {tongQuyCach} quy cách của 6 nhóm</a>.
      </p>
    </div>
  </section>

  {/* ============ 6. Nha may ============ */}
  <section class="hang hang--nhat">
    <div class="khung">
      <div class="hang__dau">
        <h2>Nhà máy sản xuất</h2>
        <a href="/nha-may/">Xem nhà máy</a>
      </div>
      <div class="nm">
        <figure><Image src={anhDayChuyen} alt="Dây chuyền máy dập đinh tại nhà máy" widths={[280, 540]} sizes="(max-width: 900px) 46vw, 265px" loading="lazy" /></figure>
        <figure><Image src={anhRaMay} alt="Đinh ra khỏi máy dập xuống máng chứa" widths={[280, 540]} sizes="(max-width: 900px) 46vw, 265px" loading="lazy" /></figure>
        <figure><Image src={anhSoiThep} alt="Cuộn sợi thép nguyên liệu tại xưởng" widths={[280, 540]} sizes="(max-width: 900px) 46vw, 265px" loading="lazy" /></figure>
        <figure><Image src={anhKho} alt="Bao đinh thành phẩm xếp trong kho" widths={[280, 540]} sizes="(max-width: 900px) 46vw, 265px" loading="lazy" /></figure>
      </div>
      <ul class="nm__y">
        <li><strong>Thông số là của chính hàng chúng tôi làm ra</strong>, không phải số chép lại.</li>
        <li><strong>Đặt được số lượng lớn và quy cách riêng</strong>, nhà máy chạy theo đơn.</li>
        <li><strong>Pháp nhân rõ ràng</strong>, MST {c.maSoThue}, thành lập {c.namThanhLap}.</li>
      </ul>
    </div>
  </section>

  {/* ==== 7. Hop tac: doi tac + hang thiet bi (nen trang) ==== */}
  <DoiTac />

  {/* ==== 8. Cam nghi khach hang (nen nhat) - tu an khi chua co du lieu ==== */}
  <CamNghi />

  {/* ==== 9. Tin tuc (nen trang) - tu an khi chua co bai ==== */}
  <TinTuc />

  {/* ============ 10. CTA ============ */}
  <section class="cta">
    <div class="khung cta__trong">
      <div>
        <h2>Gửi quy cách và số lượng, nhận báo giá trong ngày</h2>
        <p>Nói rõ loại đinh, quy cách theo phân hoặc mm, số lượng theo kg hoặc bao.</p>
      </div>
      <div class="cta__nut">
        <a class="nut nut--tren-do nut--lon" href={`tel:${c.hotlineTel}`}>Gọi {c.hotline}</a>
        <a class="nut nut--lon cta__zalo" href={`https://zalo.me/${c.zalo}`} rel="noopener">Nhắn Zalo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ----------
     Banner nam trong components/BannerSlider.astro, chieu cao theo man hinh.
     Lop noi dung phu len tren, chi rieng the la bam duoc. */
  .hero {
    position: relative;
  }
  .hero__lop {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    pointer-events: none;
  }
  .hero__lop > .khung {
    width: 100%;
  }
  .hero__the {
    pointer-events: auto;
    /* 540 chu khong 468: o 468 thi hai nut (270px + 150px + khe) khong du cho
       tren mot hang nen bi xuong dong, an them 60px chieu cao va lam khoi nut
       doc ra roi. */
    max-width: 540px;
    padding: var(--k6);
    background: var(--trang);
    border-radius: var(--bo);
    box-shadow: 0 18px 44px rgba(22, 25, 28, 0.18);
  }
  .hero__nhan {
    display: block;
    font-size: var(--cs-micro);
    font-weight: var(--w-nang);
    letter-spacing: var(--gc-micro);
    text-transform: uppercase;
    color: var(--do-500);
    margin-bottom: var(--k2);
  }
  .hero h1 {
    font-size: var(--cs-display);
    line-height: var(--dc-chat);
    margin-bottom: var(--k3);
  }
  .hero__phu {
    font-size: var(--cs-lead);
    line-height: var(--dc-vua);
    color: var(--muc-2);
  }
  .hero__nut {
    display: flex;
    gap: var(--k3);
    flex-wrap: wrap;
    margin-top: var(--k5);
  }
  /* Ba so lieu tin cay ngay duoi nut - nghien cuu B2B: dat bang chung ngay
     duoi hero, khong de xuong cuoi trang. */
  .hero__tin {
    display: flex;
    gap: var(--k5);
    flex-wrap: wrap;
    margin-top: var(--k5);
    padding-top: var(--k4);
    border-top: var(--vien-mong);
    font-size: var(--cs-micro);
    color: var(--muc-2);
  }
  .hero__tin strong {
    font-family: var(--font-hien);
    font-size: var(--cs-h3);
    font-weight: var(--w-nang);
    color: var(--muc);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .hero__lop {
      position: static;
      display: block;
      pointer-events: auto;
    }
    /* Duoi 900px the tut xuong DUOI anh thay vi de len: o be ngang do, the phu
       kin anh nen anh thanh vo nghia. */
    .hero__the {
      max-width: none;
      margin-top: calc(var(--k6) * -1);
      position: relative;
      z-index: 2;
      padding: var(--k5);
    }
  }
  @media (max-width: 560px) {
    .hero__the {
      padding: var(--k4);
    }
    .hero__nut .nut {
      flex: 1;
      justify-content: center;
    }
  }


  /* ---- 3. gioi thieu mang H1. Khong co vien tren: dai Ly do ngay tren da
       co vien duoi, hai duong ke sat nhau se thanh mot duong day. ---- */
  .gioi-thieu {
    padding-block: var(--k7);
  }
  .gioi-thieu__trong {
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: var(--gap-lon);
    align-items: start;
  }
  .gioi-thieu__trong > * {
    min-width: 0;
  }
  .gioi-thieu h2 {
    font-size: var(--cs-h2);
    margin-bottom: var(--k4);
  }
  .gioi-thieu p {
    color: var(--muc-2);
    max-width: var(--do-doc);
  }
  .gioi-thieu__goi {
    margin-top: var(--k4);
    font-weight: var(--w-dam);
  }
  .gioi-thieu__anh {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--bo-nho);
    overflow: hidden;
    background: var(--nen-anh);
  }
  .gioi-thieu__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- 4-6. hang noi dung ---- */
  .hang {
    padding-block: var(--k7);
  }
  .hang--nhat {
    background: var(--nen-nhat);
  }
  .hang__gia-nhac {
    margin-top: var(--k4);
    padding: 12px var(--k4);
    border-left: 3px solid var(--do-500);
    background: var(--do-050);
    font-size: var(--cs-nho);
    font-weight: var(--w-vua);
    color: var(--do-700);
  }
  .hang__dan {
    font-size: var(--cs-nho);
    color: var(--muc-2);
    max-width: var(--do-doc);
    margin-bottom: var(--k5);
  }

  .the-hang {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  .the-sp {
    display: grid;
    gap: var(--k3);
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .the-sp__anh {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--bo-nho);
    background: var(--nen-anh);
    border: var(--vien-mong);
  }
  .the-sp__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--thoi) var(--nhip);
  }
  .the-sp:hover .the-sp__anh :global(img) {
    transform: scale(1.04);
  }
  .the-sp h3 {
    font-family: var(--font-hien);
    font-size: var(--cs-the);
    font-weight: var(--w-nang);
  }
  .the-sp:hover h3 {
    color: var(--do-600);
  }
  .the-sp__so {
    font-size: var(--cs-micro);
    color: var(--muc-2);
  }

  .nm {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  .nm figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--bo-nho);
    overflow: hidden;
    background: var(--nen-anh);
  }
  .nm :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nm__y {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
