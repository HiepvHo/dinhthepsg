---
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catTieuDe, catMoTa } from '../lib/seo-text';
import { tenChinh, quyDoi, coGia, dinhDangGia } from '../lib/quy-cach';

import anhRaMay from '../assets/anh/dinh-ra-khoi-may.jpg';
import anhDayChuyen from '../assets/anh/day-chuyen-dap-dinh.jpg';
import anhDongBao from '../assets/anh/dong-bao-dinh-sai-gon.jpg';
import anhCongNhan from '../assets/anh/cong-nhan-thep-cuong-phat.jpg';
import anhSoiThep from '../assets/anh/cuon-soi-thep-nguyen-lieu.jpg';
import anhKho from '../assets/anh/kho-bao-dinh.jpg';
import anhNenTrang1 from '../assets/anh/dinh-tren-nen-trang-01.jpg';
import anhNenTrang2 from '../assets/anh/dinh-tren-nen-trang-02.jpg';
import anhCan from '../assets/anh/can-dinh-tai-xuong.jpg';

/**
 * TRANG CHU.
 *
 * Ban truoc bi AI slop, do duoc bang so: 0 anh tren trang chu trong khi
 * baogiathep.net co 109 anh; hero la mot o placeholder vien dut; dai 4 con so
 * tren nen xam (dong tac kinh dien cua landing page AI sinh); nhan eyebrow
 * tren moi tieu de (mau SaaS, khong phai mau web vat tu).
 *
 * Ban nay sua bo cuc chu khong re-skin:
 *  - hero navy co anh that, khong con o rong
 *  - moi the nhom co anh
 *  - dai so gop thanh mot dai mong trong hero thay vi mot section rieng
 *  - bo het nhan eyebrow
 *
 * ANH HIEN TAI LA TAM. Chua co anh rieng tung nhom, chua co anh dan hang theo
 * thuoc. Xem docs/ANH-DA-CO.md muc 4.
 */
const ct = await getEntry('congTy', 'cong-ty');
const c = ct!.data;
const nhom = await getCollection('nhomSanPham');
const dinhChi = nhom.find((n) => n.id === 'dinh-chi')!;
const nhaMay = c.diaDiem[0];
const soNam = new Date().getFullYear() - c.namThanhLap;
const tongQuyCach = nhom.reduce((t, n) => t + n.data.quyCach.length, 0);

/** Anh cho tung nhom. TAM THOI - can anh rieng cho tung nhom san pham. */
const anhNhom: Record<string, { src: ImageMetadata; alt: string; tam: boolean }> = {
  'dinh-chi': { src: anhNenTrang1, alt: 'Đinh chì do nhà máy Đinh Thép Sài Gòn sản xuất', tam: false },
  'dinh-thep-trang': { src: anhNenTrang2, alt: 'Đinh thép trắng, thân trơn bề mặt sáng', tam: false },
  'dinh-thep-vang': { src: anhRaMay, alt: 'Đinh thép vừa ra khỏi máy dập tại xưởng', tam: true },
  'dinh-du': { src: anhCan, alt: 'Đinh thành phẩm được cân tại xưởng', tam: true },
  'dinh-vit': { src: anhDongBao, alt: 'Đóng bao đinh mang nhãn Đinh Sài Gòn', tam: true },
  'day-kem-hap': { src: anhSoiThep, alt: 'Cuộn sợi thép nguyên liệu tại nhà máy', tam: false },
};

const tieuDe = catTieuDe('Đinh Thép Sài Gòn - Nhà máy sản xuất đinh, dây kẽm');
const moTa = catMoTa(
  `Nhà máy sản xuất đinh thép xây dựng: đinh chì 2p đến 15p, đinh thép trắng, đinh vàng, đinh dù, đinh vít, dây kẽm. Bán trực tiếp, gọi ${c.hotline}.`,
);
---

<BaseLayout tieuDe={tieuDe} moTa={moTa} duongDan="/">
  {/* =================================================== HERO navy + anh === */}
  <section class="hero">
    <div class="khung hero__trong">
      <div class="hero__chu">
        <p class="hero__tren">Nhà sản xuất trực tiếp từ {c.namThanhLap}</p>
        <h1 class="hero__h1">
          Đinh thép xây dựng<br /><span class="hero__nhan">bán thẳng từ nhà máy</span>
        </h1>
        <p class="hero__phu">
          {tongQuyCach} quy cách đinh chì, đinh thép trắng, đinh thép vàng, đinh dù, đinh vít
          và dây kẽm. Thông số công bố đầy đủ theo phân, cm và mm.
        </p>
        <div class="hero__nut">
          <a class="nut nut--chinh nut--lon" href={`tel:${c.hotlineTel}`}>
            Gọi báo giá {c.hotline}
          </a>
          <a class="nut nut--lon hero__nut-phu" href="/bang-gia-dinh-thep/">Xem bảng quy cách</a>
        </div>
      </div>

      <div class="hero__anh">
        <figure class="hero__anh-lon">
          <Image
            src={anhRaMay}
            alt="Đinh thép vừa ra khỏi máy dập, rơi xuống máng chứa tại nhà máy"
            widths={[520, 900]}
            sizes="(max-width: 980px) 92vw, 520px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <figure class="hero__anh-nho">
          <Image src={anhDayChuyen} alt="Dây chuyền máy dập đinh đang chạy" widths={[260, 480]} sizes="250px" loading="eager" />
        </figure>
        <figure class="hero__anh-nho">
          <Image src={anhDongBao} alt="Công nhân đóng đinh vào bao nhãn Đinh Sài Gòn" widths={[260, 480]} sizes="250px" loading="eager" />
        </figure>
      </div>
    </div>

    {/* Dai so gop vao hero thanh mot dong mong, khong con la section rieng
        tren nen xam - do la dong tac AI slop kinh dien. */}
    <div class="khung">
      <ul class="dai-mong">
        <li><b>{soNam}</b> năm sản xuất vật tư kim khí</li>
        <li><b>{tongQuyCach}</b> quy cách công bố đủ thông số</li>
        <li><b>{c.diaDiem.length}</b> nhà máy, chi nhánh và kho</li>
        <li><b>MST {c.maSoThue}</b> pháp nhân rõ ràng</li>
      </ul>
    </div>
  </section>

  {/* ============================================== nhom san pham co anh === */}
  <section class="section">
    <div class="khung">
      <div class="tieu-de-hang">
        <h2>Sản phẩm nhà máy sản xuất</h2>
        <a class="tieu-de-hang__them" href="/san-pham/">Xem tất cả sản phẩm</a>
      </div>

      <div class="luoi-sp">
        {
          nhom.map((n) => {
            const a = anhNhom[n.id];
            return (
              <a class="sp" href={`/san-pham/${n.data.slug}/`}>
                <div class="sp__anh">
                  <Image
                    src={a.src}
                    alt={a.alt}
                    widths={[280, 520]}
                    sizes="(max-width: 980px) 46vw, 340px"
                    loading="lazy"
                  />
                  <span class="sp__dem">{n.data.quyCach.length} quy cách</span>
                </div>
                <div class="sp__than">
                  <h3>{n.data.ten}</h3>
                  <p>{n.data.moTaNgan}</p>
                  {n.data.tenGoiKhac.length > 0 && (
                    <p class="sp__khac">Còn gọi: {n.data.tenGoiKhac.slice(0, 2).join(', ')}</p>
                  )}
                  <span class="sp__xem">Xem quy cách và giá</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ==================================== bang quy cach - vu khi cua site === */}
  <section class="section section--nhat">
    <div class="khung">
      <div class="tieu-de-hang">
        <h2>Đinh chì - {dinhChi.data.quyCach.length} quy cách từ 2 phân đến 15 phân</h2>
        <a class="tieu-de-hang__them" href="/bang-gia-dinh-thep/">Bảng đầy đủ 6 nhóm</a>
      </div>
      <p class="dan-nhap bang-dan">
        Mã <strong>F</strong> trên bao đọc là <strong>phân</strong>, và 1 phân = 1cm = 10mm.
        Bảng dưới quy đổi sẵn cả bốn cách gọi.
      </p>

      <div class="bang-cuon">
        <table class="bang">
          <caption>Quy cách đinh chì do {c.tenThuongHieu} sản xuất</caption>
          <thead>
            <tr>
              <th scope="col">Quy cách</th>
              <th scope="col">Mã</th>
              <th scope="col" class="so">Chiều dài</th>
              <th scope="col" class="so">Đường kính thân</th>
              <th scope="col">Cách gọi khác</th>
              <th scope="col">Giá</th>
            </tr>
          </thead>
          <tbody>
            {
              dinhChi.data.quyCach.map((q) => (
                <tr>
                  <td><a href={`/san-pham/${q.slug}/`}>{tenChinh(dinhChi.data.ten, q)}</a></td>
                  <td>{q.ma}</td>
                  <td class="so">{q.daiMm} mm</td>
                  <td class="so">{q.duongKinhMm ? `${q.duongKinhMm} mm` : '-'}</td>
                  <td>{quyDoi(q) ?? '-'}</td>
                  <td>
                    {coGia(q) ? (
                      <span class="bang__gia">{dinhDangGia(q)}</span>
                    ) : (
                      <span class="bang__chua-co">gọi để báo giá</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="bang-ghi-chu">
        Thông số theo catalogue nhà máy. Đường kính thân có dung sai theo lô - cần số chính xác
        cho công trình, gọi <a href={`tel:${c.hotlineTel}`}>{c.hotline}</a>.
      </p>
    </div>
  </section>

  {/* ============================================ nha may - bang chung that === */}
  <section class="section nm-khoi">
    <div class="khung nm-khoi__trong">
      <div class="nm-khoi__anh">
        <figure><Image src={anhCongNhan} alt="Công nhân mặc đồng phục Thép Cường Phát tại xưởng đinh" widths={[320, 600]} sizes="(max-width: 980px) 46vw, 300px" loading="lazy" /></figure>
        <figure><Image src={anhKho} alt="Bao đinh thành phẩm xếp trong kho nhà máy" widths={[320, 600]} sizes="(max-width: 980px) 46vw, 300px" loading="lazy" /></figure>
      </div>
      <div class="nm-khoi__chu">
        <h2>Mua thẳng nơi sản xuất, không qua trung gian</h2>
        <ul class="nm-khoi__ds">
          <li>
            <strong>Thông số là của chính hàng chúng tôi làm ra.</strong>
            Không phải số chép lại, nên đúng với cây đinh bạn nhận.
          </li>
          <li>
            <strong>Đặt được số lượng lớn và quy cách riêng.</strong>
            Nhà máy chạy theo đơn, không phụ thuộc tồn kho đại lý.
          </li>
          <li>
            <strong>Pháp nhân rõ ràng.</strong>
            {c.tenPhapDinh}, MST {c.maSoThue}, thành lập {c.namThanhLap}.
          </li>
        </ul>
        <div class="nm-khoi__nut">
          <a class="nut nut--chinh" href="/nha-may/">Xem nhà máy sản xuất</a>
          <a class="nut nut--vien" href={`tel:${c.hotlineTel}`}>Gọi {c.hotline}</a>
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================= CTA === */}
  <section class="cta-do">
    <div class="khung cta-do__trong">
      <div>
        <h2>Gửi quy cách và số lượng, nhận báo giá trong ngày</h2>
        <p>
          Nói rõ loại đinh, quy cách theo phân hoặc mm, số lượng theo kg hoặc bao.
          Nhà máy tại {nhaMay.quanHuyen}, {nhaMay.tinhThanh}.
        </p>
      </div>
      <div class="cta-do__nut">
        <a class="nut nut--tren-do nut--lon" href={`tel:${c.hotlineTel}`}>Gọi {c.hotline}</a>
        <a class="nut nut--lon cta-do__zalo" href={`https://zalo.me/${c.zalo}`} rel="noopener">
          Nhắn Zalo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero ---- */
  .hero {
    background: var(--navy-900);
    color: var(--muc-nghich);
    padding-block: var(--k8) var(--k5);
  }
  .hero__trong {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: var(--gap-lon);
    align-items: center;
  }
  .hero__trong > * {
    min-width: 0;
  }
  .hero__tren {
    font-size: var(--cs-micro);
    font-weight: var(--w-nang);
    letter-spacing: var(--gc-micro);
    text-transform: uppercase;
    color: var(--navy-400);
  }
  .hero__h1 {
    font-size: var(--cs-display);
    color: var(--trang);
    margin-top: var(--k3);
  }
  .hero__nhan {
    color: #ff6b6b;
  }
  .hero__phu {
    margin-top: var(--k4);
    font-size: var(--cs-lead);
    color: var(--muc-nghich-2);
    max-width: 46ch;
  }
  .hero__nut {
    display: flex;
    gap: var(--k3);
    flex-wrap: wrap;
    margin-top: var(--k6);
  }
  .hero__nut-phu {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.4);
    color: var(--trang);
  }
  .hero__nut-phu:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--trang);
  }

  .hero__anh {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .hero__anh figure {
    position: relative;
    margin: 0;
    border-radius: var(--bo);
    overflow: hidden;
    background: var(--navy-800);
  }
  .hero__anh-lon {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  .hero__anh-nho {
    aspect-ratio: 4 / 3;
  }
    /* Anh phai absolute - xem ghi chu trong patterns.css (.khung-anh) */
  .hero__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dai so mong, khong phai section rieng tren nen xam */
  .dai-mong {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--k4);
    margin-top: var(--k7);
    padding-top: var(--k5);
    border-top: 1px solid var(--vien-nghich);
    font-size: var(--cs-micro);
    color: var(--muc-nghich-2);
  }
  .dai-mong b {
    display: block;
    font-size: var(--cs-h3);
    font-weight: var(--w-nang);
    color: var(--trang);
    font-variant-numeric: tabular-nums;
  }

  /* --------------------------------------------------- tieu de mot hang -- */
  .tieu-de-hang {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--k4);
    flex-wrap: wrap;
    padding-bottom: var(--k3);
    margin-bottom: var(--k5);
    border-bottom: 2px solid var(--do-500);
  }
  .tieu-de-hang__them {
    font-size: var(--cs-nho);
    font-weight: var(--w-dam);
    white-space: nowrap;
  }

  /* ------------------------------------------------- the nhom co anh ----- */
  .luoi-sp {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
  .sp {
    display: flex;
    flex-direction: column;
    border: var(--vien-mong);
    border-radius: var(--bo);
    overflow: hidden;
    background: var(--trang);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--thoi) var(--nhip), box-shadow var(--thoi) var(--nhip);
  }
  .sp:hover {
    border-color: var(--do-500);
    box-shadow: var(--noi);
  }
  .sp__anh {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--steel-050);
  }
  .sp__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sp__dem {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 10px;
    border-radius: var(--bo-nho);
    background: var(--do-500);
    color: var(--trang);
    font-size: var(--cs-micro);
    font-weight: var(--w-nang);
  }
  .sp__than {
    display: grid;
    gap: 6px;
    padding: var(--k4);
    flex: 1;
    align-content: start;
  }
  .sp__than h3 {
    font-size: var(--cs-h3);
    font-weight: var(--w-nang);
  }
  .sp__than p {
    font-size: var(--cs-nho);
    color: var(--muc-2);
  }
  .sp__khac {
    font-size: var(--cs-micro);
    color: var(--muc-3);
  }
  .sp__xem {
    margin-top: auto;
    padding-top: var(--k3);
    font-size: var(--cs-nho);
    font-weight: var(--w-dam);
    color: var(--do-600);
  }

  .bang-dan {
    margin-bottom: var(--k4);
    font-size: var(--cs-nho);
  }

  /* ------------------------------------------------------- khoi nha may -- */
  .nm-khoi__trong {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--gap-lon);
    align-items: center;
  }
  .nm-khoi__trong > * {
    min-width: 0;
  }
  .nm-khoi__anh {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .nm-khoi__anh figure {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    border-radius: var(--bo);
    overflow: hidden;
    background: var(--steel-050);
  }
  .nm-khoi__anh :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nm-khoi__ds {
    display: grid;
    gap: var(--k4);
    margin-top: var(--k5);
    border-top: var(--vien-mong);
  }
  .nm-khoi__ds li {
    padding-top: var(--k4);
    border-bottom: var(--vien-mong);
    padding-bottom: var(--k4);
    font-size: var(--cs-nho);
    color: var(--muc-2);
  }
  .nm-khoi__ds strong {
    display: block;
    color: var(--muc);
    margin-bottom: 2px;
  }
  .nm-khoi__nut {
    display: flex;
    gap: var(--k3);
    flex-wrap: wrap;
    margin-top: var(--k5);
  }

  /* ------------------------------------------------------------- CTA ----- */
  .cta-do {
    background: var(--do-500);
    color: var(--trang);
    padding-block: var(--k7);
  }
  .cta-do__trong {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lon);
    flex-wrap: wrap;
  }
  .cta-do h2 {
    color: var(--trang);
  }
  .cta-do p {
    margin-top: var(--k2);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--cs-nho);
    max-width: 56ch;
  }
  .cta-do__nut {
    display: flex;
    gap: var(--k3);
    flex-wrap: wrap;
  }
  .cta-do__zalo {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--trang);
  }
  .cta-do__zalo:hover {
    background: rgba(255, 255, 255, 0.14);
    color: var(--trang);
  }

  @media (max-width: 980px) {
    .hero__trong,
    .nm-khoi__trong {
      grid-template-columns: 1fr;
    }
    .luoi-sp {
      grid-template-columns: repeat(2, 1fr);
    }
    .dai-mong {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .luoi-sp {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-block: var(--k6) var(--k4);
    }
  }
</style>
