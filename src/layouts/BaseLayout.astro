---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CotLienHe from '../components/CotLienHe.astro';
import JsonLd from '../components/JsonLd.astro';
import { schemaToChuc, schemaWebSite } from '../lib/schema';
import { CHO_INDEX } from '../lib/moi-truong';

interface Props {
  tieuDe: string;
  moTa: string;
  duongDan: string;
  anhOg?: string;
  khongIndex?: boolean;
  /** Schema rieng cua trang, them vao Organization + WebSite san co */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { tieuDe, moTa, duongDan, anhOg, khongIndex = false, schema } = Astro.props;

// Chan index tren MOI moi truong khong phai domain that (vercel.app, preview, local).
// Ly do: tranh ban vercel.app duoc index roi canh tranh voi domain that sau nay.
const chanIndex = khongIndex || !CHO_INDEX;

const ct = await getEntry('congTy', 'cong-ty');
if (!ct) throw new Error('Thieu src/content/du-lieu/cong-ty.yaml');
const c = ct.data;

const canonical = new URL(duongDan, Astro.site).toString();
const ogUrl = anhOg ? new URL(anhOg, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="vi">
  <head>
    {/* Gan lop `co-js` NGAY trong <head>, truoc khi trinh duyet ve lan dau.
        Toan bo luat "hien dan khi cuon" trong industro.css deu nam duoi lop
        nay, nen:
          - co JS  -> cac muc bat dau o trang thai mo va truot len khi cuon toi
          - khong JS -> khong co lop, moi thu hien binh thuong ngay
        wow.js cua template lam nguoc lai: no dat visibility:hidden bang CSS
        cho ca 21 muc, JS hong mot cai la noi dung bien mat vinh vien.
        Dat trong <head> chu khong o cuoi <body> vi neu gan sau khi ve xong thi
        noi dung se nhay mot cai (hien roi bien roi hien lai). */}
    <script is:inline>
      document.documentElement.classList.add('co-js');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tieuDe}</title>
    <meta name="description" content={moTa} />
    <link rel="canonical" href={canonical} />
    {chanIndex && <meta name="robots" content="noindex, nofollow" />}

    {/* LCP element la tieu de weight 800. Tieng Viet can CA HAI subset:
        chu ASCII lay tu latin, chu co dau lay tu vietnamese.
        Chi preload 2 file CHU HIEN THI (Barlow 700) - do la chu ve dau tien va
        thuong la LCP element. Than bai Be Vietnam Pro de font-display: swap lo. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/barlow-semi-condensed-latin-700-normal.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/barlow-semi-condensed-vietnamese-700-normal.woff2"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={c.tenThuongHieu} />
    <meta property="og:title" content={tieuDe} />
    <meta property="og:description" content={moTa} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Favicon. Truoc day khong co the nao nen moi trang deu bi trinh duyet
        goi /favicon.ico va an 404, con tab thi trong tron.
        Google yeu cau icon vuong boi so cua 48px de hien tren SERP -> icon-48.png.
        SVG dat truoc de trinh duyet moi lay ban vector. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <JsonLd schema={schemaToChuc(c)} />
    <JsonLd schema={schemaWebSite(c)} />
    {schema && <JsonLd schema={schema} />}
  </head>

  <body>
    <a class="bo-qua" href="#noi-dung">Bỏ qua tới nội dung</a>

    <Header />

    <main id="noi-dung">
      <slot />
    </main>

    <Footer />
    <CotLienHe />

    {/* Thanh CTA dinh day - chi hien tren mobile. Nganh vat tu: khach GOI. */}
    <div class="thanh-day">
      <a href={`tel:${c.hotlineTel}`}>Gọi {c.hotline}</a>
      <a href={`https://zalo.me/${c.zalo}`} rel="noopener">Nhắn Zalo</a>
    </div>

    {/* Nut len dau trang - .back-to-top cua Industro.
        Ho dung jQuery: `$(window).scroll()` roi `fadeIn/fadeOut`, va
        `$('html,body').animate({scrollTop: 0}, 1500)`.
        Ta dung IntersectionObserver de bat khi nao cuon qua man hinh dau va
        `scrollTo({behavior:'smooth'})` de cuon - khong can thu vien nao. */}
    <button class="len-dau" type="button" aria-label="Lên đầu trang">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"></path></svg>
    </button>
    <span id="moc-cuon" aria-hidden="true"></span>

    <script>
      /* ---- DANH DAU DA CUON ----
         Gan `data-cuon` len <html> khi cuon qua 300px. Dung de:
           - hang nav do bong xuong (thay cho `shadow-sm` cua ho)
         Ho dat nguong 300px, giu nguyen.
         Chan bang moc thoi gian chu khong rAF: rAF phu thuoc trinh duyet co ve
         frame hay khong. Chi doi thuoc tinh khi trang thai THAT SU doi, nen no
         khong bat trinh duyet ve lai moi lan cuon. */
      {
        const goc = document.documentElement;
        let daCuon = false;
        let lanCuon = 0;
        const xemCuon = () => {
          const moi = window.scrollY > 300;
          if (moi === daCuon) return;
          daCuon = moi;
          if (moi) goc.setAttribute('data-cuon', '');
          else goc.removeAttribute('data-cuon');
        };
        window.addEventListener(
          'scroll',
          () => {
            const t = Date.now();
            if (t - lanCuon < 80) return;
            lanCuon = t;
            xemCuon();
          },
          { passive: true },
        );
        xemCuon();
      }

      /* ---- HIEN DAN KHI CUON ----
         Thay cho wow.js (~4KB nen) cong animate.css (~2KB nen) cua ho.

         VI SAO KHONG DUNG IntersectionObserver: da viet bang no truoc va
         KHONG kiem chung duoc. Do duoc hai loi that:
           1. Nhay thang xuong cuoi trang mot phat thi cac muc di tu "duoi
              khung nhin" sang "tren khung nhin" trong cung mot frame, va
              observer khong lan nao bao chung isIntersecting -> chung o
              opacity 0 vinh vien. Chuyen nay xay ra that: bam link neo, trinh
              duyet khoi phuc vi tri cuon, hoac cuon nhanh.
           2. Do duoc observer chi giao mot lan roi dung, con 11/18 muc khong
              bao gio hien.
         Che do hong o day la NOI DUNG AN VINH VIEN - nang hon han viec khong
         co hieu ung. Nen chon cach tat dinh, kiem duoc, thay vi cach "dung
         hon ve ly thuyet".

         Cach nay: mot ham quet, mot dieu kien duy nhat - mep tren cua muc da
         len qua 92% chieu cao khung nhin chua. Dieu kien do dung CA cho muc
         vua vao khung VA muc da bi cuon vuot qua, nen khong con truong hop
         nao bi bo sot.
         Chi phi: doc getBoundingClientRect cho toi 18 muc, 10 lan mot giay,
         va NGUNG HAN khi da hien du - go ca hai listener. */
      const conCho = Array.from(document.querySelectorAll('.hien-dan'));
      if (conCho.length) {
        let lanCuoi = 0;

        const quet = () => {
          const nguong = window.innerHeight * 0.92;
          for (let k = conCho.length - 1; k >= 0; k--) {
            if (conCho[k].getBoundingClientRect().top < nguong) {
              conCho[k].classList.add('da-hien');
              conCho.splice(k, 1);
            }
          }
          if (!conCho.length) {
            window.removeEventListener('scroll', hen);
            window.removeEventListener('resize', hen);
          }
        };

        // Chan 10 lan/giay bang moc thoi gian chu khong bang rAF: rAF phu
        // thuoc trinh duyet co ve frame hay khong, moc thoi gian thi khong.
        const hen = () => {
          const t = Date.now();
          if (t - lanCuoi < 100) return;
          lanCuoi = t;
          quet();
        };

        window.addEventListener('scroll', hen, { passive: true });
        window.addEventListener('resize', hen, { passive: true });
        quet(); // lan dau ngay khi tai: hien nhung muc da nam trong khung nhin
      }

      // Moc dat o cuoi man hinh dau. Khi no ra khoi khung nhin tuc la nguoi
      // dung da cuon qua mot man hinh - luc do moi hien nut.
      // IntersectionObserver re hon nghe su kien scroll: trinh duyet chi goi
      // lai dung mot lan moi khi trang thai doi, khong goi moi frame cuon.
      const nut = document.querySelector('.len-dau');
      const moc = document.getElementById('moc-cuon');
      if (nut && moc) {
        new IntersectionObserver(
          ([o]) => nut.classList.toggle('hien', !o.isIntersecting),
          { threshold: 0 },
        ).observe(moc);

        nut.addEventListener('click', () => {
          // Ton trong prefers-reduced-motion: nhay thang thay vi cuon muot
          const it = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: it ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>
